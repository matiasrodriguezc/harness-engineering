--- /dev/null
+++ b/tests/indexing-service.test.ts
@@ -0,0 +1,57 @@
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { PersistenceService } from '../src/services/persistence-service';
+import { DocumentService } from '../src/services/document-service';
+import { IndexingService } from '../src/services/indexing-service';
+import { QaService } from '../src/services/qa-service';
+
+describe('indexing + Q&A on large documents', () => {
+  let dir: string;
+  let persistence: PersistenceService;
+
+  beforeEach(() => {
+    dir = fs.mkdtempSync(path.join(os.tmpdir(), 'kb-test-'));
+    persistence = new PersistenceService(path.join(dir, 'data'));
+  });
+  afterEach(() => fs.rmSync(dir, { recursive: true, force: true }));
+
+  function importLargeDoc(): string {
+    const paragraphs = Array.from({ length: 10 }, (_, i) =>
+      `Paragraph ${i} explains the retrieval pipeline and how chunk ranking works in detail. `.repeat(3));
+    const file = path.join(dir, 'big.md');
+    fs.writeFileSync(file, paragraphs.join('\n\n'));
+    return new DocumentService(persistence).importDocument(file).id;
+  }
+
+  it('keeps chunk content for documents over 1000 characters', async () => {
+    const id = importLargeDoc();
+    const indexing = new IndexingService(persistence);
+    await indexing.startIndexing();
+    const chunks = indexing.getChunksForDocument(id);
+    expect(chunks.length).toBeGreaterThan(1);
+    for (const c of chunks) expect(c.content.trim().length).toBeGreaterThan(0);
+  });
+
+  it('returns citations with non-empty excerpts', async () => {
+    importLargeDoc();
+    const indexing = new IndexingService(persistence);
+    await indexing.startIndexing();
+    const res = await new QaService(persistence, indexing).ask('How does retrieval ranking work?');
+    expect(res.citations.length).toBeGreaterThan(0);
+    for (const c of res.citations) expect(c.excerpt.length).toBeGreaterThan(0);
+  });
+
+  it('rebuilds previously indexed documents whose chunks are empty', async () => {
+    const id = importLargeDoc();
+    persistence.writeJson(`chunks/${id}.json`, [
+      { id: 'x', documentId: id, content: '', index: 0, metadata: {} },
+    ]);
+    persistence.writeJson('index-meta.json', { [id]: ['x'] });
+    const indexing = new IndexingService(persistence);
+    await indexing.startIndexing();
+    const chunks = indexing.getChunksForDocument(id);
+    expect(chunks.every(c => c.content.length > 0)).toBe(true);
+  });
+});

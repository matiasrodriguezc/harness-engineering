diff --git a/tests/qa-citations.test.ts b/tests/qa-citations.test.ts
new file mode 100644
index 0000000..ab4c10e
--- /dev/null
+++ b/tests/qa-citations.test.ts
@@ -0,0 +1,60 @@
+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { PersistenceService } from '../src/services/persistence-service';
+import { DocumentService } from '../src/services/document-service';
+import { IndexingService } from '../src/services/indexing-service';
+import { QaService } from '../src/services/qa-service';
+
+const SAMPLES = path.resolve(__dirname, '../data/sample-documents');
+
+describe('import -> index -> ask pipeline', () => {
+  let dataDir: string;
+  let persistence: PersistenceService;
+  let documents: DocumentService;
+  let indexing: IndexingService;
+  let qa: QaService;
+
+  beforeEach(() => {
+    dataDir = fs.mkdtempSync(path.join(os.tmpdir(), 'kb-test-'));
+    persistence = new PersistenceService(dataDir);
+    documents = new DocumentService(persistence);
+    indexing = new IndexingService(persistence);
+    qa = new QaService(persistence, indexing);
+  });
+
+  afterEach(() => {
+    fs.rmSync(dataDir, { recursive: true, force: true });
+  });
+
+  it('keeps chunk content for documents longer than 1000 characters', async () => {
+    const file = path.join(SAMPLES, 'design-notes.md');
+    const source = fs.readFileSync(file, 'utf-8');
+    expect(source.length).toBeGreaterThan(1000);
+
+    const doc = documents.importDocument(file);
+    await indexing.startIndexing();
+
+    const chunks = indexing.getChunksForDocument(doc.id);
+    expect(chunks.length).toBeGreaterThan(1);
+    for (const chunk of chunks) {
+      expect(chunk.content.trim().length).toBeGreaterThan(0);
+      expect(source).toContain(chunk.content.split('\n\n')[0]);
+    }
+  });
+
+  it('returns non-empty citation excerpts for imported sample documents', async () => {
+    for (const name of fs.readdirSync(SAMPLES)) {
+      documents.importDocument(path.join(SAMPLES, name));
+    }
+    await indexing.startIndexing();
+
+    const response = await qa.ask('What does the retrieval plan say about chunks?');
+    expect(response.citations.length).toBeGreaterThan(0);
+    for (const c of response.citations) {
+      expect(c.excerpt.trim().length).toBeGreaterThan(0);
+    }
+    expect(response.confidence).toBeGreaterThan(0.5);
+  });
+});

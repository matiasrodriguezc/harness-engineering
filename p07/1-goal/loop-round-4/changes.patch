+import { beforeEach, describe, expect, it } from 'vitest';
+import { PersistenceService } from '../../src/services/persistence-service';
+import { IndexingService } from '../../src/services/indexing-service';
+import { quietLogs, tempDir } from '../helpers';
+
+let persistence: PersistenceService;
+let service: IndexingService;
+
+function addDoc(id: string, content: string | null) {
+  const meta = persistence.readJson<{ id: string }[]>('documents-meta.json') ?? [];
+  persistence.writeJson('documents-meta.json', [...meta, { id }]);
+  if (content !== null) persistence.writeText(`content/${id}.txt`, content);
+}
+
+beforeEach(() => {
+  quietLogs();
+  persistence = new PersistenceService(tempDir());
+  service = new IndexingService(persistence);
+});
+
+describe('IndexingService', () => {
+  it('reports idle with no documents and no chunks', () => {
+    const s = service.getStatus();
+    expect(s).toMatchObject({ status: 'idle', currentIndexed: 0, totalDocuments: 0 });
+    expect(service.getAllChunks()).toEqual([]);
+    expect(service.getChunksForDocument('nope')).toEqual([]);
+  });
+
+  it('single-document indexing returns error status when content is missing', async () => {
+    addDoc('d1', null);
+    const s = await service.startIndexing('d1');
+    expect(s.status).toBe('error');
+    expect(service.getChunksForDocument('d1')).toEqual([]);
+  });
+
+  it('single-document indexing writes chunks but does not touch the index meta', async () => {
+    addDoc('d1', 'First paragraph.\n\nSecond paragraph.');
+    const s = await service.startIndexing('d1');
+    const chunks = service.getChunksForDocument('d1');
+    expect(chunks).toHaveLength(1);
+    expect(chunks[0]).toMatchObject({
+      documentId: 'd1',
+      index: 0,
+      content: 'First paragraph.\n\nSecond paragraph.',
+      metadata: { charCount: '35', wordCount: '4' },
+    });
+    // index-meta.json is not updated by the single-document path
+    expect(s).toMatchObject({ status: 'idle', currentIndexed: 0, totalDocuments: 1 });
+    expect(service.getAllChunks()).toEqual([]);
+  });
+
+  it('splits long content into ~500 char chunks at paragraph boundaries', async () => {
+    const para = (c: string) => c.repeat(300);
+    addDoc('d1', [para('a'), para('b'), para('c')].join('\n\n'));
+    await service.startIndexing('d1');
+    const chunks = service.getChunksForDocument('d1');
+    expect(chunks.map(c => c.index)).toEqual([0, 1, 2]);
+    expect(chunks.map(c => c.content)).toEqual([para('a'), para('b'), para('c')]);
+  });
+
+  it('batch indexing indexes new docs, skips missing content and already-indexed docs', async () => {
+    addDoc('d1', 'one');
+    addDoc('d2', null);
+    let s = await service.startIndexing();
+    expect(s).toMatchObject({ status: 'indexing', currentIndexed: 1, totalDocuments: 2 });
+    const firstChunks = service.getAllChunks();
+    expect(firstChunks.map(c => c.content)).toEqual(['one']);
+
+    persistence.writeText('content/d2.txt', 'two');
+    s = await service.startIndexing();
+    expect(s).toMatchObject({ status: 'ready', currentIndexed: 2, totalDocuments: 2 });
+    const all = service.getAllChunks();
+    expect(all.map(c => c.content)).toEqual(['one', 'two']);
+    // d1 was not re-chunked: same chunk id survives
+    expect(all[0].id).toBe(firstChunks[0].id);
+  });
+});

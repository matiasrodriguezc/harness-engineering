+import { beforeEach, describe, expect, it } from 'vitest';
+import * as fs from 'fs';
+import * as path from 'path';
+import { PersistenceService } from '../../src/services/persistence-service';
+import { quietLogs, tempDir } from '../helpers';
+
+let root: string;
+let dataDir: string;
+let p: PersistenceService;
+
+beforeEach(() => {
+  quietLogs();
+  root = tempDir();
+  dataDir = path.join(root, 'data');
+  p = new PersistenceService(dataDir);
+});
+
+describe('PersistenceService', () => {
+  it('creates data, documents and index directories and exposes their paths', () => {
+    expect(p.getDataDir()).toBe(dataDir);
+    expect(p.getDocumentsDir()).toBe(path.join(dataDir, 'documents'));
+    expect(p.getIndexDir()).toBe(path.join(dataDir, 'index'));
+    for (const d of [p.getDataDir(), p.getDocumentsDir(), p.getIndexDir()]) {
+      expect(fs.statSync(d).isDirectory()).toBe(true);
+    }
+  });
+
+  it('readJson returns null for a missing file and round-trips written JSON in nested dirs', () => {
+    expect(p.readJson('nope.json')).toBeNull();
+    p.writeJson('a/b/c.json', { x: [1, 2] });
+    expect(p.readJson('a/b/c.json')).toEqual({ x: [1, 2] });
+    expect(p.exists('a/b/c.json')).toBe(true);
+  });
+
+  it('readText returns null for a missing file and round-trips written text', () => {
+    expect(p.readText('missing.txt')).toBeNull();
+    p.writeText('t/notes.txt', 'hello\nworld');
+    expect(p.readText('t/notes.txt')).toBe('hello\nworld');
+  });
+
+  it('copies files into documents and deletes them; deleting a missing file is a no-op', () => {
+    const src = path.join(root, 'src.md');
+    fs.writeFileSync(src, '# doc');
+    const dest = p.copyFileToDocuments(src, 'copy.md');
+    expect(dest).toBe(path.join(p.getDocumentsDir(), 'copy.md'));
+    expect(fs.readFileSync(dest, 'utf-8')).toBe('# doc');
+    expect(p.listFiles('documents')).toEqual(['copy.md']);
+
+    p.deleteFromDocuments('copy.md');
+    expect(fs.existsSync(dest)).toBe(false);
+    expect(() => p.deleteFromDocuments('copy.md')).not.toThrow();
+  });
+
+  it('listFiles returns [] for a missing directory and exists is false for missing paths', () => {
+    expect(p.listFiles('no-such-dir')).toEqual([]);
+    expect(p.exists('no-such-file')).toBe(false);
+  });
+
+  it('resetAll removes all stored data and recreates the empty directories', () => {
+    p.writeJson('state.json', { a: 1 });
+    p.writeText('documents/x.txt', 'x');
+    p.resetAll();
+    expect(p.exists('state.json')).toBe(false);
+    expect(p.listFiles('documents')).toEqual([]);
+    expect(fs.statSync(p.getIndexDir()).isDirectory()).toBe(true);
+  });
+});

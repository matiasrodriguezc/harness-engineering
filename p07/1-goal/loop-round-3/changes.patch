@@ -0,0 +1,86 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+async function loadLogger(level?: string) {
+  vi.resetModules();
+  if (level === undefined) delete process.env.LOG_LEVEL;
+  else process.env.LOG_LEVEL = level;
+  return import('../../src/services/logger');
+}
+
+function spies() {
+  return {
+    log: vi.spyOn(console, 'log').mockImplementation(() => {}),
+    warn: vi.spyOn(console, 'warn').mockImplementation(() => {}),
+    error: vi.spyOn(console, 'error').mockImplementation(() => {}),
+  };
+}
+
+const originalLevel = process.env.LOG_LEVEL;
+afterEach(() => {
+  if (originalLevel === undefined) delete process.env.LOG_LEVEL;
+  else process.env.LOG_LEVEL = originalLevel;
+  vi.restoreAllMocks();
+});
+
+describe('logger', () => {
+  it('emits JSON entries with timestamp, level, service and message to the console stream for the level', async () => {
+    const { logger, LogLevel } = await loadLogger();
+    const s = spies();
+    logger.debug('svc', 'd');
+    logger.info('svc', 'i');
+    logger.warn('svc', 'w');
+    logger.error('svc', 'e');
+
+    expect(s.log).toHaveBeenCalledTimes(2);
+    expect(s.warn).toHaveBeenCalledTimes(1);
+    expect(s.error).toHaveBeenCalledTimes(1);
+
+    const debugEntry = JSON.parse(s.log.mock.calls[0][0] as string);
+    expect(debugEntry).toMatchObject({ level: LogLevel.DEBUG, service: 'svc', message: 'd' });
+    expect(new Date(debugEntry.timestamp).toISOString()).toBe(debugEntry.timestamp);
+    expect(debugEntry).not.toHaveProperty('data');
+    expect(JSON.parse(s.log.mock.calls[1][0] as string).level).toBe(LogLevel.INFO);
+    expect(JSON.parse(s.warn.mock.calls[0][0] as string).level).toBe(LogLevel.WARN);
+    expect(JSON.parse(s.error.mock.calls[0][0] as string).level).toBe(LogLevel.ERROR);
+  });
+
+  it('includes data only when it has keys', async () => {
+    const { logger } = await loadLogger();
+    const s = spies();
+    logger.info('svc', 'with', { a: 1 });
+    logger.info('svc', 'empty', {});
+    expect(JSON.parse(s.log.mock.calls[0][0] as string).data).toEqual({ a: 1 });
+    expect(JSON.parse(s.log.mock.calls[1][0] as string)).not.toHaveProperty('data');
+  });
+
+  it('drops entries below LOG_LEVEL', async () => {
+    const { logger } = await loadLogger('WARN');
+    const s = spies();
+    logger.debug('svc', 'd');
+    logger.info('svc', 'i');
+    logger.warn('svc', 'w');
+    logger.error('svc', 'e');
+    expect(s.log).not.toHaveBeenCalled();
+    expect(s.warn).toHaveBeenCalledTimes(1);
+    expect(s.error).toHaveBeenCalledTimes(1);
+  });
+
+  it('forService returns a ServiceLogger that tags every level with the service name', async () => {
+    const { logger, ServiceLogger } = await loadLogger();
+    const s = spies();
+    const scoped = logger.forService('scoped');
+    expect(scoped).toBeInstanceOf(ServiceLogger);
+    scoped.debug('d', { k: 'v' });
+    scoped.info('i');
+    scoped.warn('w');
+    scoped.error('e');
+    const entries = [
+      ...s.log.mock.calls.map(c => JSON.parse(c[0] as string)),
+      JSON.parse(s.warn.mock.calls[0][0] as string),
+      JSON.parse(s.error.mock.calls[0][0] as string),
+    ];
+    expect(entries.map(e => e.message)).toEqual(['d', 'i', 'w', 'e']);
+    expect(entries.every(e => e.service === 'scoped')).toBe(true);
+    expect(entries[0].data).toEqual({ k: 'v' });
+  });
+});

+import { beforeEach, describe, expect, it } from 'vitest';
+import * as fs from 'fs';
+import * as path from 'path';
+import { PersistenceService } from '../../src/services/persistence-service';
+import { DocumentService } from '../../src/services/document-service';
+import { quietLogs, tempDir } from '../helpers';
+
+let dataDir: string;
+let srcDir: string;
+let persistence: PersistenceService;
+let service: DocumentService;
+
+function writeSource(name: string, content: string): string {
+  const p = path.join(srcDir, name);
+  fs.writeFileSync(p, content);
+  return p;
+}
+
+beforeEach(() => {
+  quietLogs();
+  dataDir = tempDir();
+  srcDir = tempDir();
+  persistence = new PersistenceService(dataDir);
+  service = new DocumentService(persistence);
+});
+
+describe('DocumentService', () => {
+  it('lists no documents on a fresh data dir', () => {
+    expect(service.listDocuments()).toEqual([]);
+  });
+
+  it('imports a file: metadata, stored content, copied original', () => {
+    const doc = service.importDocument(writeSource('notes.v2.md', 'hello world'));
+    expect(doc.title).toBe('notes.v2');
+    expect(doc.filename).toBe('notes.v2.md');
+    expect(doc.size).toBe(11);
+    expect(doc.status).toBe('imported');
+    expect(Number.isNaN(Date.parse(doc.importedAt))).toBe(false);
+    expect(service.listDocuments()).toEqual([doc]);
+    expect(service.getDocument(doc.id)).toEqual(doc);
+    expect(service.getDocumentContent(doc.id)).toBe('hello world');
+  });
+
+  it('throws when the file does not exist and stores nothing', () => {
+    expect(() => service.importDocument(path.join(srcDir, 'missing.txt'))).toThrow(/File not found/);
+    expect(service.listDocuments()).toEqual([]);
+  });
+
+  it('returns null for unknown documents and content', () => {
+    expect(service.getDocument('nope')).toBeNull();
+    expect(service.getDocumentContent('nope')).toBeNull();
+  });
+
+  it('updates metadata of an existing document and persists it', () => {
+    const doc = service.importDocument(writeSource('a.txt', 'x'));
+    const updated = service.updateDocument(doc.id, { status: 'indexed' });
+    expect(updated).toEqual({ ...doc, status: 'indexed' });
+    expect(new DocumentService(new PersistenceService(dataDir)).getDocument(doc.id)?.status).toBe('indexed');
+  });
+
+  it('returns null when updating an unknown document', () => {
+    expect(service.updateDocument('nope', { status: 'indexed' })).toBeNull();
+  });
+
+  it('deletes a document and keeps the others', () => {
+    const a = service.importDocument(writeSource('a.txt', 'a'));
+    const b = service.importDocument(writeSource('b.txt', 'b'));
+    expect(service.deleteDocument(a.id)).toBe(true);
+    expect(service.listDocuments().map(d => d.id)).toEqual([b.id]);
+  });
+
+  it('returns false when deleting an unknown document', () => {
+    expect(service.deleteDocument('nope')).toBe(false);
+  });
+});

+// Checker round 1: independent probe of document search in the real app, with real CDP keystrokes.
+// Usage: env -u NODE_OPTIONS npm run build && node --experimental-websocket evaluation/checker-round1.mjs
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { withApp, pageHelpers, report } from '../scripts/e2e/app-session.mjs';
+
+const dataDir = fs.mkdtempSync(path.join(os.tmpdir(), 'kb-checker-r1-'));
+const docs = ['design-notes.md', 'meeting-summary.txt', 'retrieval-plan.md'].map((f) => path.resolve('data/sample-documents', f));
+const all = ['design-notes', 'meeting-summary', 'retrieval-plan'];
+const checks = [];
+const same = (a, b) => JSON.stringify(a) === JSON.stringify(b);
+const search = (q) => `window.knowledgeBase.documents.search(${JSON.stringify(q)}).then(r => r.map(d => d.title).sort())`;
+const listed = `[...document.querySelectorAll('[data-document-id]')].map(e => e.firstChild.textContent).sort()`;
+const expectSearch = async (evaluate, q, exp, label) => { const r = await evaluate(search(q)); checks.push([label ?? `search(${JSON.stringify(q)})`, same(r, exp), r]); };
+
+// Expected by brute force from file contents + titles (independent of the app's code).
+const contents = Object.fromEntries(all.map((t, i) => [t, fs.readFileSync(docs[i], 'utf8')]));
+const oracle = (q) => all.filter((t) => t.toLowerCase().includes(q.toLowerCase()) || contents[t].toLowerCase().includes(q.toLowerCase()));
+
+try {
+  await withApp({ dataDir, port: 9377 }, async ({ evaluate, waitFor, reload, send }) => {
+    await expectSearch(evaluate, '', [], 'empty library: search("") -> []');
+    await expectSearch(evaluate, 'design', [], 'empty library: search("design") -> []');
+    await evaluate(pageHelpers);
+    checks.push(['empty library: input present', (await evaluate(`__e2e.byLabel('Search documents').length`)) === 1]);
+
+    for (const d of docs) await evaluate(`window.knowledgeBase.documents.import(${JSON.stringify(d)})`);
+
+    for (const q of ['RETRIEVAL', 'retrieval-PLAN', 'AtTeNdEeS', 'Design-Notes', 'design', 'chunk', 'zzz-nothing', '.*', '(', 'Software Design Notes', 'paragraph boundaries'])
+      await expectSearch(evaluate, q, oracle(q), `search(${JSON.stringify(q)}) matches oracle ${JSON.stringify(oracle(q))}`);
+    await expectSearch(evaluate, '', all, 'search("") -> all 3');
+
+    // UI with real keystrokes.
+    await reload(); await evaluate(pageHelpers);
+    await waitFor(`document.querySelectorAll('[data-document-id]').length === 3`);
+    await evaluate(`__e2e.byLabel('Search documents')[0].focus(); true`);
+    for (const ch of 'ATTENDEES') await send('Input.insertText', { text: ch });
+    await waitFor(`document.querySelectorAll('[data-document-id]').length === 1`);
+    await evaluate(`__e2e.sleep(400)`);
+    checks.push(['UI: typed "ATTENDEES" (real keys) -> meeting-summary', same(await evaluate(listed), ['meeting-summary']), await evaluate(listed)]);
+
+    // Backspace one key at a time to empty.
+    for (let i = 0; i < 9; i++) {
+      await send('Input.dispatchKeyEvent', { type: 'keyDown', key: 'Backspace', code: 'Backspace', windowsVirtualKeyCode: 8 });
+      await send('Input.dispatchKeyEvent', { type: 'keyUp', key: 'Backspace', code: 'Backspace', windowsVirtualKeyCode: 8 });
+    }
+    await evaluate(`__e2e.sleep(400)`);
+    const val = await evaluate(`__e2e.byLabel('Search documents')[0].value`);
+    checks.push(['UI: backspacing clears input & shows all 3', val === '' && same(await evaluate(listed), all), [val, await evaluate(listed)]]);
+
+    // Intermediate state checks while typing "retrieval-p" etc.
+    for (const q of ['Plan', 'zzz', 'DESIGN']) {
+      await evaluate(`__e2e.setInput(__e2e.byLabel('Search documents')[0], ''); true`);
+      await evaluate(`__e2e.byLabel('Search documents')[0].focus(); true`);
+      for (const ch of q) await send('Input.insertText', { text: ch });
+      await evaluate(`__e2e.sleep(400)`);
+      const got = await evaluate(listed);
+      checks.push([`UI: typed ${JSON.stringify(q)} -> ${JSON.stringify(oracle(q))}`, same(got, oracle(q)), got]);
+      if (q === 'zzz') checks.push(['UI: no-match message shown for zzz', await evaluate(`document.body.innerText.includes('No documents match')`)]);
+    }
+
+    // Native search-input clear (Escape) clears the field.
+    await evaluate(`__e2e.byLabel('Search documents')[0].focus(); true`);
+    await send('Input.dispatchKeyEvent', { type: 'keyDown', key: 'Escape', code: 'Escape', windowsVirtualKeyCode: 27 });
+    await send('Input.dispatchKeyEvent', { type: 'keyUp', key: 'Escape', code: 'Escape', windowsVirtualKeyCode: 27 });
+    await evaluate(`__e2e.sleep(400)`);
+    checks.push(['UI: Escape (native search clear) shows all 3', same(await evaluate(listed), all), [await evaluate(`__e2e.byLabel('Search documents')[0].value`), await evaluate(listed)]]);
+
+    // Filter active, then select a filtered doc -> detail view.
+    await evaluate(`__e2e.setInput(__e2e.byLabel('Search documents')[0], 'attendees'); true`);
+    await waitFor(`document.querySelectorAll('[data-document-id]').length === 1`);
+    await evaluate(`document.querySelector('[data-document-id]').click(); true`);
+    await waitFor(`document.body.innerText.includes('meeting-summary.txt')`);
+    checks.push(['UI: clicking a filtered doc opens it', true]);
+
+    // Delete while filtered + Refresh: list must not show the deleted doc.
+    // Observation only (spec silent on whitespace): query is trimmed before matching.
+    console.log('OBS search("attendees ") ->', JSON.stringify(await evaluate(search('attendees '))), 'literal oracle ->', JSON.stringify(oracle('attendees ')));
+    console.log('OBS search("   ") ->', JSON.stringify(await evaluate(search('   '))));
+    // Regression: index + ask + conversation, with filter active.
+    await evaluate(`window.knowledgeBase.indexing.start()`);
+    await evaluate(`[...document.querySelectorAll('header button')].find((b) => b.textContent === 'Conversation').click(); true`);
+    await evaluate(`(() => { __e2e.setInput(__e2e.byLabel('Ask a question')[0], 'How does retrieval work?'); document.querySelector('form').requestSubmit(); return true; })()`);
+    await waitFor(`document.querySelectorAll('[data-exchange]').length === 1 && !!document.querySelector('[data-answer-id]')`, 15000);
+    const hist = await evaluate(`window.knowledgeBase.qa.history()`);
+    checks.push(['ask works; answer has citations', hist.length === 1 && hist[0].response.citations.length > 0, hist.map((h) => h.response.citations.length)]);
+    checks.push(['filter still applied after asking', same(await evaluate(listed), ['meeting-summary']), await evaluate(listed)]);
+
+    // Import a new doc while filter active, then Refresh: new matching doc should appear.
+    const extra = path.join(dataDir, 'extra-attendees.txt');
+    fs.writeFileSync(extra, 'Nothing special here. ATTENDEES list follows.');
+    await evaluate(`window.knowledgeBase.documents.import(${JSON.stringify(extra)})`);
+    await evaluate(`[...document.querySelectorAll('header button')].find((b) => b.textContent === 'Refresh').click(); true`);
+    await evaluate(`__e2e.sleep(600)`);
+    checks.push(['import + Refresh while filtered shows new matching doc', same(await evaluate(listed), ['extra-attendees', 'meeting-summary']), await evaluate(listed)]);
+
+    // Reload: conversation persists.
+    await reload(); await evaluate(pageHelpers);
+    await waitFor(`document.querySelectorAll('[data-exchange]').length === 1`);
+    checks.push(['conversation persists after reload', true]);
+    checks.push(['after reload, list shows all 4 docs', (await evaluate(listed)).length === 4, await evaluate(listed)]);
+  });
+} finally {
+  fs.rmSync(dataDir, { recursive: true, force: true });
+}
+report('checker round 1', checks);

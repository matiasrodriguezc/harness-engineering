+// Checker round 2: independent probe of document search, from angles round 1 did not cover.
+// Non-ASCII case folding, rapid-typing races, paste, deleting while filtered, a real app restart,
+// bad bridge input, Reset clearing the filter, and regressions (import, ask, conversation).
+// Usage: env -u NODE_OPTIONS npm run build && node --experimental-websocket evaluation/checker-round2.mjs
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { withApp, pageHelpers, report } from '../scripts/e2e/app-session.mjs';
+
+const dataDir = fs.mkdtempSync(path.join(os.tmpdir(), 'kb-checker-r2-'));
+const srcDir = fs.mkdtempSync(path.join(os.tmpdir(), 'kb-checker-r2-src-'));
+const samples = ['design-notes.md', 'meeting-summary.txt', 'retrieval-plan.md'].map((f) => path.resolve('data/sample-documents', f));
+// Extra docs: non-ASCII content, a match only at the very end of a long file, and a title-only match.
+const extras = {
+  'Acentuación.txt': 'El ÑANDÚ corre rápido. Straße und Größe.',
+  'long-tail.txt': 'filler line without the term.\n'.repeat(4000) + 'needle-AT-THE-END',
+  'Zeta-Report.txt': 'plain body text with nothing notable',
+};
+const extraPaths = Object.entries(extras).map(([name, body]) => {
+  const p = path.join(srcDir, name);
+  fs.writeFileSync(p, body);
+  return p;
+});
+const allPaths = [...samples, ...extraPaths];
+const titleOf = (p) => path.basename(p).replace(/\.[^.]+$/, '');
+const contents = Object.fromEntries(allPaths.map((p) => [titleOf(p), fs.readFileSync(p, 'utf8')]));
+let present = allPaths.map(titleOf);
+// Expected results by brute force over the raw files (independent of the app's code).
+const oracle = (q) => present.filter((t) => t.toLowerCase().includes(q.toLowerCase()) || contents[t].toLowerCase().includes(q.toLowerCase())).sort();
+
+const checks = [];
+const same = (a, b) => JSON.stringify(a) === JSON.stringify(b);
+const search = (q) => `window.knowledgeBase.documents.search(${JSON.stringify(q)}).then(r => r.map(d => d.title).sort())`;
+const listed = `[...document.querySelectorAll('[data-document-id]')].map(e => e.firstChild.textContent).sort()`;
+const box = `__e2e.byLabel('Search documents')[0]`;
+const expectSearch = async (evaluate, q, label) => {
+  const r = await evaluate(search(q));
+  checks.push([label ?? `search(${JSON.stringify(q)}) == oracle ${JSON.stringify(oracle(q))}`, same(r, oracle(q)), r]);
+};
+
+try {
+  await withApp({ dataDir, port: 9388 }, async ({ evaluate, waitFor, reload, send }) => {
+    for (const p of allPaths) await evaluate(`window.knowledgeBase.documents.import(${JSON.stringify(p)})`);
+    const imported = await evaluate(`window.knowledgeBase.documents.list().then(r => r.map(d => d.title).sort())`);
+    checks.push(['import: all 6 docs listed with expected titles', same(imported, [...present].sort()), imported]);
+
+    // Bridge: new query shapes.
+    for (const q of ['ñandú', 'ÑANDÚ', 'acentuación', 'ACENTUACIÓN', 'größe', 'needle-at-the-end', 'zeta', 'NOTABLE', 'nothing notable', 'e', 'filler line', 'ATTENDEES', 'xyzzy-none'])
+      await expectSearch(evaluate, q);
+    checks.push(['search("") returns all 6', (await evaluate(search(''))).length === 6, await evaluate(search(''))]);
+
+    // Bad input over the bridge: rejects, app keeps working.
+    const bad = await evaluate(`window.knowledgeBase.documents.search(42).then(() => 'resolved', e => 'rejected: ' + e.message)`);
+    checks.push(['search(42) rejects', bad.startsWith('rejected'), bad]);
+    const badObj = await evaluate(`window.knowledgeBase.documents.search({}).then(() => 'resolved', e => 'rejected')`);
+    checks.push(['search({}) rejects', badObj === 'rejected', badObj]);
+    checks.push(['bridge still works after bad input', (await evaluate(search('zeta'))).length === 1]);
+
+    // UI: rapid typing (no waits between keys) must settle on the final query's results.
+    await reload(); await evaluate(pageHelpers);
+    await waitFor(`document.querySelectorAll('[data-document-id]').length === 6`);
+    await evaluate(`${box}.focus(); true`);
+    const fast = 'needle-at';
+    await Promise.all([...fast].map((ch) => send('Input.insertText', { text: ch })));
+    await evaluate(`__e2e.sleep(600)`);
+    const fastVal = await evaluate(`${box}.value`);
+    checks.push([`UI: rapid typing "${fast}" settles on oracle`, fastVal === fast && same(await evaluate(listed), oracle(fast)), [fastVal, await evaluate(listed)]]);
+
+    // Type then quickly retype a different query (race: broad query then narrow).
+    await evaluate(`__e2e.setInput(${box}, ''); true`);
+    for (const q of ['e', 'ée', 'ñ', 'ÑA', 'ÑANDÚ']) await evaluate(`__e2e.setInput(${box}, ${JSON.stringify(q)}); true`);
+    await evaluate(`__e2e.sleep(600)`);
+    checks.push(['UI: fast replace sequence ends on "ÑANDÚ" results', same(await evaluate(listed), oracle('ÑANDÚ')), await evaluate(listed)]);
+
+    // Paste a whole phrase in one go.
+    await evaluate(`__e2e.setInput(${box}, ''); ${box}.focus(); true`);
+    await send('Input.insertText', { text: 'Software Design' });
+    await evaluate(`__e2e.sleep(400)`);
+    checks.push(['UI: pasted "Software Design" -> oracle', same(await evaluate(listed), oracle('Software Design')), await evaluate(listed)]);
+
+    // Select-all + Delete clears the input and shows everything.
+    await send('Input.dispatchKeyEvent', { type: 'keyDown', key: 'a', code: 'KeyA', modifiers: 4, windowsVirtualKeyCode: 65, commands: ['selectAll'] });
+    await send('Input.dispatchKeyEvent', { type: 'keyUp', key: 'a', code: 'KeyA', modifiers: 4, windowsVirtualKeyCode: 65 });
+    await send('Input.dispatchKeyEvent', { type: 'keyDown', key: 'Backspace', code: 'Backspace', windowsVirtualKeyCode: 8 });
+    await send('Input.dispatchKeyEvent', { type: 'keyUp', key: 'Backspace', code: 'Backspace', windowsVirtualKeyCode: 8 });
+    await evaluate(`__e2e.sleep(400)`);
+    const clearedVal = await evaluate(`${box}.value`);
+    checks.push(['UI: select-all + Backspace clears and shows all 6', clearedVal === '' && (await evaluate(listed)).length === 6, [clearedVal, await evaluate(listed)]]);
+
+    // Delete a matching doc while filtered, then Refresh: it disappears from the filtered list and the bridge.
+    await evaluate(`__e2e.setInput(${box}, 'zeta'); true`);
+    await waitFor(`document.querySelectorAll('[data-document-id]').length === 1`);
+    const zetaId = await evaluate(`window.knowledgeBase.documents.search('zeta').then(r => r[0].id)`);
+    await evaluate(`window.knowledgeBase.documents.delete(${JSON.stringify(zetaId)})`);
+    present = present.filter((t) => t !== 'Zeta-Report');
+    await evaluate(`[...document.querySelectorAll('header button')].find((b) => b.textContent === 'Refresh').click(); true`);
+    await evaluate(`__e2e.sleep(600)`);
+    checks.push(['UI: deleted doc gone from filtered list after Refresh', same(await evaluate(listed), []), await evaluate(listed)]);
+    checks.push(['UI: no-match message after delete', await evaluate(`document.body.innerText.includes('No documents match')`)]);
+    await expectSearch(evaluate, 'zeta', 'bridge: search("zeta") after delete -> []');
+
+    // Regression: indexing + asking + conversation with filter active.
+    await evaluate(`__e2e.setInput(${box}, 'needle'); true`);
+    await waitFor(`document.querySelectorAll('[data-document-id]').length === 1`);
+    await evaluate(`window.knowledgeBase.indexing.start()`);
+    await evaluate(`[...document.querySelectorAll('header button')].find((b) => b.textContent === 'Conversation').click(); true`);
+    await evaluate(`(() => { __e2e.setInput(__e2e.byLabel('Ask a question')[0], 'What are the meeting attendees?'); document.querySelector('form').requestSubmit(); return true; })()`);
+    await waitFor(`document.querySelectorAll('[data-exchange]').length === 1 && !!document.querySelector('[data-answer-id]')`, 15000);
+    const hist = await evaluate(`window.knowledgeBase.qa.history()`);
+    checks.push(['ask works with filter active; answer has citations', hist.length === 1 && hist[0].response.citations.length > 0, hist.map((h) => h.response.citations.map((c) => c.documentTitle ?? c.documentId))]);
+    checks.push(['filter still applied after asking', same(await evaluate(listed), ['long-tail']), await evaluate(listed)]);
+  });
+
+  // Real restart: search still sees imported content.
+  await withApp({ dataDir, port: 9389 }, async ({ evaluate, waitFor }) => {
+    for (const q of ['ñandú', 'needle-at-the-end', 'attendees', 'zeta']) await expectSearch(evaluate, q, `after restart: search(${JSON.stringify(q)}) == oracle ${JSON.stringify(oracle(q))}`);
+    await evaluate(pageHelpers);
+    await waitFor(`document.querySelectorAll('[data-exchange]').length === 1`);
+    checks.push(['after restart: conversation persists (1 exchange)', true]);
+    await waitFor(`document.querySelectorAll('[data-document-id]').length === 5`);
+    checks.push(['after restart: input starts empty, all 5 docs listed', (await evaluate(`${box}.value`)) === '', await evaluate(listed)]);
+
+    // Reset through the UI with a filter active clears the input and empties the list.
+    await evaluate(`__e2e.setInput(${box}, 'attendees'); true`);
+    await waitFor(`document.querySelectorAll('[data-document-id]').length === 1`);
+    await evaluate(`__e2e.byLabel('Reset all data')[0].click(); true`);
+    await waitFor(`__e2e.byLabel('Confirm reset all data').length === 1`);
+    await evaluate(`__e2e.byLabel('Confirm reset all data')[0].click(); true`);
+    await waitFor(`document.body.innerText.includes('Documents (0)')`);
+    const after = { value: await evaluate(`${box}.value`), text: await evaluate(`document.body.innerText.includes('No documents imported yet.')`), search: await evaluate(search('')) };
+    checks.push(['Reset with filter active: input cleared, empty state shown, search("") -> []', after.value === '' && after.text && same(after.search, []), after]);
+
+    // Re-import after reset: search works again from scratch.
+    await evaluate(`window.knowledgeBase.documents.import(${JSON.stringify(samples[1])})`);
+    present = ['meeting-summary'];
+    await expectSearch(evaluate, 'ATTENDEES', 'after reset + re-import: search("ATTENDEES") -> [meeting-summary]');
+  });
+} finally {
+  fs.rmSync(dataDir, { recursive: true, force: true });
+  fs.rmSync(srcDir, { recursive: true, force: true });
+}
+report('checker round 2', checks);

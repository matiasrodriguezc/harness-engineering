@@ -0,0 +1,74 @@
+// E2E for document search, against the built app (run `npm run build` first).
+// Usage: node --experimental-websocket scripts/e2e/document-search.mjs
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { withApp, pageHelpers, report } from './app-session.mjs';
+
+const dataDir = fs.mkdtempSync(path.join(os.tmpdir(), 'kb-e2e-search-'));
+const docs = ['design-notes.md', 'meeting-summary.txt', 'retrieval-plan.md'].map((f) => path.resolve('data/sample-documents', f));
+const checks = [];
+
+const search = (q) => `window.knowledgeBase.documents.search(${JSON.stringify(q)}).then(r => r.map(d => d.title).sort())`;
+// Titles currently rendered in the sidebar list.
+const listed = `[...document.querySelectorAll('[data-document-id]')].map(e => e.firstChild.textContent).sort()`;
+const same = (a, b) => JSON.stringify(a) === JSON.stringify(b);
+const all = ['design-notes', 'meeting-summary', 'retrieval-plan'];
+
+try {
+  await withApp({ dataDir }, async ({ evaluate, waitFor, reload }) => {
+    await evaluate(`(async () => { for (const d of ${JSON.stringify(docs)}) await window.knowledgeBase.documents.import(d); return true; })()`);
+
+    // 1. Through the bridge.
+    const byTitle = await evaluate(search('RETRIEVAL-plan'));
+    checks.push(['search matches title, case-insensitive', same(byTitle, ['retrieval-plan']), byTitle]);
+    const byContent = await evaluate(search('attendees'));
+    checks.push(['search matches content only (meeting-summary has "Attendees:")', same(byContent, ['meeting-summary']), byContent]);
+    const empty = await evaluate(search(''));
+    checks.push(['empty query returns all documents', same(empty, all), empty]);
+    const none = await evaluate(search('zzz-no-such-text'));
+    checks.push(['no match returns []', same(none, []), none]);
+
+    // 2. Through the UI.
+    await reload();
+    await evaluate(pageHelpers);
+    await waitFor(`document.querySelectorAll('[data-document-id]').length === 3`);
+    const inputs = await evaluate(`__e2e.byLabel('Search documents').map(e => e.tagName)`);
+    checks.push(['one input with aria-label "Search documents"', same(inputs, ['INPUT']), inputs]);
+
+    // Type character by character, like a user, with no waits between keystrokes.
+    await evaluate(`(async () => { const el = __e2e.byLabel('Search documents')[0]; let v = '';
+      for (const ch of 'ATTENDEES') { v += ch; __e2e.setInput(el, v); } return true; })()`);
+    await waitFor(`document.querySelectorAll('[data-document-id]').length === 1`);
+    await evaluate(`__e2e.sleep(500)`); // let any stale responses land
+    const typed = await evaluate(listed);
+    checks.push(['typing filters the list by content (case-insensitive)', same(typed, ['meeting-summary']), typed]);
+
+    // "Design-Notes" only appears in a title, never in any document's content.
+    await evaluate(`__e2e.setInput(__e2e.byLabel('Search documents')[0], 'Design-Notes'); true`);
+    await waitFor(`document.querySelectorAll('[data-document-id]').length === 1`);
+    await evaluate(`__e2e.sleep(300)`);
+    const byTitleUi = await evaluate(listed);
+    checks.push(['changing the query filters by title (case-insensitive)', same(byTitleUi, ['design-notes']), byTitleUi]);
+
+    await evaluate(`__e2e.setInput(__e2e.byLabel('Search documents')[0], 'zzz-no-such-text'); true`);
+    await waitFor(`document.body.innerText.includes('No documents match')`);
+    const noMatch = await evaluate(listed);
+    checks.push(['no match shows an empty list and a message', same(noMatch, []), noMatch]);
+
+    await evaluate(`__e2e.setInput(__e2e.byLabel('Search documents')[0], ''); true`);
+    await waitFor(`document.querySelectorAll('[data-document-id]').length === 3`);
+    const cleared = await evaluate(listed);
+    checks.push(['clearing the input shows all documents again', same(cleared, all), cleared]);
+
+    // A query that several documents contain lists all of them.
+    await evaluate(`__e2e.setInput(__e2e.byLabel('Search documents')[0], 'retrieval'); true`);
+    await waitFor(`document.querySelectorAll('[data-document-id]').length >= 1`);
+    await evaluate(`__e2e.sleep(300)`);
+    const retrieval = await evaluate(listed);
+    checks.push(['"retrieval" lists docs whose title or content mention it', same(retrieval, all), retrieval]);
+  });
+} finally {
+  fs.rmSync(dataDir, { recursive: true, force: true });
+}
+report('document-search e2e', checks);

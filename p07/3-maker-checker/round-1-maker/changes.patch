+  /**
+   * Documents whose title or content contains `query`, case-insensitive.
+   * A blank query (empty or only whitespace) returns every document; the query is trimmed otherwise.
+   */
+  searchDocuments(query: unknown): Document[] {
+    if (query !== undefined && query !== null && typeof query !== 'string') {
+      throw new TypeError('Search query must be a string');
+    }
+    const docs = this.listDocuments();
+    const needle = (query ?? '').trim().toLowerCase();
+    if (needle === '') return docs;
+
+    const matches = docs.filter(doc => {
+      if (doc.title.toLowerCase().includes(needle)) return true;
+      const content = this.getDocumentContent(doc.id);
+      return content !== null && content.toLowerCase().includes(needle);
+    });
+    logger.debug(SERVICE, 'Searched documents', { queryLength: needle.length, matches: matches.length });
+    return matches;
+  }

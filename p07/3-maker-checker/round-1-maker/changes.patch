diff --git a/tests/document-search.test.tsx b/tests/document-search.test.tsx
new file mode 100644
index 0000000..81de2a6
--- /dev/null
+++ b/tests/document-search.test.tsx
@@ -0,0 +1,151 @@
+import * as fs from 'fs';
+import * as path from 'path';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { renderToStaticMarkup } from 'react-dom/server';
+import { IPC_CHANNELS, Document } from '../src/shared/types';
+import { registerIpcHandlers, Services } from '../src/main/ipc-handlers';
+import { DocumentList } from '../src/renderer/components/DocumentList';
+import { makeServices, quietLogs, tempDir } from './helpers';
+
+// Capture what the preload exposes and what it invokes.
+const exposed: Record<string, any> = {};
+const invoke = vi.fn(async (..._args: unknown[]) => undefined);
+vi.mock('electron', () => ({
+  contextBridge: { exposeInMainWorld: (key: string, api: unknown) => { exposed[key] = api; } },
+  ipcRenderer: { invoke: (...args: unknown[]) => invoke(...args) },
+}));
+
+beforeEach(() => quietLogs());
+
+/** Writes fixture files and imports them; returns services and the imported docs by title. */
+function setup(files: Record<string, string>, dataDir = tempDir()) {
+  const s = makeServices(dataDir);
+  const src = tempDir();
+  const docs: Record<string, Document> = {};
+  for (const [name, content] of Object.entries(files)) {
+    const p = path.join(src, name);
+    fs.writeFileSync(p, content);
+    const doc = s.documentService.importDocument(p);
+    docs[doc.title] = doc;
+  }
+  return { s, docs, dataDir };
+}
+
+const FILES = {
+  'Alpha-Report.md': 'Quarterly numbers for the sales team.',
+  'beta-notes.txt': 'The Zebra crossing is near the office.',
+  'gamma.md': 'Nothing interesting here.',
+};
+const titles = (docs: Document[]) => docs.map(d => d.title).sort();
+
+describe('DocumentService.searchDocuments', () => {
+  it('matches the title, case-insensitively', () => {
+    const { s } = setup(FILES);
+    expect(titles(s.documentService.searchDocuments('alpha'))).toEqual(['Alpha-Report']);
+    expect(titles(s.documentService.searchDocuments('BETA'))).toEqual(['beta-notes']);
+  });
+
+  it('matches the content, case-insensitively', () => {
+    const { s } = setup(FILES);
+    expect(titles(s.documentService.searchDocuments('zebra'))).toEqual(['beta-notes']);
+    expect(titles(s.documentService.searchDocuments('QUARTERLY NUMBERS'))).toEqual(['Alpha-Report']);
+  });
+
+  it('returns every document that matches, by title or content', () => {
+    const { s } = setup({ ...FILES, 'zebra-facts.md': 'Stripes.' });
+    expect(titles(s.documentService.searchDocuments('Zebra'))).toEqual(['beta-notes', 'zebra-facts']);
+  });
+
+  it('returns all documents for an empty or blank query', () => {
+    const { s } = setup(FILES);
+    const all = titles(s.documentService.listDocuments());
+    expect(all).toHaveLength(3);
+    expect(titles(s.documentService.searchDocuments(''))).toEqual(all);
+    expect(titles(s.documentService.searchDocuments('   '))).toEqual(all);
+    expect(titles(s.documentService.searchDocuments(undefined))).toEqual(all);
+  });
+
+  it('returns nothing when no document matches', () => {
+    const { s } = setup(FILES);
+    expect(s.documentService.searchDocuments('unicorn')).toEqual([]);
+  });
+
+  it('treats the query as literal text, not a pattern', () => {
+    const { s } = setup({ ...FILES, 'regex.md': 'Price is $5.00 (approx).' });
+    expect(titles(s.documentService.searchDocuments('$5.00 (approx'))).toEqual(['regex']);
+    expect(s.documentService.searchDocuments('.*')).toEqual([]);
+  });
+
+  it('does not return deleted documents', () => {
+    const { s, docs } = setup(FILES);
+    s.documentService.deleteDocument(docs['beta-notes'].id);
+    expect(s.documentService.searchDocuments('zebra')).toEqual([]);
+  });
+
+  it('returns full document metadata', () => {
+    const { s, docs } = setup(FILES);
+    expect(s.documentService.searchDocuments('gamma')).toEqual([docs['gamma']]);
+  });
+
+  it('works after a restart on the same data dir', () => {
+    const { dataDir } = setup(FILES);
+    expect(titles(makeServices(dataDir).documentService.searchDocuments('zebra'))).toEqual(['beta-notes']);
+  });
+
+  it('rejects a non-string query', () => {
+    const { s } = setup(FILES);
+    expect(() => s.documentService.searchDocuments(42)).toThrow(/string/);
+  });
+});
+
+describe('documents.search over the bridge', () => {
+  it('preload exposes documents.search on the documents:search channel', async () => {
+    await import('../src/preload/preload');
+    const kb = exposed.knowledgeBase;
+    expect(typeof kb.documents.search).toBe('function');
+    await kb.documents.search('zebra');
+    expect(invoke).toHaveBeenLastCalledWith(IPC_CHANNELS.SEARCH_DOCUMENTS, 'zebra');
+  });
+
+  it('the documents:search handler returns the matching documents', async () => {
+    const { s } = setup(FILES);
+    const handlers = new Map<string, (...args: any[]) => any>();
+    registerIpcHandlers({ handle: (c: string, fn: any) => handlers.set(c, fn) } as any, s as Services);
+    const search = handlers.get(IPC_CHANNELS.SEARCH_DOCUMENTS)!;
+    expect(titles(await search({}, 'ZEBRA'))).toEqual(['beta-notes']);
+    expect(await search({}, '')).toHaveLength(3);
+  });
+});
+
+describe('DocumentList search UI', () => {
+  const doc = (id: string, title: string): Document => ({
+    id, title, filename: `${title}.md`, importedAt: '2026-11-16T00:00:00.000Z', size: 1024, status: 'imported',
+  });
+  const render = (props: Partial<Parameters<typeof DocumentList>[0]>) =>
+    renderToStaticMarkup(
+      <DocumentList documents={[]} totalCount={0} query="" onQueryChange={() => {}} onSelect={() => {}} selectedId={null} {...props} />,
+    );
+
+  it('renders a search input labelled "Search documents" with the current query', () => {
+    const html = render({ documents: [doc('1', 'one')], totalCount: 1, query: 'on' });
+    expect(html).toMatch(/<input[^>]*aria-label="Search documents"[^>]*value="on"/);
+  });
+
+  it('lists only the documents it is given', () => {
+    const html = render({ documents: [doc('1', 'kept')], totalCount: 2, query: 'kep' });
+    expect(html).toContain('kept');
+    expect(html).not.toContain('No documents');
+  });
+
+  it('says nothing matches when the search has no results', () => {
+    const html = render({ documents: [], totalCount: 2, query: ' unicorn ' });
+    expect(html).toContain('No documents match &quot;unicorn&quot;');
+    expect(html).not.toContain('No documents imported yet');
+  });
+
+  it('keeps the empty-library message when there are no documents at all', () => {
+    const html = render({ documents: [], totalCount: 0 });
+    expect(html).toContain('No documents imported yet');
+    expect(html).toContain('aria-label="Search documents"');
+  });
+});

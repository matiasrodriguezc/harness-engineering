+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { MAX_IMPORT_FILE_SIZE } from '../shared/types';
+import { DocumentService } from './document-service';
+import { PersistenceService } from './persistence-service';
+
+const SAMPLES = path.resolve(__dirname, '../../data/sample-documents');
+
+describe('DocumentService import', () => {
+  let tmp: string;
+  let dataDir: string;
+  let srcDir: string;
+  let service: DocumentService;
+
+  beforeEach(() => {
+    tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'kb-import-'));
+    dataDir = path.join(tmp, 'data');
+    srcDir = path.join(tmp, 'src');
+    fs.mkdirSync(srcDir);
+    service = new DocumentService(new PersistenceService(dataDir));
+  });
+
+  afterEach(() => {
+    fs.rmSync(tmp, { recursive: true, force: true });
+  });
+
+  const writeSource = (name: string, content: string | Buffer, dir = srcDir) => {
+    fs.mkdirSync(dir, { recursive: true });
+    const p = path.join(dir, name);
+    fs.writeFileSync(p, content);
+    return p;
+  };
+
+  it('imports the sample .md and .txt documents', () => {
+    const files = fs.readdirSync(SAMPLES).map(f => path.join(SAMPLES, f));
+    const result = service.importDocuments(files);
+
+    expect(result.failed).toEqual([]);
+    expect(result.imported).toHaveLength(files.length);
+    expect(service.listDocuments().map(d => d.filename).sort()).toEqual(
+      fs.readdirSync(SAMPLES).sort(),
+    );
+    for (const doc of result.imported) {
+      const original = fs.readFileSync(path.join(SAMPLES, doc.filename), 'utf-8');
+      expect(service.getDocumentContent(doc.id)).toBe(original);
+      expect(doc.size).toBe(fs.statSync(path.join(SAMPLES, doc.filename)).size);
+      expect(doc.status).toBe('imported');
+    }
+  });
+
+  it('derives title from filename and records metadata', () => {
+    const doc = service.importDocument(writeSource('Project Notes.MD', '# Hi\n'));
+    expect(doc.title).toBe('Project Notes');
+    expect(doc.filename).toBe('Project Notes.MD');
+    expect(Number.isNaN(Date.parse(doc.importedAt))).toBe(false);

diff --git a/src/services/document-detail.test.ts b/src/services/document-detail.test.ts
new file mode 100644
index 0000000..f1ff10b
--- /dev/null
+++ b/src/services/document-detail.test.ts
@@ -0,0 +1,72 @@
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { DocumentService } from './document-service';
+import { IndexingService } from './indexing-service';
+import { PersistenceService } from './persistence-service';
+
+describe('document detail: content and delete', () => {
+  let tmp: string;
+  let dataDir: string;
+  let documents: DocumentService;
+  let indexing: IndexingService;
+
+  beforeEach(() => {
+    tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'kb-detail-'));
+    dataDir = path.join(tmp, 'data');
+    const persistence = new PersistenceService(dataDir);
+    documents = new DocumentService(persistence);
+    indexing = new IndexingService(persistence);
+  });
+
+  afterEach(() => {
+    fs.rmSync(tmp, { recursive: true, force: true });
+  });
+
+  const importText = (name: string, text: string) => {
+    const p = path.join(tmp, name);
+    fs.writeFileSync(p, text);
+    return documents.importDocument(p);
+  };
+
+  it('returns the full content of a known document', () => {
+    const text = 'Para one.\n\n' + 'x'.repeat(2000) + '\n\nLast — ✓';
+    const doc = importText('long.md', text);
+    expect(documents.getDocumentContent(doc.id)).toBe(text);
+  });
+
+  it('returns null for unknown or path-like IDs without touching the filesystem outside content/', () => {
+    fs.writeFileSync(path.join(dataDir, 'secret.txt'), 'nope');
+    expect(documents.getDocumentContent('does-not-exist')).toBeNull();
+    expect(documents.getDocumentContent('../secret')).toBeNull();
+  });
+
+  it('delete removes metadata, stored original, content, chunks and index entry', async () => {
+    const keep = importText('keep.txt', 'keep me');
+    const doc = importText('gone.md', 'first\n\nsecond');
+    await indexing.startIndexing();
+    expect(indexing.getChunksForDocument(doc.id).length).toBeGreaterThan(0);
+
+    expect(documents.deleteDocument(doc.id)).toBe(true);
+    indexing.removeDocument(doc.id);
+
+    expect(documents.getDocument(doc.id)).toBeNull();
+    expect(documents.getDocumentContent(doc.id)).toBeNull();
+    expect(fs.existsSync(path.join(dataDir, 'documents', `${doc.id}.md`))).toBe(false);
+    expect(fs.existsSync(path.join(dataDir, 'content', `${doc.id}.txt`))).toBe(false);
+    expect(fs.existsSync(path.join(dataDir, 'chunks', `${doc.id}.json`))).toBe(false);
+    expect(indexing.getAllChunks().every(c => c.documentId === keep.id)).toBe(true);
+    expect(indexing.getStatus()).toMatchObject({ currentIndexed: 1, totalDocuments: 1, status: 'ready' });
+
+    // The other document is untouched.
+    expect(documents.getDocumentContent(keep.id)).toBe('keep me');
+  });
+
+  it('delete of an unknown ID is a no-op', () => {
+    const doc = importText('a.txt', 'a');
+    expect(documents.deleteDocument('missing')).toBe(false);
+    indexing.removeDocument('missing');
+    expect(documents.listDocuments()).toEqual([doc]);
+  });
+});

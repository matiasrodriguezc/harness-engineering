+/** Pick the sentences of a chunk that match the most terms, in original order, up to maxLen chars. */
+function bestSentences(content: string, terms: string[], maxLen: number): string {
+  // Split on line breaks (keeps markdown list items whole) and on sentence ends before a capital.
+  const sentences = content
+    .split(/\n+|(?<=[.!?])\s+(?=[A-Z])/)
+    .map(t => t.replace(/^#+\s*/, '').replace(/\s+/g, ' '));
+  const ranked = sentences
+    .map((text, pos) => ({ text: text.trim(), pos, score: countMatches(text, terms) }))
+    .filter(s => s.text.length > 0)
+    .sort((a, b) => b.score - a.score || a.pos - b.pos);
+  const picked: typeof ranked = [];
+  let len = 0;
+  for (const s of ranked) {
+    if (s.score === 0 && picked.length > 0) break;
+    if (picked.length > 0 && len + s.text.length > maxLen) continue;
+    picked.push(s);
+    len += s.text.length + 1;
+  }
+  const text = picked.sort((a, b) => a.pos - b.pos).map(s => s.text).join(' ');
+  return text.length > maxLen ? `${text.slice(0, maxLen - 3)}...` : text;
+}

 import { PersistenceService } from './persistence-service';
 
 const DOCUMENTS_META = 'documents-meta.json';
+const MAX_FILE_SIZE = 10 * 1024 * 1024;
+const SUPPORTED_TYPES = ['txt', 'md'] as const;
+type SupportedType = typeof SUPPORTED_TYPES[number];
+
+export interface DocumentMetadata {
+  wordCount: number;
+  lineCount: number;
+  fileType: SupportedType;
+}
+
+/** Extract word count, line count, and file type from a document's text and filename. */
+export function extractMetadata(filename: string, content: string): DocumentMetadata {
+  const ext = path.extname(filename).slice(1).toLowerCase();
+  if (!(SUPPORTED_TYPES as readonly string[]).includes(ext)) {
+    throw new Error(`Unsupported file type: .${ext} (supported: .txt, .md)`);
+  }
+  const trimmed = content.trim();
+  return {
+    wordCount: trimmed ? trimmed.split(/\s+/).length : 0,
+    lineCount: content.length === 0 ? 0 : content.replace(/\r?\n$/, '').split(/\r?\n/).length,
+    fileType: ext as SupportedType,
+  };
+}
 

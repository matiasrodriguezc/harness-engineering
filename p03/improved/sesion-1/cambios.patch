+  /** Remove a document's chunks and index entry. */
+  removeDocument(documentId: string): void {
+    const meta = this.persistence.readJson<Record<string, string[]>>(INDEX_META) ?? {};
+    delete meta[documentId];
+    this.persistence.writeJson(INDEX_META, meta);
+    this.persistence.writeJson(`${CHUNKS_DIR}/${documentId}.json`, []);
+  }
+
+  private markIndexed(documentId: string, chunkCount: number): void {
+    const docs = this.persistence.readJson<Document[]>('documents-meta.json') ?? [];
+    const doc = docs.find(d => d.id === documentId);
+    if (!doc) return;
+    doc.status = 'indexed';
+    doc.chunks = chunkCount;
+    this.persistence.writeJson('documents-meta.json', docs);
+  }
+

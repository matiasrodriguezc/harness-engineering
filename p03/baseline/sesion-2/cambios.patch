diff --git a/tests/services.test.ts b/tests/services.test.ts
new file mode 100644
index 0000000..4fedbec
--- /dev/null
+++ b/tests/services.test.ts
@@ -0,0 +1,51 @@
+import { describe, it, expect } from 'vitest';
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { PersistenceService } from '../src/services/persistence-service';
+import { DocumentService } from '../src/services/document-service';
+import { IndexingService } from '../src/services/indexing-service';
+import { QaService } from '../src/services/qa-service';
+
+const SAMPLES = path.resolve(__dirname, '../data/sample-documents');
+
+function setup() {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'kb-test-'));
+  const p = new PersistenceService(dir);
+  return { p, docs: new DocumentService(p), idx: new IndexingService(p), qa: new QaService(p) };
+}
+
+describe('P03 features', () => {
+  it('extracts metadata on import', () => {
+    const { docs } = setup();
+    const d = docs.importDocument(path.join(SAMPLES, 'design-notes.md')) as unknown as Record<string, unknown>;
+    const raw = fs.readFileSync(path.join(SAMPLES, 'design-notes.md'), 'utf8');
+    const meta = (d.metadata ?? d) as Record<string, unknown>;
+    expect(meta.wordCount).toBe(raw.split(/\s+/).filter(Boolean).length);
+    expect(meta.lineCount).toBeGreaterThan(1);
+    expect(String(meta.fileType)).toMatch(/md/);
+  });
+
+  it('chunks documents into ~500 char chunks', () => {
+    const { idx } = setup();
+    const text = Array.from({ length: 20 }, (_, i) => `Paragraph ${i}. ` + 'word '.repeat(30)).join('\n\n');
+    const chunks = idx.chunkDocument('x', text);
+    expect(chunks.length).toBeGreaterThan(1);
+    for (const c of chunks) expect(c.content.length).toBeLessThanOrEqual(600);
+  });
+
+  it('indexes, reports status, and answers with citations', async () => {
+    const { docs, idx, qa } = setup();
+    for (const f of fs.readdirSync(SAMPLES)) docs.importDocument(path.join(SAMPLES, f));
+    await idx.startIndexing();
+    const s = idx.getStatus() as unknown as Record<string, unknown>;
+    expect(s.documentsLoaded).toBe(3);
+    expect(s.indexedDocuments).toBe(3);
+    expect(docs.listDocuments().every(d => d.status === 'indexed')).toBe(true);
+    const r = await qa.ask('What is the retrieval plan?');
+    expect(r.citations.length).toBeGreaterThan(0);
+    expect(r.confidence).toBeGreaterThan(0.5);
+    const none = await qa.ask('zzzqqq xylophone');
+    expect(none.confidence).toBeLessThan(0.5);
+  });
+});

index 0000000..ea7742b
--- /dev/null
+++ b/scripts/e2e/conversation-export.mjs
@@ -0,0 +1,125 @@
+// E2E for conversation Markdown export, against the built app (run `npm run build` first).
+// KB_EXPORT_SAVE_PATH replaces the native save dialog (a path, or 'cancel').
+// Usage: node --experimental-websocket scripts/e2e/conversation-export.mjs
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { withApp, pageHelpers, report } from './app-session.mjs';
+
+const dataDir = fs.mkdtempSync(path.join(os.tmpdir(), 'kb-e2e-export-'));
+const outDir = fs.mkdtempSync(path.join(os.tmpdir(), 'kb-e2e-export-out-'));
+const outFile = path.join(outDir, 'conversation.md');
+const docsDir = path.resolve('data/sample-documents');
+const docs = fs.readdirSync(docsDir).map((f) => path.join(docsDir, f));
+const questions = ['What is the architecture design?', 'How does retrieval work?', 'Anything about zebras?'];
+const checks = [];
+const kb = 'window.knowledgeBase';
+
+/** Checks criteria 3-5 of spec.md against an export string and the history. */
+function checkStructure(md, history, label) {
+  const headings = md.match(/^## Question \d+$/gm) ?? [];
+  checks.push([`${label}: ${history.length} numbered question headings`, JSON.stringify(headings) === JSON.stringify(history.map((_, i) => `## Question ${i + 1}`)), headings]);
+  let ok = true;
+  const problems = [];
+  history.forEach((h, i) => {
+    const start = md.indexOf(`## Question ${i + 1}\n\n${h.question}\n`);
+    const end = i + 1 < history.length ? md.indexOf(`## Question ${i + 2}\n`) : md.length;
+    if (start < 0) { ok = false; problems.push(`q${i + 1} missing`); return; }
+    const section = md.slice(start, end);
+    let pos = section.indexOf(h.response.answer);
+    if (pos < 0) { ok = false; problems.push(`a${i + 1} missing`); return; }
+    if (h.response.citations.length === 0 && !section.includes('No citations.')) { ok = false; problems.push(`q${i + 1} no-citation text`); }
+    for (const c of h.response.citations) {
+      const t = section.indexOf(`**${c.documentTitle}**`, pos);
+      if (t < 0) { ok = false; problems.push(`q${i + 1} title ${c.documentTitle}`); continue; }
+      pos = t;
+      for (const line of c.excerpt.split(/\r?\n/)) {
+        const l = section.indexOf(`> ${line}`, pos);
+        if (l < 0) { ok = false; problems.push(`q${i + 1} excerpt line`); } else pos = l;
+      }
+    }
+  });
+  checks.push([`${label}: each question, answer and citation (title + quoted excerpt) in its own section, in order`, ok, problems.length ? problems : undefined]);
+}
+
+try {
+  // Session 1: export to a file.
+  await withApp({ dataDir, env: { KB_EXPORT_SAVE_PATH: outFile } }, async ({ evaluate, waitFor }) => {
+    await evaluate(pageHelpers);
+    const keys = await evaluate(`Object.keys(${kb}).join(',')`);
+    checks.push(['conversation.export is a function; other namespaces unchanged', keys === 'documents,indexing,qa,feedback,conversation,app' && (await evaluate(`typeof ${kb}.conversation.export`)) === 'function', keys]);
+
+    const empty = await evaluate(`${kb}.conversation.export()`);
+    checks.push(['empty history -> "# Conversation export" + "No questions yet.", no "## Question"', empty.includes('# Conversation export') && empty.includes('No questions yet.') && !empty.includes('## Question'), empty]);
+
+    // Button with an empty conversation.
+    const btn = await evaluate(`(() => { const b = __e2e.byLabel('Export conversation'); const f = document.querySelector('[aria-label="Ask a question"]').form;
+      return b.map(x => ({ tag: x.tagName, type: x.type, disabled: x.disabled, inForm: f.contains(x), visible: x.offsetParent !== null })); })()`);
+    checks.push(['one enabled, visible, non-submit Export button in the question form (empty conversation)', btn.length === 1 && btn[0].tag === 'BUTTON' && btn[0].type !== 'submit' && !btn[0].disabled && btn[0].inForm && btn[0].visible, btn]);
+
+    await evaluate(`(async () => { for (const d of ${JSON.stringify(docs)}) await ${kb}.documents.import(d); await ${kb}.indexing.start(); return true; })()`);
+    for (const q of questions) {
+      await evaluate(`__e2e.setInput(document.querySelector('[aria-label="Ask a question"]'), ${JSON.stringify(q)}); document.querySelector('[aria-label="Ask a question"]').form.requestSubmit(); true`);
+      await waitFor(`document.querySelectorAll('[data-answer-id]').length === ${questions.indexOf(q) + 1} && !document.querySelector('[aria-label="Ask a question"]').form.querySelector('button[type=submit]').disabled`);
+    }
+    const history = await evaluate(`${kb}.qa.history()`);
+    checks.push(['3 questions asked, at least one answer with citations', history.length === 3 && history.some((h) => h.response.citations.length > 0), history.map((h) => h.response.citations.length)]);
+    const md = await evaluate(`${kb}.conversation.export()`);
+    checkStructure(md, history, 'bridge');
+    const after = await evaluate(`${kb}.qa.history()`);
+    checks.push(['export() does not change qa.history()', JSON.stringify(after) === JSON.stringify(history)]);
+
+    // Clicking the button does not ask a question, saves the file, and shows a status with the path.
+    await evaluate(`__e2e.byLabel('Export conversation')[0].click(); true`);
+    await waitFor(`!!document.querySelector('[role=status][data-export-message]')`);
+    const status = await evaluate(`document.querySelector('[role=status][data-export-message]').textContent`);
+    checks.push(['status message includes the saved path', status.includes(outFile), status]);
+    const fileText = fs.readFileSync(outFile, 'utf8');
+    checks.push(['saved file equals conversation.export() (UTF-8)', fileText === (await evaluate(`${kb}.conversation.export()`))]);
+    checks.push(['clicking the button did not ask a question', (await evaluate(`${kb}.qa.history()`)).length === 3]);
+
+    // Another question adds Question 4.
+    await evaluate(`${kb}.qa.ask('How are documents imported?')`);
+    const md4 = await evaluate(`${kb}.conversation.export()`);
+    checks.push(['a new question adds "## Question 4"', md4.includes('## Question 4\n\nHow are documents imported?')]);
+  });
+
+  const savedBeforeRestart = fs.readFileSync(outFile, 'utf8');
+
+  // Session 2: restart with same data dir; cancel; failure.
+  await withApp({ dataDir, env: { KB_EXPORT_SAVE_PATH: 'cancel' } }, async ({ evaluate, waitFor }) => {
+    await evaluate(pageHelpers);
+    const history = await evaluate(`${kb}.qa.history()`);
+    const md = await evaluate(`${kb}.conversation.export()`);
+    checks.push(['after restart: export has the same 4 questions, answers and citations', history.length === 4]);
+    checkStructure(md, history, 'after restart');
+
+    await waitFor(`__e2e.byLabel('Export conversation').length === 1`);
+    await evaluate(`__e2e.byLabel('Export conversation')[0].click(); true`);
+    await evaluate(`__e2e.sleep(800)`);
+    const msgs = await evaluate(`[...document.querySelectorAll('[role=alert],[role=status][data-export-message]')].map(e => e.textContent)`);
+    checks.push(['cancel: no message, no error, file untouched', msgs.length === 0 && fs.readFileSync(outFile, 'utf8') === savedBeforeRestart, msgs]);
+
+    await evaluate(`${kb}.qa.clearHistory()`);
+    const cleared = await evaluate(`${kb}.conversation.export()`);
+    checks.push(['after qa.clearHistory() export is the empty document', cleared.includes('No questions yet.') && !cleared.includes('## Question')]);
+  });
+
+  // Session 3: unwritable path -> role=alert, app keeps working.
+  const badPath = path.join(outDir, 'no-such-dir', 'x.md');
+  await withApp({ dataDir, env: { KB_EXPORT_SAVE_PATH: badPath } }, async ({ evaluate, waitFor }) => {
+    await evaluate(pageHelpers);
+    await evaluate(`__e2e.byLabel('Export conversation')[0].click(); true`);
+    await waitFor(`!!document.querySelector('[role=alert]')`);
+    const alert = await evaluate(`document.querySelector('[role=alert]').textContent`);
+    checks.push(['write failure shows a role=alert error', alert.length > 0 && !fs.existsSync(badPath), alert]);
+    await evaluate(`__e2e.setInput(document.querySelector('[aria-label="Ask a question"]'), 'What is the architecture design?'); document.querySelector('[aria-label="Ask a question"]').form.requestSubmit(); true`);
+    await waitFor(`document.querySelectorAll('[data-answer-id]').length === 1`);
+    checks.push(['a question can still be asked after the failure', (await evaluate(`${kb}.qa.history()`)).length === 1]);
+  });
+} finally {
+  fs.rmSync(dataDir, { recursive: true, force: true });
+  fs.rmSync(outDir, { recursive: true, force: true });
+}
+
+report('conversation-export e2e', checks);

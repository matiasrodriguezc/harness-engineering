@@ -0,0 +1,180 @@
+import { beforeAll, beforeEach, describe, expect, it, vi } from 'vitest';
+import * as fs from 'fs';
+import * as path from 'path';
+import { renderToStaticMarkup } from 'react-dom/server';
+import { IPC_CHANNELS, QAHistory } from '../src/shared/types';
+import { buildConversationMarkdown } from '../src/services/conversation-export-service';
+import { defaultExportFileName, registerIpcHandlers, Services } from '../src/main/ipc-handlers';
+import { QuestionPanel } from '../src/renderer/components/QuestionPanel';
+import { makeServices, quietLogs, SAMPLE_DOCS, tempDir } from './helpers';
+
+const exposed: Record<string, any> = {};
+const invoke = vi.fn(async (..._args: unknown[]) => undefined);
+vi.mock('electron', () => ({
+  contextBridge: { exposeInMainWorld: (key: string, api: unknown) => { exposed[key] = api; } },
+  ipcRenderer: { invoke: (...args: unknown[]) => invoke(...args) },
+}));
+
+beforeAll(async () => {
+  await import('../src/preload/preload');
+});
+
+beforeEach(() => {
+  quietLogs();
+  vi.spyOn(Math, 'random').mockReturnValue(0);
+});
+
+const entry = (question: string, answer: string, citations: QAHistory['response']['citations']): QAHistory => ({
+  question,
+  response: { id: question, answer, citations, confidence: 0.5, timestamp: '2026-11-16T10:00:00.000Z' },
+});
+
+describe('buildConversationMarkdown', () => {
+  it('empty conversation says there are no questions yet', () => {
+    const md = buildConversationMarkdown([]);
+    expect(md).toBe('# Conversation export\n\nNo questions yet.\n');
+    expect(md).not.toContain('## Question');
+  });
+
+  it('numbers questions in history order, each followed by its answer and citations', () => {
+    const md = buildConversationMarkdown([
+      entry('First question?', 'First answer.', [
+        { documentId: 'd1', documentTitle: 'design-notes', chunkIndex: 0, excerpt: 'Layers everywhere' },
+        { documentId: 'd2', documentTitle: 'retrieval-plan', chunkIndex: 1, excerpt: 'Keyword overlap' },
+      ]),
+      entry('Second question?', 'Second answer.', []),
+    ]);
+    expect(md).toBe(
+      [
+        '# Conversation export',
+        '## Question 1',
+        'First question?',
+        '### Answer',
+        'First answer.',
+        '### Citations',
+        '1. **design-notes**\n   > Layers everywhere',
+        '2. **retrieval-plan**\n   > Keyword overlap',
+        '## Question 2',
+        'Second question?',
+        '### Answer',
+        'Second answer.',
+        '### Citations',
+        'No citations.',
+      ].join('\n\n') + '\n',
+    );
+  });
+
+  it('quotes every line of a multi-line excerpt so it stays inside its citation', () => {
+    const md = buildConversationMarkdown([
+      entry('q', 'a', [{ documentId: 'd', documentTitle: 'notes', chunkIndex: 0, excerpt: 'line one\nline two\r\n\nline four' }]),
+    ]);
+    expect(md).toContain('1. **notes**\n   > line one\n   > line two\n   > \n   > line four\n');
+  });
+
+  it('copies text as stored (no Markdown escaping)', () => {
+    const md = buildConversationMarkdown([entry('What is *bold* and `code`?', '# not a heading', [])]);
+    expect(md).toContain('What is *bold* and `code`?');
+    expect(md).toContain('# not a heading');
+  });
+});
+
+describe('ConversationExportService with real history', () => {
+  it('reflects the current history, survives a restart and does not change the history', async () => {
+    const dir = tempDir();
+    const s = makeServices(dir);
+    s.documentService.importDocument(path.join(SAMPLE_DOCS, 'design-notes.md'));
+    await s.indexingService.startIndexing();
+    expect(s.conversationExportService.exportMarkdown()).toContain('No questions yet.');
+
+    await s.qaService.ask('What is the architecture design?');
+    await s.qaService.ask('Anything about zebras?');
+    const before = JSON.stringify(s.qaService.getHistory());
+    const md = s.conversationExportService.exportMarkdown();
+    expect(JSON.stringify(s.qaService.getHistory())).toBe(before);
+    expect(md.match(/^## Question \d+$/gm)).toEqual(['## Question 1', '## Question 2']);
+    const history = s.qaService.getHistory();
+    expect(md.indexOf(history[0].response.answer)).toBeGreaterThan(md.indexOf('What is the architecture design?'));
+    for (const c of history[0].response.citations) expect(md).toContain(`**${c.documentTitle}**`);
+
+    expect(makeServices(dir).conversationExportService.exportMarkdown()).toBe(md);
+
+    s.qaService.clearHistory();
+    expect(s.conversationExportService.exportMarkdown()).toBe('# Conversation export\n\nNo questions yet.\n');
+  });
+
+  it('writeToFile writes UTF-8 and throws for a missing directory', () => {
+    const s = makeServices(tempDir());
+    const file = path.join(tempDir(), 'out.md');
+    s.conversationExportService.writeToFile(file, 'héllo ✓\n');
+    expect(fs.readFileSync(file, 'utf8')).toBe('héllo ✓\n');
+    expect(() => s.conversationExportService.writeToFile(path.join(tempDir(), 'nope', 'x.md'), 'x')).toThrow();
+  });
+});
+
+describe('conversation export bridge and IPC', () => {
+  function wire(chooseExportPath?: Services['chooseExportPath']) {
+    const handlers = new Map<string, (...args: any[]) => any>();
+    const services = makeServices(tempDir());
+    registerIpcHandlers({ handle: (c: string, fn: any) => handlers.set(c, fn) } as any, {
+      ...services,
+      chooseExportPath,
+    } as Services);
+    const call = (channel: string, ...args: unknown[]) => handlers.get(channel)!({ sender: {} }, ...args);
+    return { call, services };
+  }
+
+  it('preload exposes conversation.export and conversation.saveExport on their channels', async () => {
+    const kb = exposed.knowledgeBase;
+    expect(Object.keys(kb)).toEqual(['documents', 'indexing', 'qa', 'feedback', 'conversation', 'app']);
+    expect(typeof kb.conversation.export).toBe('function');
+    await kb.conversation.export();
+    expect(invoke).toHaveBeenLastCalledWith(IPC_CHANNELS.EXPORT_CONVERSATION);
+    await kb.conversation.saveExport('# md');
+    expect(invoke).toHaveBeenLastCalledWith(IPC_CHANNELS.SAVE_CONVERSATION_EXPORT, '# md');
+  });
+
+  it('conversation:export returns the Markdown of the history', async () => {
+    const { call } = wire();
+    expect(await call(IPC_CHANNELS.EXPORT_CONVERSATION)).toContain('No questions yet.');
+    await call(IPC_CHANNELS.ASK_QUESTION, 'How does retrieval work?');
+    expect(await call(IPC_CHANNELS.EXPORT_CONVERSATION)).toContain('## Question 1\n\nHow does retrieval work?');
+  });
+
+  it('conversation:save-export writes to the chosen .md path, and writes nothing when cancelled', async () => {
+    const file = path.join(tempDir(), 'export.md');
+    const choose = vi.fn(async () => file);
+    const { call } = wire(choose);
+    expect(await call(IPC_CHANNELS.SAVE_CONVERSATION_EXPORT, '# Conversation export\n')).toEqual({ saved: true, filePath: file });
+    expect(choose.mock.calls[0][0]).toMatch(/\.md$/);
+    expect(fs.readFileSync(file, 'utf8')).toBe('# Conversation export\n');
+
+    const cancelled = wire(async () => null);
+    const write = vi.spyOn(cancelled.services.conversationExportService, 'writeToFile');
+    expect(await cancelled.call(IPC_CHANNELS.SAVE_CONVERSATION_EXPORT, 'x')).toEqual({ saved: false });
+    expect(write).not.toHaveBeenCalled();
+  });
+
+  it('conversation:save-export rejects a failed write and non-string content', async () => {
+    const { call } = wire(async () => path.join(tempDir(), 'missing-dir', 'x.md'));
+    await expect(call(IPC_CHANNELS.SAVE_CONVERSATION_EXPORT, 'x')).rejects.toThrow();
+    await expect(call(IPC_CHANNELS.SAVE_CONVERSATION_EXPORT, 42)).rejects.toThrow(/string/);
+  });
+
+  it('default file name ends in .md', () => {
+    expect(defaultExportFileName(new Date('2026-11-16T12:00:00Z'))).toBe('conversation-2026-11-16.md');
+  });
+});
+
+describe('QuestionPanel export button', () => {
+  it('renders an enabled, non-submit "Export conversation" button inside the question form', () => {
+    for (const disabled of [false, true]) {
+      const html = renderToStaticMarkup(<QuestionPanel onAsk={() => {}} disabled={disabled} />);
+      const form = html.slice(html.indexOf('<form'), html.indexOf('</form>'));
+      expect(form).toContain('aria-label="Ask a question"');
+      const button = form.match(/<button[^>]*aria-label="Export conversation"[^>]*>/)?.[0];
+      expect(button).toBeDefined();
+      expect(button).toContain('type="button"');
+      expect(button).not.toContain('disabled');
+    }
+  });
+});

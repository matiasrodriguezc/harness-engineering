@@ -0,0 +1,69 @@
+import { useState } from 'react';
+
+type Message = { kind: 'status' | 'error'; text: string } | null;
+
+/**
+ * Button (aria-label 'Export conversation') that gets the conversation as Markdown from
+ * window.knowledgeBase.conversation.export() and saves it to a file the user picks.
+ * Shows a role=status confirmation with the path, or a role=alert error. Cancelling shows nothing.
+ */
+export function ExportConversationButton() {
+  const [busy, setBusy] = useState(false);
+  const [message, setMessage] = useState<Message>(null);
+
+  const handleExport = async () => {
+    if (busy) return;
+    setBusy(true);
+    setMessage(null);
+    try {
+      const markdown = await window.knowledgeBase.conversation.export();
+      const result = await window.knowledgeBase.conversation.saveExport(markdown);
+      if (result.saved) setMessage({ kind: 'status', text: `Conversation exported to ${result.filePath}` });
+    } catch (err) {
+      console.error('Conversation export failed:', err);
+      const detail = err instanceof Error ? err.message.replace(/^Error invoking remote method '[^']+': /, '') : '';
+      setMessage({ kind: 'error', text: `Could not export the conversation.${detail ? ` ${detail}` : ''}` });
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <>
+      <button
+        type="button"
+        aria-label="Export conversation"
+        title="Export conversation as Markdown"
+        onClick={handleExport}
+        aria-busy={busy}
+        style={{
+          marginLeft: '10px',
+          padding: '10px 14px',
+          background: '#0f3460',
+          color: '#e0e0e0',
+          border: '1px solid #1a1a4e',
+          borderRadius: '6px',
+          cursor: busy ? 'wait' : 'pointer',
+          fontSize: '14px',
+        }}
+      >
+        Export
+      </button>
+      {message && (
+        <div
+          role={message.kind === 'error' ? 'alert' : 'status'}
+          data-export-message={message.kind}
+          style={{
+            flexBasis: '100%',
+            marginTop: '8px',
+            fontSize: '12px',
+            color: message.kind === 'error' ? '#ff6b6b' : '#7bd389',
+            wordBreak: 'break-all',
+          }}
+        >
+          {message.text}
+        </div>
+      )}
+    </>
+  );
+}

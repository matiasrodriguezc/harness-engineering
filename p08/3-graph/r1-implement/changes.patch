@@ -0,0 +1,61 @@
+import * as fs from 'fs';
+import { QAHistory } from '../shared/types';
+import { logger } from './logger';
+
+const SERVICE = 'conversation-export';
+
+/**
+ * Builds the Markdown export of a conversation (Q&A history, oldest first).
+ * Text is copied as stored; Markdown is not escaped. Every excerpt line is quoted with "> ".
+ */
+export function buildConversationMarkdown(history: QAHistory[]): string {
+  const parts: string[] = ['# Conversation export'];
+  if (history.length === 0) {
+    parts.push('No questions yet.');
+    return parts.join('\n\n') + '\n';
+  }
+  history.forEach((entry, i) => {
+    parts.push(`## Question ${i + 1}`);
+    parts.push(entry.question);
+    parts.push('### Answer');
+    parts.push(entry.response.answer);
+    parts.push('### Citations');
+    const citations = entry.response.citations ?? [];
+    if (citations.length === 0) {
+      parts.push('No citations.');
+    } else {
+      citations.forEach((c, j) => {
+        const quoted = String(c.excerpt ?? '')
+          .split(/\r?\n/)
+          .map(line => `   > ${line}`);
+        parts.push([`${j + 1}. **${c.documentTitle}**`, ...quoted].join('\n'));
+      });
+    }
+  });
+  return parts.join('\n\n') + '\n';
+}
+
+/** Exports the current conversation as Markdown and writes exports to files. */
+export class ConversationExportService {
+  constructor(private getHistory: () => QAHistory[]) {}
+
+  /** Markdown for the current history; reads the history on every call and changes nothing. */
+  exportMarkdown(): string {
+    const history = this.getHistory();
+    logger.debug(SERVICE, 'Conversation exported', { entries: history.length });
+    return buildConversationMarkdown(history);
+  }
+
+  /** Writes `content` to `filePath` as UTF-8. Does not create directories; throws if the write fails. */
+  writeToFile(filePath: string, content: string): void {
+    if (typeof filePath !== 'string' || filePath.trim() === '') throw new TypeError('A file path is required');
+    if (typeof content !== 'string') throw new TypeError('Export content must be a string');
+    try {
+      fs.writeFileSync(filePath, content, { encoding: 'utf8' });
+    } catch (err) {
+      logger.error(SERVICE, 'Writing conversation export failed', { filePath, error: String(err) });
+      throw err;
+    }
+    logger.info(SERVICE, 'Conversation export saved', { filePath, bytes: Buffer.byteLength(content, 'utf8') });
+  }
+}

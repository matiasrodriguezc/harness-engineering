+++ b/tests/services.test.ts
@@ -0,0 +1,194 @@
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { PersistenceService } from '../src/services/persistence-service';
+import { DocumentService } from '../src/services/document-service';
+import { IndexingService, chunkText, CHUNK_SIZE } from '../src/services/indexing-service';
+import { QaService } from '../src/services/qa-service';
+
+const SAMPLES = path.resolve(__dirname, '..', 'data', 'sample-documents');
+
+let tmp: string;
+let persistence: PersistenceService;
+let docs: DocumentService;
+let indexing: IndexingService;
+let qa: QaService;
+
+beforeEach(() => {
+  tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'kb-test-'));
+  persistence = new PersistenceService(path.join(tmp, 'data'));
+  docs = new DocumentService(persistence);
+  indexing = new IndexingService(persistence, docs);
+  qa = new QaService(persistence, indexing, docs);
+});
+
+afterEach(() => {
+  fs.rmSync(tmp, { recursive: true, force: true });
+});
+
+function writeFile(name: string, content: string): string {
+  const p = path.join(tmp, name);
+  fs.writeFileSync(p, content);
+  return p;
+}
+
+describe('PersistenceService', () => {
+  it('creates the data directory', () => {
+    expect(fs.existsSync(path.join(tmp, 'data', 'documents'))).toBe(true);
+  });
+
+  it('round-trips JSON without leaving temp files', () => {
+    persistence.writeJson('a/b.json', { x: 1 });
+    expect(persistence.readJson('a/b.json')).toEqual({ x: 1 });
+    expect(fs.readdirSync(path.join(tmp, 'data', 'a'))).toEqual(['b.json']);
+  });
+
+  it('rejects paths that escape the data directory', () => {
+    expect(() => persistence.readText('../outside.txt')).toThrow(/escapes/);
+  });
+});
+
+describe('DocumentService', () => {
+  it('imports a markdown file using its H1 as title', () => {
+    const doc = docs.importDocument(path.join(SAMPLES, 'retrieval-plan.md'));
+    expect(doc.title).toBe('Retrieval Plan');
+    expect(doc.status).toBe('imported');
+    expect(docs.getDocumentContent(doc.id)).toContain('Keyword Matching');
+  });
+
+  it('rejects unsupported types and oversized files', () => {
+    expect(() => docs.importDocument(writeFile('x.pdf', 'hi'))).toThrow(/Unsupported/);
+    const big = writeFile('big.txt', '');
+    fs.truncateSync(big, 10 * 1024 * 1024 + 1);
+    expect(() => docs.importDocument(big)).toThrow(/too large/);
+  });
+
+  it('keeps two files with the same name distinct and deletes cleanly', () => {
+    fs.mkdirSync(path.join(tmp, 'a'));
+    fs.mkdirSync(path.join(tmp, 'b'));
+    const a = docs.importDocument(writeFile('a/notes.txt', 'alpha'));
+    const b = docs.importDocument(writeFile('b/notes.txt', 'beta'));
+    expect(docs.getDocumentContent(a.id)).toBe('alpha');
+    expect(docs.getDocumentContent(b.id)).toBe('beta');
+
+    expect(docs.deleteDocument(a.id)).toBe(true);
+    expect(docs.getDocument(a.id)).toBeNull();
+    expect(persistence.exists(`content/${a.id}.txt`)).toBe(false);
+    expect(docs.getDocumentContent(b.id)).toBe('beta');
+  });
+});
+
+describe('chunkText', () => {
+  it('merges short paragraphs and respects the size budget', () => {
+    const paras = Array.from({ length: 20 }, (_, i) => `Paragraph ${i} `.repeat(8).trim());
+    const chunks = chunkText(paras.join('\n\n'));
+    expect(chunks.length).toBeGreaterThan(1);
+    for (const c of chunks) expect(c.length).toBeLessThanOrEqual(CHUNK_SIZE);
+    expect(chunks.join('\n\n')).toBe(paras.join('\n\n'));
+  });
+
+  it('splits a single oversized paragraph', () => {
+    const para = 'This is a sentence about indexing. '.repeat(60);
+    const chunks = chunkText(para);
+    expect(chunks.length).toBeGreaterThan(2);
+    for (const c of chunks) expect(c.length).toBeLessThanOrEqual(CHUNK_SIZE);
+  });
+});
+
+describe('IndexingService', () => {
+  it('indexing one document registers it in the index and updates status', async () => {
+    const doc = docs.importDocument(path.join(SAMPLES, 'design-notes.md'));
+    expect(indexing.getStatus()).toMatchObject({ documentsLoaded: 1, documentsIndexed: 0, indexStatus: 'idle' });
+
+    await indexing.startIndexing(doc.id);
+    const updated = docs.getDocument(doc.id)!;
+    expect(updated.status).toBe('indexed');
+    expect(updated.chunks).toBe(indexing.getChunksForDocument(doc.id).length);
+    expect(indexing.getAllChunks().length).toBe(updated.chunks);
+    expect(indexing.getStatus()).toMatchObject({ documentsIndexed: 1, indexStatus: 'ready' });
+  });
+
+  it('index-all only indexes new documents; removeDocument cleans up', async () => {
+    const a = docs.importDocument(path.join(SAMPLES, 'design-notes.md'));
+    docs.importDocument(path.join(SAMPLES, 'meeting-summary.txt'));
+    await indexing.startIndexing();
+    expect(indexing.getStatus().documentsIndexed).toBe(2);
+
+    indexing.removeDocument(a.id);
+    docs.deleteDocument(a.id);
+    expect(indexing.getAllChunks().every(c => c.documentId !== a.id)).toBe(true);
+    expect(indexing.getStatus()).toMatchObject({ documentsLoaded: 1, documentsIndexed: 1, indexStatus: 'ready' });
+  });
+
+  it('reports an error for a missing document', async () => {
+    await expect(indexing.startIndexing('nope')).rejects.toThrow(/not found/);
+    expect(indexing.getStatus().indexStatus).toBe('error');
+  });
+});
+
+/** Every quoted sentence or list item in the answer must appear in a cited chunk. */
+function expectGrounded(answer: string, citations: Array<{ documentId: string; chunkIndex: number }>) {
+  const cited = citations
+    .map(c => indexing.getChunksForDocument(c.documentId).find(ch => ch.index === c.chunkIndex)!.content)
+    .join('\n');
+  const pieces = answer
+    .split('\n')
+    .map(l => l.replace(/^According to "[^"]+":\s*/, '').replace(/^\u2022\s*/, '').trim())
+    .filter(Boolean)
+    .flatMap(l => l.split(/(?<=[.!?])\s+/));
+  expect(pieces.length).toBeGreaterThan(0);
+  for (const piece of pieces) expect(cited).toContain(piece.replace(/\.$/, ''));
+}
+
+describe('QaService', () => {
+  async function loadSamples() {
+    for (const f of fs.readdirSync(SAMPLES)) docs.importDocument(path.join(SAMPLES, f));
+    await indexing.startIndexing();
+  }
+
+  it('says nothing is indexed when the library is empty', async () => {
+    const r = await qa.ask('What is the chunking strategy?');
+    expect(r.citations).toEqual([]);
+    expect(r.confidence).toBe(0.3);
+    expect(r.answer).toMatch(/No documents have been indexed/);
+  });
+
+  it('answers with citations and text that appears in the cited chunks', async () => {
+    await loadSamples();
+    const r = await qa.ask('What was decided about the vector database?');
+    expect(r.confidence).toBe(0.85);
+    expect(r.citations.length).toBeGreaterThan(0);
+    expect(r.citations[0].documentTitle).toBe('meeting-summary');
+    expect(r.answer.toLowerCase()).toContain('vector database');
+
+    expectGrounded(r.answer, r.citations);
+  });
+
+  it('quotes the body under a matching heading, not the heading itself', async () => {
+    await loadSamples();
+    const r = await qa.ask('What are the next steps?');
+    expect(r.answer).toContain('Implement document import flow with file validation');
+    expect(r.answer).not.toMatch(/: Next Steps/);
+    expectGrounded(r.answer, r.citations);
+  });
+
+  it('returns a low-confidence answer when nothing matches', async () => {
+    await loadSamples();
+    const r = await qa.ask('zebra giraffe xylophone');
+    expect(r.citations).toEqual([]);
+    expect(r.confidence).toBe(0.3);
+  });
+
+  it('persists history across service instances', async () => {
+    await loadSamples();
+    await qa.ask('How does keyword matching work?');
+    const fresh = new QaService(persistence, indexing, docs);
+    expect(fresh.getHistory()).toHaveLength(1);
+    expect(fresh.getHistory()[0].question).toBe('How does keyword matching work?');
+  });
+
+  it('rejects empty questions', async () => {
+    await expect(qa.ask('   ')).rejects.toThrow();
+  });
+});

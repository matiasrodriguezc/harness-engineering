@@ -0,0 +1,97 @@
+// End-to-end smoke test: launches the real app with a throwaway data dir,
+// drives it through window.knowledgeBase (the preload bridge), checks the
+// rendered UI, and fails on any renderer console error.
+// Usage: npm run build && npx electron scripts/smoke.js [screenshot.png]
+const { app, BrowserWindow } = require('electron');
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+
+const root = path.resolve(__dirname, '..');
+const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'kb-smoke-'));
+app.setPath('userData', tmp);
+const screenshotPath = process.argv.find(a => a.endsWith('.png'));
+
+const consoleErrors = [];
+const fail = msg => {
+  console.error(`[smoke] FAIL: ${msg}`);
+  app.exit(1);
+};
+
+app.on('browser-window-created', (_e, win) => {
+  win.webContents.on('console-message', (_ev, level, message) => {
+    if (level >= 3) consoleErrors.push(message);
+  });
+  win.webContents.once('did-finish-load', () => run(win).catch(err => fail(err.stack || String(err))));
+});
+
+const wait = ms => new Promise(r => setTimeout(r, ms));
+
+async function run(win) {
+  const js = code => win.webContents.executeJavaScript(code);
+  await wait(500);
+
+  const bounds = win.getBounds();
+  if (!win.isVisible()) return fail('window not visible');
+  console.log(`[smoke] window visible ${bounds.width}x${bounds.height}`);
+
+  if (!(await js('document.body.innerText')).includes('No documents imported yet')) return fail('empty state missing');
+  console.log('[smoke] empty document list shown');
+
+  const samples = path.join(root, 'data', 'sample-documents');
+  for (const f of fs.readdirSync(samples)) {
+    await js(`window.knowledgeBase.documents.import(${JSON.stringify(path.join(samples, f))})`);
+  }
+  const status = await js('window.knowledgeBase.app.status()');
+  if (status.documentsIndexed !== 3 || status.indexStatus !== 'ready') return fail(`bad status ${JSON.stringify(status)}`);
+  console.log(`[smoke] imported + indexed: ${JSON.stringify(status)}`);
+  if (!fs.existsSync(path.join(tmp, 'knowledge-base-data', 'index', 'index-meta.json'))) return fail('index-meta missing');
+  console.log('[smoke] data dir populated at userData/knowledge-base-data');
+
+  // Refresh UI, open a document, check its content renders.
+  await js(`[...document.querySelectorAll('button')].find(b => b.textContent === 'Refresh').click()`);
+  await wait(300);
+  await js(`[...document.querySelectorAll('.doc-item')].find(b => b.textContent.includes('meeting-summary')).click()`);
+  await wait(300);
+  if (!(await js(`document.querySelector('.doc-content')?.innerText ?? ''`)).includes('Attendees')) return fail('document content not shown');
+  console.log('[smoke] document content rendered');
+
+  // Ask through the real input + form submit.
+  await js(`(() => {
+    const input = document.querySelector('.question-bar input');
+    const setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set;
+    setter.call(input, 'What are the next steps?');
+    input.dispatchEvent(new Event('input', { bubbles: true }));
+    document.querySelector('.question-bar button').click();
+  })()`);
+  await wait(800);
+  const answer = await js(`document.querySelector('.answer-pane')?.innerText ?? ''`);
+  if (!answer.includes('Implement document import flow')) return fail(`unexpected answer: ${answer}`);
+  console.log('[smoke] answer rendered with citations:', answer.includes('Sources'));
+
+  // Clicking a citation opens the cited chunk.
+  await js(`document.querySelector('.citation').click()`);
+  await wait(500);
+  if (!(await js(`!!document.querySelector('.chunk.highlight')`))) return fail('citation did not highlight chunk');
+  console.log('[smoke] citation click highlights chunk');
+
+  if (screenshotPath) {
+    const img = await win.webContents.capturePage();
+    fs.writeFileSync(screenshotPath, img.toPNG());
+    console.log(`[smoke] screenshot: ${screenshotPath}`);
+  }
+
+  // Delete cleans up.
+  const doc = (await js('window.knowledgeBase.documents.list()'))[0];
+  await js(`window.knowledgeBase.documents.delete(${JSON.stringify(doc.id)})`);
+  const after = await js('window.knowledgeBase.app.status()');
+  if (after.documentsLoaded !== 2 || after.documentsIndexed !== 2) return fail(`delete left stale data ${JSON.stringify(after)}`);
+  console.log('[smoke] delete removes document and index entry');
+
+  if (consoleErrors.length) return fail(`console errors:\n${consoleErrors.join('\n')}`);
+  console.log('[smoke] no console errors\n[smoke] PASS');
+  fs.rmSync(tmp, { recursive: true, force: true });
+  app.exit(0);
+}
+
+require(path.join(root, 'dist', 'main', 'main.js'));

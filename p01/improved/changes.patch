diff --git a/src/renderer/components/AnswerPanel.tsx b/src/renderer/components/AnswerPanel.tsx
new file mode 100644
index 0000000..f8c8c66
--- /dev/null
+++ b/src/renderer/components/AnswerPanel.tsx
@@ -0,0 +1,53 @@
+import type { Citation, QAHistory } from '../../shared/types';
+
+interface Props {
+  current: QAHistory;
+  history: QAHistory[];
+  onCitation: (citation: Citation) => void;
+  onShowHistory: (entry: QAHistory) => void;
+}
+
+export function AnswerPanel({ current, history, onCitation, onShowHistory }: Props) {
+  const { question, response } = current;
+  const high = response.confidence >= 0.5;
+  const previous = history.filter(h => h !== current).slice(-20).reverse();
+
+  return (
+    <section aria-live="polite">
+      <div className="answer-q">
+        Q: {question}
+        <span className="confidence" style={{ color: high ? 'var(--ok)' : 'var(--warn)' }}>
+          confidence {Math.round(response.confidence * 100)}%
+        </span>
+      </div>
+      <div className="answer-text">{response.answer}</div>
+
+      {response.citations.length > 0 && (
+        <div className="citations">
+          Sources (click to open):
+          {response.citations.map((c, i) => (
+            <button key={`${c.documentId}-${c.chunkIndex}-${i}`} className="citation" onClick={() => onCitation(c)}>
+              <strong>[{i + 1}] {c.documentTitle}</strong> · chunk {c.chunkIndex}
+              <br />“{c.excerpt}”
+            </button>
+          ))}
+        </div>
+      )}
+
+      {previous.length > 0 && (
+        <details className="history">
+          <summary>Previous questions ({previous.length})</summary>
+          <ol>
+            {previous.map(entry => (
+              <li key={entry.response.timestamp}>
+                <button className="link" onClick={() => onShowHistory(entry)}>
+                  {entry.question}
+                </button>
+              </li>
+            ))}
+          </ol>
+        </details>
+      )}
+    </section>
+  );
+}

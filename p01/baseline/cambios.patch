+const LIST_ITEM = /^([-*+]|\d+[.)])\s+/;
+
+function cleanInline(line: string): string {
+  return line
+    .replace(LIST_ITEM, '')
+    .replace(/`([^`]*)`/g, '$1')
+    .replace(/\*\*([^*]+)\*\*/g, '$1')
+    .trim();
+}
+
+export interface AnswerUnit {
+  text: string;
+  /** Nearest preceding heading, used as scoring context. */
+  context: string;
+}
+
+/** A short title-like line, e.g. "4. Next Steps", "Discussion Points:". "Key: value" lines are content, not headings. */
+function isHeadingLike(cleaned: string): boolean {
+  if (cleaned.endsWith(':')) return cleaned.split(/\s+/).length <= 8;
+  return cleaned.split(/\s+/).length <= 8 && !cleaned.includes(':') && !/[.!?;,]$/.test(cleaned);
+}
+
+const isNumbered = (line: string) => /^\d+[.)]\s/.test(line);
+
+/**
+ * Split a chunk into answer-sized units: sentences and list items. Headings aren't answers themselves,
+ * but are kept as context for the units beneath them. A heading or a line ending in ":" that is followed
+ * by list items becomes one unit ("X includes: a; b; c.") so the list stays with what introduces it.
+ */
+export function splitUnits(text: string): AnswerUnit[] {
+  const lines = text.split('\n').map(l => l.trim());
+  const out: AnswerUnit[] = [];
+  let context = '';
+  const push = (unit: string) => {
+    if (unit.split(/\s+/).length >= 3) out.push({ text: unit, context });
+  };
+
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i];
+    if (!line) continue;
+    const markdownHeading = line.match(/^#{1,6}\s+(.*)$/);
+    if (markdownHeading) {
+      context = cleanInline(markdownHeading[1]);
+      continue;
+    }
+
+    const cleaned = cleanInline(line);
+    const headingLike = isHeadingLike(cleaned);
+    const isItem = LIST_ITEM.test(line);
+    const next = lines[i + 1] ?? '';
+    // Introduces a list: "...:" or a title line. A list item only counts if the list below it is a
+    // different kind ("4. Next Steps" followed by "- ..." bullets), so sibling items aren't merged.
+    const introducesList =
+      LIST_ITEM.test(next) &&
+      (isItem ? headingLike && isNumbered(line) !== isNumbered(next) : cleaned.endsWith(':') || headingLike);
+    if (introducesList) {
+      const items: string[] = [];
+      while (LIST_ITEM.test(lines[i + 1] ?? '')) items.push(cleanInline(lines[++i]).replace(/[.;]$/, ''));
+      const intro = cleaned.endsWith(':') ? cleaned : `${cleaned}:`;
+      if (headingLike) context = intro.slice(0, -1);
+      push(`${intro} ${items.join('; ')}`);
+      continue;
+    }
+    // A numbered line is a heading ("1. Chunking Strategy") only when body text follows directly beneath it.
+    const numberedHeading = isNumbered(line) && !!next && !LIST_ITEM.test(next);
+    if (headingLike && (!isItem || numberedHeading)) {
+      context = cleaned.replace(/:$/, '');
+      continue;
+    }
+
+    for (const sentence of cleaned.split(/(?<=[.!?])\s+(?=["'(\p{Lu}\p{N}])/u)) push(sentence.trim());
+  }
+  return out;
+}
+
+export function splitSentences(text: string): string[] {
+  return splitUnits(text).map(u => u.text);
+}
+
+function ensurePeriod(s: string): string {
+  return /[.!?:]$/.test(s) ? s : `${s}.`;
+}
+
+function round2(n: number): number {
+  return Math.round(n * 100) / 100;
+}

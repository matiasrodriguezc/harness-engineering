new file mode 100644
index 0000000..108501e
--- /dev/null
+++ b/src/renderer/components/DocumentViewer.tsx
@@ -0,0 +1,150 @@
+import { useEffect, useRef, useState } from 'react';
+import type { Chunk, Document } from '@shared/types';
+import type { Highlight } from '../App';
+import { formatSize, STATUS_LABEL } from './DocumentList';
+
+interface Props {
+  document: Document | null;
+  highlight: Highlight | null;
+  hasDocuments: boolean;
+  onDelete: (doc: Document) => void;
+  onReindex: (doc: Document) => void;
+}
+
+export function DocumentViewer({ document, highlight, hasDocuments, onDelete, onReindex }: Props) {
+  const [content, setContent] = useState<string | null>(null);
+  const [chunks, setChunks] = useState<Chunk[]>([]);
+  const [loadError, setLoadError] = useState<string | null>(null);
+  const [showPassages, setShowPassages] = useState(false);
+  const [confirmDelete, setConfirmDelete] = useState(false);
+  const bodyRef = useRef<HTMLDivElement>(null);
+
+  const docId = document?.id;
+  const docStatus = document?.status;
+
+  useEffect(() => {
+    setConfirmDelete(false);
+    if (!docId) return;
+    let cancelled = false;
+    setLoadError(null);
+    Promise.all([window.knowledgeBase.documents.content(docId), window.knowledgeBase.indexing.chunks(docId)])
+      .then(([text, ch]) => {
+        if (cancelled) return;
+        setContent(text);
+        setChunks(ch);
+        bodyRef.current?.scrollTo({ top: 0 });
+      })
+      .catch(err => !cancelled && setLoadError(String(err)));
+    return () => {
+      cancelled = true;
+    };
+  }, [docId, docStatus]);
+
+  // Scroll the cited passage into view once it's rendered.
+  useEffect(() => {
+    if (!highlight || chunks.length === 0) return;
+    const el = bodyRef.current?.querySelector(`[data-chunk="${highlight.chunkIndex}"]`);
+    el?.scrollIntoView({ behavior: 'smooth', block: 'center' });
+  }, [highlight, chunks]);
+
+  if (!document) {
+    return (
+      <main className="viewer">
+        <div className="placeholder">
+          <h2>{hasDocuments ? 'Select a document' : 'Welcome'}</h2>
+          <p>
+            {hasDocuments
+              ? 'Pick a document on the left to read it, or ask a question on the right.'
+              : 'Import some documents to read them here and ask questions about them.'}
+          </p>
+        </div>
+      </main>
+    );
+  }
+
+  const isMarkdown = !document.filename.toLowerCase().endsWith('.txt');
+
+  return (
+    <main className="viewer">
+      <header className="viewer-header">
+        <h2>{document.title}</h2>
+        <div className="meta">
+          <span>{document.filename}</span>
+          <span>{formatSize(document.size)}</span>
+          <span>Imported {new Date(document.importedAt).toLocaleString()}</span>
+          <span>
+            <span className={`dot ${document.status}`} style={{ display: 'inline-block', marginRight: 5 }} />
+            {STATUS_LABEL[document.status]}
+            {document.status === 'indexed' && document.chunks !== undefined && ` · ${document.chunks} passages`}
+          </span>
+          <span style={{ flex: 1 }} />
+          {chunks.length > 0 && (
+            <button className="btn small" onClick={() => setShowPassages(s => !s)}>
+              {showPassages ? 'Hide' : 'Show'} passages
+            </button>
+          )}
+          <button className="btn small" onClick={() => onReindex(document)}>
+            {document.status === 'indexed' ? 'Re-index' : 'Index'}
+          </button>
+          {confirmDelete ? (
+            <>
+              <button className="btn small danger" onClick={() => onDelete(document)}>
+                Confirm delete
+              </button>
+              <button className="btn small" onClick={() => setConfirmDelete(false)}>
+                Cancel
+              </button>
+            </>
+          ) : (
+            <button className="btn small danger" onClick={() => setConfirmDelete(true)}>
+              Delete
+            </button>
+          )}
+        </div>
+        {document.error && <div className="error-text" style={{ fontSize: 12, marginTop: 4 }}>{document.error}</div>}
+      </header>
+
+      <div className="viewer-body" ref={bodyRef}>
+        <article className={`doc-text${showPassages ? ' show-passages' : ''}`}>
+          {loadError ? (
+            <p className="error-text">Couldn't load this document: {loadError}</p>
+          ) : chunks.length > 0 ? (
+            chunks.map(chunk => (
+              <div
+                key={chunk.id}
+                data-chunk={chunk.index}
+                className={`passage${highlight?.chunkIndex === chunk.index ? ' highlight' : ''}`}
+              >
+                <div className="label">Passage {chunk.index + 1}</div>
+                <PassageText text={chunk.content} markdown={isMarkdown} />
+              </div>
+            ))
+          ) : (
+            <div className="passage">
+              <PassageText text={content ?? ''} markdown={isMarkdown} />
+            </div>
+          )}
+        </article>
+      </div>
+    </main>
+  );
+}
+
+/** Plain text, except Markdown heading lines are shown as headings (without the "#" markers). */
+function PassageText({ text, markdown }: { text: string; markdown: boolean }) {
+  if (!markdown) return <>{text}</>;
+  return (
+    <>
+      {text.split('\n').map((line, i, lines) => {
+        const m = line.match(/^(#{1,6})\s+(.*)$/);
+        const nl = i < lines.length - 1 ? '\n' : '';
+        if (!m) return <span key={i}>{line + nl}</span>;
+        return (
+          <span key={i} className={`md-h md-h${Math.min(m[1].length, 3)}`}>
+            {m[2]}
+          </span>
+        );
+      })}
+    </>
+  );
+}

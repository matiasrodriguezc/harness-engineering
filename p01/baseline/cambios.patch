diff --git a/src/renderer/components/QaPanel.tsx b/src/renderer/components/QaPanel.tsx
new file mode 100644
index 0000000..1bf5b1f
--- /dev/null
+++ b/src/renderer/components/QaPanel.tsx
@@ -0,0 +1,152 @@
+import { Fragment, useEffect, useRef, useState } from 'react';
+import type { Citation, QAHistory, QAResponse } from '@shared/types';
+
+interface Props {
+  history: QAHistory[];
+  pendingQuestion: string | null;
+  canAsk: boolean;
+  onAsk: (question: string) => void;
+  onClear: () => void;
+  onOpenCitation: (citation: Citation) => void;
+}
+
+const SUGGESTIONS = [
+  'What are the layers of the architecture?',
+  'How are documents split into chunks?',
+  'What did the team decide about the vector database?',
+];
+
+export function QaPanel({ history, pendingQuestion, canAsk, onAsk, onClear, onOpenCitation }: Props) {
+  const [question, setQuestion] = useState('');
+  const threadRef = useRef<HTMLDivElement>(null);
+  const busy = pendingQuestion !== null;
+
+  useEffect(() => {
+    threadRef.current?.scrollTo({ top: threadRef.current.scrollHeight, behavior: 'smooth' });
+  }, [history.length, pendingQuestion]);
+
+  const submit = (text: string) => {
+    const q = text.trim();
+    if (!q || busy) return;
+    onAsk(q);
+    setQuestion('');
+  };
+
+  return (
+    <section className="qa">
+      <div className="qa-header">
+        <h2>Ask your documents</h2>
+        {history.length > 0 && (
+          <button className="btn small" onClick={onClear} disabled={busy}>
+            Clear
+          </button>
+        )}
+      </div>
+
+      <div className="qa-thread" ref={threadRef}>
+        {history.length === 0 && !busy && (
+          <div className="empty" style={{ padding: '12px 4px' }}>
+            {canAsk ? (
+              <>
+                <p>Ask anything about your indexed documents. Answers cite the passages they come from.</p>
+                <div className="suggestions">
+                  {SUGGESTIONS.map(s => (
+                    <button key={s} className="btn" onClick={() => submit(s)}>
+                      {s}
+                    </button>
+                  ))}
+                </div>
+              </>
+            ) : (
+              <p>Import and index a document to start asking questions.</p>
+            )}
+          </div>
+        )}
+
+        {history.map((entry, i) => (
+          <Fragment key={`${entry.response.timestamp}-${i}`}>
+            <div className="question">{entry.question}</div>
+            <Answer response={entry.response} onOpenCitation={onOpenCitation} />
+          </Fragment>
+        ))}
+
+        {pendingQuestion && (
+          <>
+            <div className="question">{pendingQuestion}</div>
+            <div className="answer thinking">Searching your documents…</div>
+          </>
+        )}
+      </div>
+
+      <form
+        className="qa-form"
+        onSubmit={e => {
+          e.preventDefault();
+          submit(question);
+        }}
+      >
+        <textarea
+          value={question}
+          rows={2}
+          maxLength={2000}
+          placeholder={canAsk ? 'Ask a question… (Enter to send)' : 'No indexed documents yet'}
+          onChange={e => setQuestion(e.target.value)}
+          onKeyDown={e => {
+            if (e.key === 'Enter' && !e.shiftKey && !e.nativeEvent.isComposing) {
+              e.preventDefault();
+              submit(question);
+            }
+          }}
+        />
+        <button type="submit" className="btn primary" disabled={busy || !question.trim()}>
+          Ask
+        </button>
+      </form>
+    </section>
+  );
+}
+
+function Answer({ response, onOpenCitation }: { response: QAResponse; onOpenCitation: (c: Citation) => void }) {
+  const byMarker = new Map(response.citations.map(c => [c.marker, c]));
+  // Turn "[n]" markers into clickable chips that jump to the cited passage.
+  const parts = response.answer.split(/(\[\d+\])/g).map((part, i) => {
+    const m = part.match(/^\[(\d+)\]$/);
+    const citation = m ? byMarker.get(Number(m[1])) : undefined;
+    if (!citation) return <Fragment key={i}>{part}</Fragment>;
+    return (
+      <button
+        key={i}
+        className="marker"
+        title={`${citation.documentTitle}, passage ${citation.chunkIndex + 1}`}
+        onClick={() => onOpenCitation(citation)}
+      >
+        {citation.marker}
+      </button>
+    );
+  });
+
+  const level = response.confidence >= 0.7 ? 'high' : response.confidence >= 0.45 ? 'mid' : 'low';
+  const label = response.citations.length === 0 ? 'no sources' : `${level} confidence`;
+
+  return (
+    <div className="answer">
+      <div className="text">{parts}</div>
+      {response.citations.length > 0 && (
+        <div className="sources">
+          {response.citations.map(c => (
+            <button key={c.marker} className="source" onClick={() => onOpenCitation(c)}>
+              <div className="src-title">
+                [{c.marker}] {c.documentTitle} · passage {c.chunkIndex + 1}
+              </div>
+              <div className="src-excerpt">{c.excerpt}</div>
+            </button>
+          ))}
+        </div>
+      )}
+      <div className="answer-meta">
+        <span className={`badge ${response.citations.length === 0 ? 'low' : level}`}>{label}</span>
+        <span>{response.engine === 'llm' ? 'Written by Claude from sources' : 'Extracted from sources'}</span>
+      </div>
+    </div>
+  );
+}

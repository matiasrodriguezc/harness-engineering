+    expect(res.engine).toBe('extractive');
+    expect(res.answer).toMatch(/local chunk storage instead of a vector database/);
+    expect(res.citations[0].documentTitle).toBe('meeting-summary');
+    // Every marker in the answer resolves to a citation.
+    for (const m of res.answer.matchAll(/\[(\d+)\]/g)) {
+      expect(res.citations.some(c => c.marker === Number(m[1]))).toBe(true);
+    }
+    expect(res.confidence).toBeGreaterThan(0.5);
+  });
+
+  it('finds the right document for different questions', async () => {
+    importAndIndexSamples();
+    const preload = await qa.ask('What does the preload script do?');
+    expect(preload.citations[0].documentTitle).toBe('Software Design Notes');
+    expect(preload.answer).toMatch(/bridge/);
+
+    const confidence = await qa.ask('How is the confidence score calculated?');
+    expect(confidence.citations[0].documentTitle).toBe('Retrieval Plan');
+    expect(confidence.answer).toMatch(/0\.85|0\.30/);
+  });
+
+  it('does not invent an answer for unrelated questions', async () => {
+    importAndIndexSamples();
+    const res = await qa.ask('What is the capital of Mongolia?');
+    expect(res.answer).toBe(NOT_FOUND_ANSWER);

+describe('retrieval', () => {
+  it('stems common suffixes consistently', () => {
+    expect(stem('chunks')).toBe('chunk');
+    expect(stem('chunking')).toBe('chunk');
+    expect(stem('indexes')).toBe('index');
+    expect(stem('class')).toBe('class');
+  });
+
+  it('drops stop words', () => {
+    expect(tokenize('What is the chunk size?')).toEqual(['chunk', 'size']);
+  });
+
+  it('ranks rare-term matches above common-term matches', () => {
+    const mk = (id: string, content: string) => ({ id, documentId: id, content, index: 0, metadata: {} });
+    const index = new Bm25Index([
+      mk('1', 'document document document'),
+      mk('2', 'document about electron preload bridge'),
+      mk('3', 'document again'),
+    ]);
+    expect(index.search('electron document')[0].chunk.id).toBe('2');
+  });
+});

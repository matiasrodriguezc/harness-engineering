diff --git a/src/renderer/styles.css b/src/renderer/styles.css
new file mode 100644
index 0000000..cbfad0e
--- /dev/null
+++ b/src/renderer/styles.css
@@ -0,0 +1,163 @@
+:root {
+  --bg: #f6f7f9;
+  --panel: #ffffff;
+  --panel-2: #f0f2f5;
+  --border: #dde1e7;
+  --fg: #1d2330;
+  --muted: #667085;
+  --accent: #4f5bd5;
+  --accent-fg: #ffffff;
+  --accent-soft: #e8eafc;
+  --highlight: #fff3c4;
+  --ok: #2e9e5b;
+  --warn: #c98a12;
+  --err: #d0453a;
+  color-scheme: light;
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #14161c;
+    --panel: #1b1e26;
+    --panel-2: #232731;
+    --border: #2e3340;
+    --fg: #e4e7ee;
+    --muted: #8b93a7;
+    --accent: #7b86f2;
+    --accent-fg: #0e1020;
+    --accent-soft: #2a2f52;
+    --highlight: #4a3f14;
+    --ok: #4cc27c;
+    --warn: #e0a83a;
+    --err: #ef6a5f;
+    color-scheme: dark;
+  }
+}
+
+*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
+html, body, #root { height: 100%; }
+body {
+  font: 14px/1.5 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
+  background: var(--bg);
+  color: var(--fg);
+  overflow: hidden;
+}
+button { font: inherit; color: inherit; cursor: pointer; }
+button:disabled { cursor: default; opacity: 0.55; }
+:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
+
+.app { display: flex; flex-direction: column; height: 100%; }
+.columns { display: flex; flex: 1; min-height: 0; }
+
+.btn {
+  border: 1px solid var(--border); background: var(--panel); border-radius: 6px;
+  padding: 5px 11px; font-size: 13px;
+}
+.btn:hover:not(:disabled) { background: var(--panel-2); }
+.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-fg); font-weight: 500; }
+.btn.primary:hover:not(:disabled) { filter: brightness(1.08); background: var(--accent); }
+.btn.small { padding: 2px 8px; font-size: 12px; }
+.btn.danger { color: var(--err); }
+.btn.link { border: none; background: none; color: var(--accent); padding: 0; }
+
+/* Sidebar */
+.sidebar {
+  width: 270px; flex-shrink: 0; display: flex; flex-direction: column;
+  background: var(--panel); border-right: 1px solid var(--border); position: relative;
+}
+.sidebar-header {
+  padding: 14px 14px 10px; display: flex; align-items: center; justify-content: space-between;
+  border-bottom: 1px solid var(--border);
+}
+.sidebar-header h1 { font-size: 15px; font-weight: 600; }
+.doc-list { flex: 1; overflow-y: auto; padding: 6px; list-style: none; }
+.doc-item {
+  display: flex; align-items: center; gap: 8px; width: 100%; text-align: left;
+  border: none; background: none; border-radius: 6px; padding: 8px 10px;
+}
+.doc-item:hover { background: var(--panel-2); }
+.doc-item.selected { background: var(--accent-soft); }
+.doc-item .info { flex: 1; min-width: 0; }
+.doc-item .title { font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.doc-item .meta { font-size: 12px; color: var(--muted); }
+.dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; background: var(--muted); }
+.dot.indexed, .dot.ready { background: var(--ok); }
+.dot.indexing { background: var(--warn); }
+.dot.error { background: var(--err); }
+.empty { padding: 28px 18px; color: var(--muted); text-align: center; font-size: 13px; }
+.empty p + p { margin-top: 10px; }
+.drop-overlay {
+  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
+  background: color-mix(in srgb, var(--accent) 14%, transparent); border: 2px dashed var(--accent);
+  font-weight: 600; color: var(--accent); pointer-events: none; z-index: 5;
+}
+
+/* Viewer */
+.viewer { flex: 1; min-width: 0; display: flex; flex-direction: column; background: var(--bg); }
+.viewer-header { padding: 14px 24px 12px; border-bottom: 1px solid var(--border); background: var(--panel); }
+.viewer-header h2 { font-size: 18px; font-weight: 600; }
+.viewer-header .meta { font-size: 12px; color: var(--muted); margin-top: 2px; display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }
+.viewer-body { flex: 1; overflow-y: auto; padding: 22px 28px 40px; }
+.doc-text { max-width: 760px; margin: 0 auto; }
+.passage {
+  white-space: pre-wrap; overflow-wrap: anywhere; padding: 6px 10px; margin: 0 -10px 10px;
+  border-left: 3px solid transparent; border-radius: 4px; transition: background 0.3s;
+}
+.show-passages .passage { border-left-color: var(--border); }
+.passage .label { display: none; font-size: 11px; color: var(--muted); margin-bottom: 2px; }
+.show-passages .passage .label { display: block; }
+.passage.highlight { background: var(--highlight); border-left-color: var(--warn); }
+.placeholder { color: var(--muted); text-align: center; margin-top: 18vh; }
+.placeholder h2 { color: var(--fg); font-size: 18px; margin-bottom: 6px; }
+.error-text { color: var(--err); }
+
+/* Q&A */
+.qa { width: 400px; flex-shrink: 0; display: flex; flex-direction: column; background: var(--panel); border-left: 1px solid var(--border); }
+.qa-header { padding: 14px 16px 10px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); }
+.qa-header h2 { font-size: 15px; font-weight: 600; }
+.qa-thread { flex: 1; overflow-y: auto; padding: 14px 16px; display: flex; flex-direction: column; gap: 14px; }
+.question { align-self: flex-end; background: var(--accent); color: var(--accent-fg); padding: 7px 12px; border-radius: 12px 12px 2px 12px; max-width: 90%; overflow-wrap: anywhere; }
+.answer { background: var(--panel-2); padding: 10px 12px; border-radius: 12px 12px 12px 2px; overflow-wrap: anywhere; }
+.answer .text { white-space: pre-wrap; }
+.marker {
+  border: none; background: var(--accent-soft); color: var(--accent); border-radius: 4px;
+  font-size: 11px; font-weight: 600; padding: 0 4px; margin: 0 1px; vertical-align: 1px;
+}
+.answer-meta { display: flex; gap: 8px; align-items: center; margin-top: 8px; font-size: 11px; color: var(--muted); }
+.badge { border-radius: 10px; padding: 0 7px; font-weight: 600; border: 1px solid currentColor; }
+.badge.high { color: var(--ok); }
+.badge.mid { color: var(--warn); }
+.badge.low { color: var(--err); }
+.sources { margin-top: 8px; display: flex; flex-direction: column; gap: 6px; }
+.source {
+  text-align: left; border: 1px solid var(--border); background: var(--panel); border-radius: 6px;
+  padding: 6px 8px; font-size: 12px;
+}
+.source:hover { border-color: var(--accent); }
+.source .src-title { font-weight: 600; }
+.source .src-excerpt { color: var(--muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
+.thinking { color: var(--muted); font-style: italic; }
+.qa-form { border-top: 1px solid var(--border); padding: 10px 12px; display: flex; gap: 8px; align-items: flex-end; }
+.qa-form textarea {
+  flex: 1; resize: none; font: inherit; color: var(--fg); background: var(--bg);
+  border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; min-height: 40px; max-height: 140px;
+}
+.suggestions { display: flex; flex-direction: column; gap: 6px; margin-top: 10px; }
+.suggestions .btn { text-align: left; }
+
+/* Status + toasts */
+.statusbar {
+  display: flex; gap: 18px; align-items: center; padding: 3px 14px; font-size: 11px; color: var(--muted);
+  border-top: 1px solid var(--border); background: var(--panel);
+}
+.statusbar .dot { display: inline-block; margin-right: 6px; vertical-align: middle; }
+.toasts { position: fixed; bottom: 34px; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; gap: 6px; z-index: 20; }
+.toast {
+  background: var(--fg); color: var(--bg); padding: 8px 14px; border-radius: 8px; font-size: 13px;
+  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25); display: flex; gap: 12px; align-items: center; max-width: 520px;
+}
+.toast.error { background: var(--err); color: #fff; }
+.toast button { border: none; background: none; color: inherit; opacity: 0.8; }
+.md-h { display: block; font-weight: 650; margin: 2px 0; }
+.md-h1 { font-size: 22px; }
+.md-h2 { font-size: 17px; }
+.md-h3 { font-size: 15px; }

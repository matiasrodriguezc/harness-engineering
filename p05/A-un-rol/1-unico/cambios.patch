+/*
+ * End-to-end smoke test for multi-turn conversation history.
+ *
+ * Runs the real built app (dist/) inside Electron against a throwaway data
+ * directory, drives the UI with real keyboard input, asserts on the DOM and
+ * writes screenshots to docs/evidence/.
+ *
+ * Usage:  npm run build && npx electron scripts/smoke-conversation.js
+ * Phase 2 (restart persistence) runs automatically by relaunching itself.
+ */
+const { app, BrowserWindow, ipcMain, clipboard } = require('electron');
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const { spawnSync } = require('child_process');
+
+const root = path.resolve(__dirname, '..');
+const evidenceDir = path.join(root, 'docs', 'evidence');
+const phase = process.env.SMOKE_PHASE || '1';
+const userData = process.env.SMOKE_USER_DATA || fs.mkdtempSync(path.join(os.tmpdir(), 'kb-smoke-'));
+app.setPath('userData', userData);
+
+const results = [];
+function check(name, ok, detail = '') {
+  results.push({ name, ok });
+  console.log(`${ok ? 'PASS' : 'FAIL'}  ${name}${detail ? `  (${detail})` : ''}`);
+}
+
+const sleep = ms => new Promise(r => setTimeout(r, ms));
+
+async function waitFor(wc, expr, timeout = 8000) {
+  const start = Date.now();
+  while (Date.now() - start < timeout) {
+    if (await wc.executeJavaScript(`Boolean(${expr})`)) return true;
+    await sleep(100);
+  }
+  return false;
+}
+
+async function shot(win, name) {
+  fs.mkdirSync(evidenceDir, { recursive: true });
+  const img = await win.webContents.capturePage();
+  fs.writeFileSync(path.join(evidenceDir, name), img.toPNG());
+}
+
+async function typeAndEnter(wc, text) {
+  await wc.executeJavaScript(`document.getElementById('question-input').focus()`);
+  wc.insertText(text);
+  await sleep(50);
+  wc.sendInputEvent({ type: 'keyDown', keyCode: 'Enter' });
+  wc.sendInputEvent({ type: 'char', keyCode: '\r' });
+  wc.sendInputEvent({ type: 'keyUp', keyCode: 'Enter' });
+}
+
+const js = {
+  userCount: `document.querySelectorAll('ol[aria-label="Questions and answers"] > li[aria-label^="You asked"]').length`,
+  answerCount: `document.querySelectorAll('ol[aria-label="Questions and answers"] > li[aria-label^="Assistant answered"]').length`,
+};
+
+async function phase1(win) {
+  const wc = win.webContents;
+  check('empty state shown', await waitFor(wc, `document.body.innerText.includes('No questions yet')`));
+  await shot(win, '01-empty.png');
+
+  // Import + index sample documents through the real preload bridge.
+  const samples = path.join(root, 'data', 'sample-documents');
+  for (const f of fs.readdirSync(samples)) {
+    await wc.executeJavaScript(`window.knowledgeBase.documents.import(${JSON.stringify(path.join(samples, f))})`);
+  }
+  await wc.executeJavaScript(`window.knowledgeBase.indexing.start()`);
+  await wc.executeJavaScript(`[...document.querySelectorAll('button')].find(b => b.textContent === 'Refresh').click()`);
+
+  const questions = ['How does retrieval work?', 'What about that?', 'What was decided in the meeting?'];
+  for (let i = 0; i < questions.length; i++) {
+    await typeAndEnter(wc, questions[i]);
+    await waitFor(wc, `${js.answerCount} === ${i + 1}`);
+  }
+  check('3 questions and 3 answers rendered', (await wc.executeJavaScript(js.userCount)) === 3 && (await wc.executeJavaScript(js.answerCount)) === 3);
+
+  const texts = await wc.executeJavaScript(
+    `[...document.querySelectorAll('ol[aria-label="Questions and answers"] article p')].map(p => p.textContent)`,
+  );
+  check('questions shown verbatim and in order', questions.every((q, i) => texts.indexOf(q) > -1 && (i === 0 || texts.indexOf(q) > texts.indexOf(questions[i - 1]))));
+  check('timestamps rendered on every message', (await wc.executeJavaScript(`document.querySelectorAll('ol[aria-label="Questions and answers"] time').length`)) === 6);
+  check('timestamp text is human readable', /^Today, /.test(await wc.executeJavaScript(`document.querySelector('ol[aria-label="Questions and answers"] time').textContent`)));
+  check('follow-up flagged as using previous question', await wc.executeJavaScript(`document.body.innerText.includes('Interpreted as a follow-up')`));
+  const citationCount = await wc.executeJavaScript(`document.querySelectorAll('ol[aria-label="Questions and answers"] details').length`);
+  check('citations rendered', citationCount >= 3, `${citationCount} citations`);
+  check('input cleared after send', (await wc.executeJavaScript(`document.getElementById('question-input').value`)) === '');
+  await shot(win, '02-conversation.png');
+
+  // Expand first citation and open its document.
+  await wc.executeJavaScript(`document.querySelector('ol[aria-label="Questions and answers"] details summary').click()`);
+  check('citation expands to show excerpt', await wc.executeJavaScript(`!!document.querySelector('details[open] blockquote')`));
+  await wc.executeJavaScript(`[...document.querySelectorAll('details[open] button')].find(b => b.textContent === 'Open document').click()`);
+  check('Open document shows the cited document', await waitFor(wc, `document.querySelector('section[aria-label="Selected document"] h2')`));
+  await shot(win, '03-citation-open.png');
+  await wc.executeJavaScript(`document.querySelector('button[aria-label="Close document"]').click()`);
+
+  // Sidebar outline jumps to a turn.
+  await wc.executeJavaScript(`[...document.querySelectorAll('button')].find(b => b.textContent.startsWith('History')).click()`);
+  const outline = await wc.executeJavaScript(`document.querySelectorAll('nav[aria-label="Conversation history"] button').length`);
+  check('History tab lists all questions', outline === 3);
+  await wc.executeJavaScript(`document.querySelector('nav[aria-label="Conversation history"] button').click()`);
+  check('selecting a history item focuses that turn', await waitFor(wc, `document.activeElement && document.activeElement.getAttribute('aria-label')?.startsWith('You asked')`));
+
+  // Long answer is not truncated.
+  const longQ = 'architecture '.repeat(120).trim();
+  await typeAndEnter(wc, longQ);
+  await waitFor(wc, `${js.answerCount} === 4`);
+  await wc.executeJavaScript(`[...document.querySelectorAll('button')].find(b => b.textContent === 'Copy').click()`);
+  check('Copy gives feedback', await waitFor(wc, `[...document.querySelectorAll('button[aria-label="Copy answer"]')].some(b => /Copied|Copy failed/.test(b.textContent))`));
+  const copied = await wc.executeJavaScript(`[...document.querySelectorAll('button[aria-label="Copy answer"]')].some(b => b.textContent.startsWith('Copied'))`);
+  const firstAnswer = await wc.executeJavaScript(`document.querySelector('li[aria-label^="Assistant answered"] article > p').textContent`);
+  check('Copy succeeded and clipboard holds the answer', copied && clipboard.readText() === firstAnswer);
+  await wc.executeJavaScript(`[...document.querySelectorAll('button')].find(b => b.textContent === 'Edit & ask again').click()`);
+  check('Edit & ask again refills and focuses input', await wc.executeJavaScript(`document.getElementById('question-input').value === ${JSON.stringify(questions[0])} && document.activeElement.id === 'question-input'`));
+  await wc.executeJavaScript(`(() => { const t = document.getElementById('question-input'); const set = Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype, 'value').set; set.call(t, ''); t.dispatchEvent(new Event('input', { bubbles: true })); })()`);
+  check('long question rendered untruncated', await wc.executeJavaScript(`[...document.querySelectorAll('article p')].some(p => p.textContent === ${JSON.stringify(longQ)})`));
+
+  // Error path: swap the qa:ask handler for one that fails.
+  ipcMain.removeHandler('qa:ask');
+  ipcMain.handle('qa:ask', async () => { throw new Error('Simulated backend failure'); });
+  await typeAndEnter(wc, 'This one will fail');
+  check('error shown inline with retry', await waitFor(wc, `[...document.querySelectorAll('[role=alert]')].some(a => a.textContent.includes('Simulated backend failure')) && [...document.querySelectorAll('button')].some(b => b.textContent === 'Retry')`));
+  check('IPC error prefix stripped', !(await wc.executeJavaScript(`document.body.innerText.includes('Error invoking remote method')`)));
+  check('failed question not persisted', (await wc.executeJavaScript(js.answerCount)) === 4);
+  await wc.executeJavaScript(`[...document.querySelectorAll('button')].find(b => b.textContent === 'Retry').click()`);
+  check('Retry re-sends and shows the error again', await waitFor(wc, `[...document.querySelectorAll('[role=alert]')].some(a => a.textContent.includes('Simulated backend failure'))`) && (await wc.executeJavaScript(`document.querySelectorAll('[role=alert]').length`)) === 1);
+  await shot(win, '04-error.png');
+}
+
+async function phase2(win) {
+  const wc = win.webContents;
+  check('history persisted across restart (4 exchanges)', await waitFor(wc, `${js.answerCount} === 4`));
+  // Clear history with inline confirmation.
+  await wc.executeJavaScript(`[...document.querySelectorAll('button')].find(b => b.textContent === 'Clear history').click()`);
+  check('clear asks for confirmation', await waitFor(wc, `document.querySelector('[aria-label="Confirm clearing history"]')`));
+  await wc.executeJavaScript(`[...document.querySelectorAll('button')].find(b => b.textContent === 'Delete').click()`);
+  check('history cleared', await waitFor(wc, `document.body.innerText.includes('No questions yet')`));
+}
+
+app.whenReady().then(async () => {
+  // Load the real app; its whenReady handler creates the window.
+  require(path.join(root, 'dist', 'main', 'main.js'));
+  let win;
+  for (let i = 0; i < 50 && !win; i++) {
+    await sleep(100);
+    win = BrowserWindow.getAllWindows()[0];
+  }
+  if (!win) {
+    console.error('FAIL  window never opened');
+    app.exit(1);
+    return;
+  }
+  if (win.webContents.isLoading()) await new Promise(r => win.webContents.once('did-finish-load', r));
+  await sleep(300);
+
+  try {
+    if (phase === '1') await phase1(win);
+    else await phase2(win);
+  } catch (err) {
+    check('smoke script ran without exceptions', false, String(err));
+  }
+
+  let failed = results.filter(r => !r.ok).length;
+  if (phase === '1') {
+    const child = spawnSync(process.execPath, [__filename], {
+      env: { ...process.env, SMOKE_PHASE: '2', SMOKE_USER_DATA: userData },
+      stdio: ['ignore', 'pipe', 'inherit'],
+      encoding: 'utf-8',
+    });
+    process.stdout.write(child.stdout.split('\n').filter(l => /^(PASS|FAIL)/.test(l)).join('\n') + '\n');
+    if (child.status !== 0) failed++;
+    fs.rmSync(userData, { recursive: true, force: true });
+    console.log(failed === 0 ? 'SMOKE: ALL CHECKS PASSED' : `SMOKE: ${failed} FAILURE(S)`);
+  }
+  app.exit(failed === 0 ? 0 : 1);
+});

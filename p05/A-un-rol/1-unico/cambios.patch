diff --git a/src/renderer/components/CitationList.tsx b/src/renderer/components/CitationList.tsx
new file mode 100644
index 0000000..e5aff26
--- /dev/null
+++ b/src/renderer/components/CitationList.tsx
@@ -0,0 +1,76 @@
+import { Citation } from '../../shared/types';
+
+interface Props {
+  citations: Citation[];
+  /** Returns false when the cited document no longer exists. */
+  isDocumentAvailable: (documentId: string) => boolean;
+  onOpenDocument: (documentId: string) => void;
+}
+
+const PREVIEW_LENGTH = 90;
+
+/** Sources for one answer. Each citation expands (native <details>) to show the full excerpt. */
+export function CitationList({ citations, isDocumentAvailable, onOpenDocument }: Props) {
+  if (citations.length === 0) {
+    return (
+      <p style={{ marginTop: '10px', fontSize: '12px', color: '#a8a8c8', fontStyle: 'italic' }}>
+        No sources cited — this answer is not grounded in your documents.
+      </p>
+    );
+  }
+
+  return (
+    <div style={{ marginTop: '10px' }}>
+      <h4 style={{ fontSize: '11px', fontWeight: 600, color: '#a8a8c8', textTransform: 'uppercase', letterSpacing: '0.04em' }}>
+        Sources ({citations.length})
+      </h4>
+      <ol style={{ listStyle: 'none', marginTop: '4px' }}>
+        {citations.map((c, i) => {
+          const available = isDocumentAvailable(c.documentId);
+          const preview = c.excerpt.length > PREVIEW_LENGTH ? `${c.excerpt.slice(0, PREVIEW_LENGTH).trimEnd()}…` : c.excerpt;
+          return (
+            <li key={`${c.documentId}-${c.chunkIndex}-${i}`} style={{ marginTop: '4px' }}>
+              <details style={{ borderLeft: '2px solid #533483', paddingLeft: '8px', fontSize: '12px', color: '#c0c0dd' }}>
+                <summary style={{ cursor: 'pointer', lineHeight: 1.5 }}>
+                  <span style={{ fontWeight: 600, color: '#e0e0e0' }}>[{i + 1}] {c.documentTitle}</span>
+                  <span style={{ color: '#a8a8c8' }}> · chunk {c.chunkIndex}</span>
+                  <span style={{ display: 'block', color: '#a8a8c8' }}>{preview}</span>
+                </summary>
+                <blockquote
+                  style={{
+                    margin: '6px 0',
+                    padding: '8px 10px',
+                    background: '#14142e',
+                    borderRadius: '4px',
+                    whiteSpace: 'pre-wrap',
+                    overflowWrap: 'anywhere',
+                    lineHeight: 1.5,
+                  }}
+                >
+                  {c.excerpt}
+                </blockquote>
+                <button
+                  type="button"
+                  onClick={() => onOpenDocument(c.documentId)}
+                  disabled={!available}
+                  style={{
+                    padding: '3px 10px',
+                    background: available ? '#0f3460' : 'transparent',
+                    color: available ? '#e0e0e0' : '#a8a8c8',
+                    border: '1px solid #1a1a4e',
+                    borderRadius: '3px',
+                    cursor: available ? 'pointer' : 'not-allowed',
+                    fontSize: '11px',
+                    marginBottom: '4px',
+                  }}
+                >
+                  {available ? 'Open document' : 'Document no longer available'}
+                </button>
+              </details>
+            </li>
+          );
+        })}
+      </ol>
+    </div>
+  );
+}

--- /dev/null
+++ b/tests/format.test.ts
@@ -0,0 +1,23 @@
+import { describe, expect, it } from 'vitest';
+import { describeError, formatTimestamp } from '../src/renderer/utils/format';
+
+describe('formatTimestamp', () => {
+  const now = new Date(2026, 10, 15, 18, 0);
+  it('labels today, yesterday, this year and older dates', () => {
+    expect(formatTimestamp(new Date(2026, 10, 15, 9, 5).toISOString(), now)).toMatch(/^Today, /);
+    expect(formatTimestamp(new Date(2026, 10, 14, 9, 5).toISOString(), now)).toMatch(/^Yesterday, /);
+    expect(formatTimestamp(new Date(2026, 2, 3, 9, 5).toISOString(), now)).not.toMatch(/2026/);
+    expect(formatTimestamp(new Date(2024, 2, 3, 9, 5).toISOString(), now)).toMatch(/2024/);
+  });
+  it('handles invalid input', () => {
+    expect(formatTimestamp('nope', now)).toBe('Unknown time');
+  });
+});
+
+describe('describeError', () => {
+  it('strips the Electron IPC prefix', () => {
+    expect(describeError(new Error("Error invoking remote method 'qa:ask': Error: Question must not be empty"))).toBe(
+      'Question must not be empty',
+    );
+  });
+});

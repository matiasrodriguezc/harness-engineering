+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { PersistenceService } from '../src/services/persistence-service';
+import { DocumentService } from '../src/services/document-service';
+import { IndexingService } from '../src/services/indexing-service';
+import { QaService } from '../src/services/qa-service';
+
+const SAMPLES = path.resolve(__dirname, '../data/sample-documents');
+
+describe('QaService conversation history', () => {
+  let dir: string;
+  let persistence: PersistenceService;
+  let qa: QaService;
+
+  beforeEach(() => {
+    dir = fs.mkdtempSync(path.join(os.tmpdir(), 'kb-test-'));
+    persistence = new PersistenceService(dir);
+    qa = new QaService(persistence, new IndexingService(persistence));
+  });
+
+  afterEach(() => fs.rmSync(dir, { recursive: true, force: true }));
+
+  it('returns an empty conversation when there is no history', () => {
+    expect(qa.getConversation()).toEqual([]);
+  });
+
+  it('keeps every exchange, in order, as user/assistant message pairs', async () => {
+    const questions = ['How are documents imported?', 'What is the architecture?', 'Tell me about meeting notes'];
+    for (const q of questions) await qa.ask(q);
+
+    const conversation = qa.getConversation();
+    expect(conversation).toHaveLength(6);
+    expect(conversation.filter(m => m.role === 'user').map(m => m.content)).toEqual(questions);
+    for (let i = 0; i < 6; i += 2) {
+      const [q, a] = [conversation[i], conversation[i + 1]];
+      expect(q.role).toBe('user');
+      expect(a.role).toBe('assistant');
+      expect(q.turnId).toBe(a.turnId);
+      expect(new Date(q.timestamp).getTime()).toBeLessThanOrEqual(new Date(a.timestamp).getTime());
+      expect(a.citations).toEqual([]);
+    }
+    expect(new Set(conversation.map(m => m.id)).size).toBe(6);
+  });
+
+  it('does not truncate long answers or questions', async () => {
+    const long = 'architecture '.repeat(300).trim();
+    await qa.ask(long);
+    const [q, a] = qa.getConversation();
+    expect(q.content).toBe(long);
+    expect(a.content.length).toBeGreaterThan(100);
+    expect(a.content).toBe(qa.getHistory()[0].response.answer);
+  });
+
+  it('includes citations with document title and excerpt', async () => {
+    const docs = new DocumentService(persistence);
+    for (const f of fs.readdirSync(SAMPLES)) docs.importDocument(path.join(SAMPLES, f));
+    await new IndexingService(persistence).startIndexing();
+
+    await qa.ask('How does the indexing pipeline split chunks?');
+    const answer = qa.getConversation()[1];
+    expect(answer.citations!.length).toBeGreaterThan(0);
+    for (const c of answer.citations!) {
+      expect(c.documentTitle).not.toBe('Unknown Document');
+      expect(c.excerpt.length).toBeGreaterThan(0);
+    }
+  });
+
+  it('uses the previous question as context for a follow-up that matches nothing alone', async () => {
+    const docs = new DocumentService(persistence);
+    for (const f of fs.readdirSync(SAMPLES)) docs.importDocument(path.join(SAMPLES, f));
+    await new IndexingService(persistence).startIndexing();
+
+    await qa.ask('How does retrieval work?');
+    const followUp = await qa.ask('What about that?');
+    expect(followUp.usedConversationContext).toBe(true);
+    expect(followUp.citations.length).toBeGreaterThan(0);
+    expect(qa.getConversation()[3].usedConversationContext).toBe(true);
+  });
+
+  it('does not use context when the question matches on its own', async () => {
+    const docs = new DocumentService(persistence);
+    for (const f of fs.readdirSync(SAMPLES)) docs.importDocument(path.join(SAMPLES, f));
+    await new IndexingService(persistence).startIndexing();
+
+    await qa.ask('How does retrieval work?');
+    const second = await qa.ask('What was decided in the meeting?');
+    expect(second.usedConversationContext).toBe(false);
+  });
+
+  it('reads legacy history entries without id/askedAt', () => {
+    persistence.writeJson('qa-history.json', [
+      { question: 'old?', response: { answer: 'old answer', citations: [], confidence: 0.3, timestamp: '2026-01-01T10:00:00.000Z' } },
+    ]);
+    const [q, a] = qa.getConversation();
+    expect(q.turnId).toBe('legacy-0');
+    expect(q.timestamp).toBe('2026-01-01T10:00:00.000Z');
+    expect(a.content).toBe('old answer');
+  });
+
+  it('treats a corrupted history file as empty instead of throwing', () => {
+    fs.writeFileSync(path.join(dir, 'qa-history.json'), '{not json');
+    expect(qa.getConversation()).toEqual([]);
+  });
+
+  it('rejects empty questions and clears history', async () => {
+    await expect(qa.ask('   ')).rejects.toThrow('Question must not be empty');
+    await qa.ask('architecture?');
+    qa.clearHistory();
+    expect(qa.getConversation()).toEqual([]);
+  });
+
+  it('persists history across service instances (restart)', async () => {
+    await qa.ask('architecture?');
+    const restarted = new QaService(persistence, new IndexingService(persistence));
+    expect(restarted.getConversation()).toHaveLength(2);
+  });
+});

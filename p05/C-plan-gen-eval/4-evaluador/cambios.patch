+await c.waitFor(`!document.querySelector('article[aria-busy=true]')`); await c.sleep(200);
+R.s8_focusAfterSubmit=await c.ev(`document.activeElement.id||document.activeElement.outerHTML.slice(0,80)`);
+// forward Tab count from input to a citation of the newest exchange
+let ft=0; for(;ft<120;){await c.key('Tab'); ft++; const inLast=await c.ev(`(()=>{const a=[...document.querySelectorAll('[role=log] article')].at(-1);return a.contains(document.activeElement)&&document.activeElement.tagName==='BUTTON'})()`); if(inLast)break;}
+R.s8_forwardTabsToNewestCitation=ft;

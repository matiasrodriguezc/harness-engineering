+// Round-2 evaluator driver: re-tests defects 1, 2, 6, 8 from the round-1 rubric plus new edge cases.
+import {connect} from './cdp.mjs'; import fs from 'node:fs';
+const [E,LOG,KB]=process.argv.slice(2); const R={}; const c=await connect(); c.events.length=0;
+const step=async(n,fn)=>{try{R[n]=await fn();}catch(e){R[n]={ERROR:String(e)}}};
+const ask=async q=>{await c.click(`document.querySelector('#question-input')`); await c.type(q); await c.key('Enter');};
+const idle=async()=>{await c.sleep(30);await c.waitFor(`!document.querySelector('article[aria-busy=true]')`);await c.sleep(250);};
+const order=`[...document.querySelectorAll('[role=log] ol > li > article')].map(a=>(a.getAttribute('aria-label').startsWith('Exchange')?'OK: ':'FAIL: ')+a.querySelector('div div:nth-child(2)').textContent.slice(0,40))`;
+const keyRaw=async(key,code,vk,mod=0)=>{await c.send('Input.dispatchKeyEvent',{type:'rawKeyDown',key,code,windowsVirtualKeyCode:vk,modifiers:mod});await c.send('Input.dispatchKeyEvent',{type:'keyUp',key,code,windowsVirtualKeyCode:vk,modifiers:mod});};
+const active=`(()=>{const a=document.activeElement;return a.id||a.getAttribute('aria-label')||a.textContent.slice(0,40)})()`;
+
+// ---- Defect 6: keyboard reach to newest citations ----
+await c.click(`document.querySelector('#question-input')`);
+const path=[]; let found=false;
+for(let i=0;i<8;i++){ await c.key('Tab'); const a=await c.ev(active); const vis=await c.ev(`(()=>{const r=document.activeElement.getBoundingClientRect();return r.width>2&&r.height>2})()`); path.push({a,vis}); if(a==='Jump to latest answer'){found=true;break;} }
+R.d6_tabPathFromInput=path;
+if(found){
+  await c.shot(E+'/01-jump-button-focused.png');
+  await c.key('Enter'); await c.sleep(150);
+  R.d6_afterJump=await c.ev(`(()=>{const a=document.activeElement;const s=getComputedStyle(a);const r=a.getBoundingClientRect();const sc=document.querySelector('[role=log]').parentElement.getBoundingClientRect();return {id:a.id,label:a.getAttribute('aria-label'),outline:s.outlineStyle+' '+s.outlineWidth, fv:a.matches(':focus-visible'), topVisible:r.top>=sc.top-1&&r.top<sc.bottom}})()`);
+  await c.shot(E+'/02-after-jump.png');
+  await c.key('Tab'); R.d6_tabAfterJump=await c.ev(`(()=>{const l=document.getElementById('latest-exchange');return {inLatest:l.contains(document.activeElement), el:document.activeElement.tagName, text:document.activeElement.textContent.slice(0,30)}})()`);
+}
+// Alt+ArrowUp shortcut
+await c.click(`document.querySelector('#question-input')`);
+await keyRaw('ArrowUp','ArrowUp',38,1); await c.sleep(100);
+R.d6_altArrowUp=await c.ev(`document.activeElement.id`);
+// What happens with Jump when the newest exchange has no citations
+await ask('xyzzy plugh'); await idle();
+await c.click(`document.querySelector('#question-input')`); await keyRaw('ArrowUp','ArrowUp',38,1); await c.sleep(100); await c.key('Tab');
+R.d6_tabAfterJumpNoCitations=await c.ev(active);
+
+// ---- Defect 1: multiple failures, ordering, retry/dismiss ----
+fs.copyFileSync(KB+'/qa-history.json',KB+'/../qa-good.json'); fs.writeFileSync(KB+'/qa-history.json','{not json');
+await ask('First failing question'); await idle();
+R.d1_inputAfterFail=await c.ev(`document.querySelector('#question-input').value`);
+await ask('Second failing question'); await idle();
+R.d1_twoFailures=await c.ev(order);
+R.d1_detailsOpenByDefault=await c.ev(`[...document.querySelectorAll('details')].map(d=>d.open)`);
+R.d1_failText=await c.ev(`[...document.querySelectorAll('article[aria-label="Question that could not be answered"]')][0].innerText`);
+await c.shot(E+'/03-two-failures.png');
+// retry while still broken: is the entry kept?
+await c.click(`[...document.querySelectorAll('button')].find(b=>b.textContent==='Retry')`); await idle();
+R.d1_retryStillBroken=await c.ev(order);
+fs.copyFileSync(KB+'/../qa-good.json',KB+'/qa-history.json');
+// a new successful ask while failures are pending: where does it land?
+await ask('What design pattern is used?'); await idle();
+R.d1_orderAfterNewSuccess=await c.ev(order);
+await c.shot(E+'/04-order-after-new-success.png');
+R.d1_latestId=await c.ev(`document.getElementById('latest-exchange')?.querySelector('div div:nth-child(2)').textContent`);
+// retry the remaining failures: first retry button
+await c.click(`[...document.querySelectorAll('button')].find(b=>b.textContent==='Retry')`); await idle();
+R.d1_afterRetry=await c.ev(order);
+await c.click(`[...document.querySelectorAll('button')].find(b=>b.textContent==='Dismiss')`); await c.sleep(200);
+R.d1_afterDismiss=await c.ev(order);
+R.d1_focusAfterDismiss=await c.ev(`document.activeElement.tagName+':'+(document.activeElement.id||document.activeElement.textContent.slice(0,30))`);
+await c.shot(E+'/05-after-retry-dismiss.png');
+R.d1_fileTail=JSON.parse(fs.readFileSync(KB+'/qa-history.json','utf8')).slice(-3).map(h=>h.question);
+R.qaFailedInLog=fs.readFileSync(LOG,'utf8').split('\n').filter(l=>l.includes('Q&A failed')).length;
+
+// ---- Defect 2: deleted cited document, list not refreshed ----
+const docs=await c.ev(`window.knowledgeBase.documents.list()`); const dn=docs.find(d=>d.title==='design-notes');

+// Round-2: keyboard jump with citations, focus after Retry, new-answer visibility with failures pending.
+import {connect} from './cdp.mjs'; import fs from 'node:fs';
+const [E,LOG,KB]=process.argv.slice(2); const R={}; const c=await connect(); c.events.length=0;
+const ask=async q=>{await c.click(`document.querySelector('#question-input')`); await c.type(q); await c.key('Enter');};
+const idle=async()=>{await c.sleep(30);await c.waitFor(`!document.querySelector('article[aria-busy=true]')`);await c.sleep(250);};
+const active=`(()=>{const a=document.activeElement;return a.tagName+':'+(a.id||a.getAttribute('aria-label')||a.textContent.slice(0,40))})()`;
+await c.click(`document.querySelector('button[aria-label="Close document"]')`).catch(()=>{}); await c.sleep(200);
+// Keyboard-only: input -> Tab x? -> Jump -> Enter -> Tab -> citation -> Enter
+await c.click(`document.querySelector('#question-input')`);
+const presses=[]; for(let i=0;i<4;i++){await c.key('Tab'); const a=await c.ev(active); presses.push('Tab→'+a); if(a.includes('Jump'))break;}
+await c.key('Enter'); presses.push('Enter→'+await c.ev(active));
+await c.key('Tab'); presses.push('Tab→'+await c.ev(active));
+R.kb_path=presses;
+R.kb_inLatestCitation=await c.ev(`document.getElementById('latest-exchange').contains(document.activeElement)&&document.activeElement.tagName==='BUTTON'`);
+const t=await c.ev(`document.activeElement.querySelector('span')?.textContent`);
+await c.key('Enter'); await c.sleep(400);
+R.kb_opened=await c.ev(`document.querySelector('section[aria-label="Selected document"] h2')?.textContent`)+' (expected '+t+')';
+await c.click(`document.querySelector('button[aria-label="Close document"]')`).catch(()=>{}); await c.sleep(200);
+
+// Failure pending, then a successful ask: is the new answer visible?
+fs.copyFileSync(KB+'/qa-history.json',KB+'/../qa-good2.json'); fs.writeFileSync(KB+'/qa-history.json','{not json');
+await ask('Failing question X'); await idle();
+fs.copyFileSync(KB+'/../qa-good2.json',KB+'/qa-history.json');
+await ask('How does retrieval work?'); await idle();
+R.vis_newAnswerAfterFailure=await c.ev(`(()=>{const sc=document.querySelector('[role=log]').parentElement.getBoundingClientRect();const r=document.getElementById('latest-exchange').getBoundingClientRect();return {latestTop:Math.round(r.top),latestBottom:Math.round(r.bottom),viewTop:Math.round(sc.top),viewBottom:Math.round(sc.bottom),anyPartVisible:r.bottom>sc.top&&r.top<sc.bottom, visiblePx:Math.max(0,Math.min(r.bottom,sc.bottom)-Math.max(r.top,sc.top))}})()`);
+await c.shot(E+'/07-new-answer-hidden-by-failure.png');
+// Keyboard: focus after Retry (button unmounts)
+await c.ev(`[...document.querySelectorAll('button')].find(b=>b.textContent==='Retry').focus()`);
+await c.key('Enter'); await idle();
+R.focusAfterRetry=await c.ev(active);
+R.events=c.events.filter(e=>e.kind!=='console.warning');
+fs.copyFileSync(KB+'/qa-history.json',E+'/file-before-restart.json');
+R.onScreen=await c.ev(`[...document.querySelectorAll('[role=log] article[aria-label^="Exchange"]')].map(a=>({q:a.querySelector('div div:nth-child(2)').textContent, t:a.querySelector('time').getAttribute('datetime'), c:[...a.querySelectorAll('li button > span:first-child')].map(s=>s.textContent)}))`);
+fs.writeFileSync(E+'/p3.json',JSON.stringify({onScreen:R.onScreen},null,2));

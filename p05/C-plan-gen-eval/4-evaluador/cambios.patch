+// Round-2: startup with an unreadable qa-history.json -> recover in-app via Clear.
+import {connect} from './cdp.mjs'; import fs from 'node:fs';
+const [E,KB]=process.argv.slice(2); const R={}; const c=await connect();
+await c.waitFor(`document.querySelector('#conversation-heading')!==null`,15000); await c.sleep(800);
+R.loadError=await c.ev(`document.querySelector('main').innerText.slice(0,400)`);
+R.clearEnabled=await c.ev(`!([...document.querySelectorAll('button')].find(b=>b.textContent==='Clear').disabled)`);
+await c.shot(E+'/12-startup-corrupt.png');
+await c.click(`[...document.querySelectorAll('button')].find(b=>b.textContent==='Clear')`); await c.sleep(200);
+R.confirmText=await c.ev(`document.querySelector('[role=group]')?.innerText`);
+await c.click(`[...document.querySelectorAll('button')].find(b=>b.textContent==='Clear conversation')`); await c.sleep(600);
+R.file=fs.readFileSync(KB+'/qa-history.json','utf8');
+R.after=await c.ev(`document.querySelector('main').innerText.slice(0,200)`);
+R.focus=await c.ev(`document.activeElement.tagName`);
+await c.click(`document.querySelector('#question-input')`); await c.type('How does retrieval work?'); await c.key('Enter');
+await c.sleep(30); await c.waitFor(`!document.querySelector('article[aria-busy=true]')`); await c.sleep(300);
+R.afterAsk=await c.ev(`[...document.querySelectorAll('[role=log] article')].map(a=>a.getAttribute('aria-label'))`);
+R.fileLen=JSON.parse(fs.readFileSync(KB+'/qa-history.json','utf8')).length;
+await c.shot(E+'/13-recovered.png');
+R.events=c.events.filter(e=>e.kind!=='console.warning');
+fs.writeFileSync(E+'/r2c.json',JSON.stringify(R,null,2)); console.log(JSON.stringify(R,null,1)); c.close();

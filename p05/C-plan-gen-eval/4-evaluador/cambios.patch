+import fs from 'node:fs';
+export async function connect(port=9444){
+  let list; for(let i=0;i<100;i++){ try{ list=await (await fetch(`http://127.0.0.1:${port}/json/list`)).json(); if(list.find(t=>t.type==='page'))break;}catch{} await new Promise(r=>setTimeout(r,200)); }
+  const page=list.find(t=>t.type==='page'); const ws=new WebSocket(page.webSocketDebuggerUrl);
+  await new Promise((res,rej)=>{ws.onopen=res;ws.onerror=rej});
+  let id=0; const pend=new Map(); const events=[];
+  ws.onmessage=ev=>{const m=JSON.parse(ev.data); if(m.id&&pend.has(m.id)){const p=pend.get(m.id);pend.delete(m.id);m.error?p.rej(new Error(JSON.stringify(m.error))):p.res(m.result);}
+    else if(m.method==='Runtime.exceptionThrown') events.push({kind:'exception',text:m.params.exceptionDetails.exception?.description??m.params.exceptionDetails.text});
+    else if(m.method==='Runtime.consoleAPICalled') events.push({kind:'console.'+m.params.type,text:m.params.args.map(a=>a.value??a.description).join(' ')});};
+  const send=(method,params={})=>new Promise((res,rej)=>{const i=++id;pend.set(i,{res,rej});ws.send(JSON.stringify({id:i,method,params}))});
+  await send('Runtime.enable'); await send('Page.enable');
+  const ev=async e=>{const r=await send('Runtime.evaluate',{expression:e,awaitPromise:true,returnByValue:true}); if(r.exceptionDetails) throw new Error(JSON.stringify(r.exceptionDetails)); return r.result.value;};
+  const keys={Enter:{code:'Enter',windowsVirtualKeyCode:13,text:'\r'},Tab:{code:'Tab',windowsVirtualKeyCode:9},' ':{code:'Space',windowsVirtualKeyCode:32,text:' '},Escape:{code:'Escape',windowsVirtualKeyCode:27}};
+  const key=async(k,o={})=>{const d=keys[k];const mod=o.shift?8:0;await send('Input.dispatchKeyEvent',{type:d.text?'keyDown':'rawKeyDown',key:k,modifiers:mod,...d});await send('Input.dispatchKeyEvent',{type:'keyUp',key:k,modifiers:mod,code:d.code,windowsVirtualKeyCode:d.windowsVirtualKeyCode});};
+  const type=t=>send('Input.insertText',{text:t});
+  const clickAt=async(x,y)=>{for(const t of ['mouseMoved','mousePressed','mouseReleased'])await send('Input.dispatchMouseEvent',{type:t,x,y,button:'left',clickCount:1});};
+  const click=async expr=>{const r=await ev(`(()=>{const el=${expr};if(!el)return null;el.scrollIntoView({block:'center'});const b=el.getBoundingClientRect();return{x:b.x+b.width/2,y:b.y+Math.min(b.height/2,10)}})()`); if(!r) throw new Error('no target '+expr); await clickAt(r.x,r.y);};
+  const shot=async f=>{await send('Page.bringToFront');await new Promise(r=>setTimeout(r,250));const r=await Promise.race([send('Page.captureScreenshot',{format:'png'}),new Promise(r=>setTimeout(()=>r(null),8000))]);if(r)fs.writeFileSync(f,Buffer.from(r.data,'base64'));else console.error('SHOT TIMEOUT '+f);};
+  const waitFor=async(e,t=6000)=>{const t0=Date.now();while(Date.now()-t0<t){if(await ev(e))return true;await new Promise(r=>setTimeout(r,40));}throw new Error('timeout '+e);};
+  const sleep=ms=>new Promise(r=>setTimeout(r,ms));
+  return {send,ev,key,type,click,clickAt,shot,waitFor,sleep,events,close:()=>ws.close()};
+}

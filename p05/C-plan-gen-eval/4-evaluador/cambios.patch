+let bt=0; for(;bt<20;){await c.key('Tab',{shift:true}); bt++; const inLast=await c.ev(`(()=>{const a=[...document.querySelectorAll('[role=log] article')].at(-1);return a.contains(document.activeElement)&&document.activeElement.tagName==='BUTTON'})()`); if(inLast)break;}
+R.s8_shiftTabsToNewestCitation=bt;
+R.s8_focusStyle=await c.ev(`(()=>{const s=getComputedStyle(document.activeElement);return {outline:s.outlineStyle+' '+s.outlineWidth+' '+s.outlineColor, fv:document.activeElement.matches(':focus-visible')}})()`);
+await c.shot(E+'/09-keyboard-focus-citation.png');
+const citeTitle=await c.ev(`document.activeElement.querySelector('span').textContent`);
+await c.key('Enter'); await c.sleep(400);
+R.s8_enterOpened=await c.ev(`document.querySelector('section[aria-label="Selected document"] h2')?.textContent`)+' (expected '+citeTitle+')';
+await c.click(`document.querySelector('button[aria-label="Close document"]')`); await c.sleep(200);
+// Space activation
+await c.click(`document.querySelector('#question-input')`); await c.key('Tab',{shift:true});
+await c.key(' '); await c.sleep(400);
+R.s8_spaceOpened=await c.ev(`document.querySelector('section[aria-label="Selected document"] h2')?.textContent`);
+await c.shot(E+'/10-keyboard-opened.png');
+// Step 9: DOM semantics
+R.s9=await c.ev(`(()=>{const log=document.querySelector('[role=log]');const i=document.querySelector('#question-input');return {log:log.outerHTML.slice(0,90), list:log.firstElementChild.tagName, li:log.querySelector('ol>li>article')?.getAttribute('aria-label'), label:document.querySelector('label[for=question-input]')?.textContent.trim(), clickableDivs:[...document.querySelectorAll('div,span')].filter(d=>d.onclick||d.getAttribute('onclick')).length, citeTags:[...new Set([...log.querySelectorAll('li li > *')].map(e=>e.tagName))]}})()`);
+// Step 10: timestamps vs file
+R.s10_times=await c.ev(`[...document.querySelectorAll('[role=log] time')].map(t=>[t.getAttribute('datetime'),t.textContent])`);
+// Narrow window: horizontal overflow
+await c.send('Emulation.setDeviceMetricsOverride',{width:700,height:600,deviceScaleFactor:1,mobile:false});
+await c.sleep(300);
+R.narrow=await c.ev(`({doc:[document.documentElement.scrollWidth,document.documentElement.clientWidth], main:(()=>{const m=document.querySelector('main');return [m.scrollWidth,m.clientWidth]})()})`);
+await c.shot(E+'/11-narrow-700px.png');
+await c.send('Emulation.clearDeviceMetricsOverride');
+// long unbroken question
+await ask('a'.repeat(400)); await c.sleep(30); await c.waitFor(`!document.querySelector('article[aria-busy=true]')`); await c.sleep(200);
+R.longQuestion=await c.ev(`(()=>{const sc=document.querySelector('[role=log]').parentElement;return {scroller:[sc.scrollWidth,sc.clientWidth]}})()`);
+await c.shot(E+'/12-long-unbroken-question.png');
+R.events=c.events;
+fs.writeFileSync(E+'/p2.json',JSON.stringify(R,null,2)); console.log(JSON.stringify(R,null,2)); c.close();

+// Session 1: empty state, seeding, asks, pending/double-submit, no-citation, autoscroll,
+// citation mouse + keyboard, a11y DOM, timestamps, error path.
+import fs from 'node:fs';
+import { connect } from './cdp.mjs';
+
+const [, , REPO, KB, LOG, OUT] = process.argv;
+const c = await connect();
+const results = [];
+const check = (id, name, ok, detail) => { results.push({ id, name, ok: !!ok, detail }); console.log(`${ok ? 'PASS' : 'FAIL'} [${id}] ${name} :: ${JSON.stringify(detail)}`); };
+const askCount = () => fs.readFileSync(LOG, 'utf8').split('\n').filter(l => l.includes('"ASK_QUESTION"')).length;
+const exchanges = `document.querySelectorAll('[role=log] ol > li article[aria-label^="Exchange"]').length`;
+const ask = async q => {
+  await c.evaluate(`document.getElementById('question-input').focus()`);
+  await c.type(q);
+  await c.key('Enter');
+};
+const settled = `!document.querySelector('[aria-busy=true]')`;
+
+await c.waitFor(`!!document.querySelector('#conversation-heading') && !document.body.innerText.includes('Loading conversation')`);
+
+// AC-10 empty state
+await c.screenshot(`${OUT}/01-empty.png`);
+check('AC-10', 'empty state shown on fresh data dir', await c.evaluate(`document.body.innerText.includes('No questions yet')`), {});
+
+// Seed documents (§6.2), then Refresh
+await c.evaluate(`(async () => { for (const f of ['design-notes.md','meeting-summary.txt','retrieval-plan.md']) await window.knowledgeBase.documents.import('${REPO}/data/sample-documents/' + f); await window.knowledgeBase.indexing.start(); })()`);
+await c.click(`[...document.querySelectorAll('header button')].find(b => b.textContent.trim() === 'Refresh')`);
+await c.waitFor(`document.body.innerText.includes('Documents (3)')`);
+check('seed', '3 documents listed', true, {});
+
+// Step 2: first question, observe pending
+const before2 = askCount();
+await ask('How does the indexing pipeline chunk documents?');
+const pendingSeen = await c.evaluate(`(() => { const p = document.querySelector('[aria-busy=true]'); return p ? p.innerText : null; })()`);
+await c.screenshot(`${OUT}/02-pending.png`);
+await c.waitFor(settled);
+await c.waitFor(`${exchanges} === 1`);
+check('AC-8', 'pending turn shows question + Answering…', pendingSeen && pendingSeen.includes('How does the indexing pipeline') && pendingSeen.includes('Answering…'), { pendingSeen });
+const ex1 = await c.evaluate(`(() => { const a = document.querySelector('[role=log] article'); return { text: a.innerText, citations: a.querySelectorAll('button').length, time: a.querySelector('time')?.textContent, dt: a.querySelector('time')?.getAttribute('datetime') }; })()`);
+check('AC-4', 'answer 1 has >=1 citation button with title, chunk, excerpt', ex1.citations >= 1 && /chunk \d+/.test(ex1.text) && ex1.text.includes('“'), ex1);
+check('AC-6', 'readable timestamp (not ISO)', ex1.time && !ex1.time.includes('T') && /\d{4}/.test(ex1.time), { time: ex1.time, datetime: ex1.dt });
+check('AC-8', 'one ASK_QUESTION for one ask', askCount() - before2 === 1, { delta: askCount() - before2 });
+await c.screenshot(`${OUT}/03-first-answer.png`);
+
+// Step 3: double submit while pending
+const before3 = askCount();
+await ask('What did the meeting decide about retrieval?');
+await c.type('second submit attempt');
+await c.key('Enter');
+await c.click(`document.querySelector('form button[type=submit]')`);
+const busyLabel = await c.evaluate(`document.querySelector('form button[type=submit]').textContent`);
+await c.waitFor(settled);
+await c.waitFor(`${exchanges} === 2`);
+const inputAfter = await c.evaluate(`document.getElementById('question-input').value`);
+check('AC-8', 'Enter + click during pending add no extra ASK_QUESTION', askCount() - before3 === 1, { delta: askCount() - before3, busyLabel, inputKeptText: inputAfter });
+const turns = await c.evaluate(`[...document.querySelectorAll('[role=log] article')].map(a => a.querySelector('div').innerText)`);
+check('AC-8', 'no duplicate question turn after resolve', turns.filter(t => t.includes('What did the meeting decide')).length === 1, { turns });
+await c.evaluate(`(() => { const i = document.getElementById('question-input'); const set = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set; set.call(i, ''); i.dispatchEvent(new Event('input', { bubbles: true })); })()`);
+
+// Step 4: order + first unchanged
+const qs = await c.evaluate(`[...document.querySelectorAll('[role=log] article[aria-label^="Exchange"]')].map(a => a.innerText.split('\\n')[1])`);
+check('AC-1', 'two exchanges oldest-first', qs[0].startsWith('How does the indexing') && qs[1].startsWith('What did the meeting'), { qs });
+const roles = await c.evaluate(`[...document.querySelector('[role=log] article').querySelectorAll('div')].map(d => d.textContent).filter(t => t === 'You' || t.startsWith('Assistant')).length`);
+check('AC-2', '"You" / "Assistant" text labels present', roles >= 2, { roles });
+await c.screenshot(`${OUT}/04-two-exchanges.png`);
+
+// Step 5: no citations
+await ask('xyzzy plugh');
+await c.waitFor(`${exchanges} === 3`);
+const last = await c.evaluate(`(() => { const all = document.querySelectorAll('[role=log] article'); const a = all[all.length-1]; return { text: a.innerText, buttons: a.querySelectorAll('button').length }; })()`);
+check('AC-4', 'zero-citation answer says "No sources cited", no Sources header', last.text.includes('No sources cited') && !last.text.includes('SOURCES') && !last.text.includes('Sources') && last.buttons === 0, last);
+await c.screenshot(`${OUT}/05-no-citations.png`);
+
+// Step 6: overflow + autoscroll
+for (const q of ['What retrieval approach is planned?', 'How are documents imported?', 'Summarize the meeting notes', 'What search strategy is used?']) {
+  const n = await c.evaluate(exchanges);
+  await ask(q);
+  await c.waitFor(`${exchanges} === ${n + 1}`);
+  await c.waitFor(settled);
+}
+await new Promise(r => setTimeout(r, 200));
+const scroll = await c.evaluate(`(() => { const log = document.querySelector('[role=log]'); const sc = log.parentElement; const arts = log.querySelectorAll('article'); const lastA = arts[arts.length-1].getBoundingClientRect(); const box = sc.getBoundingClientRect(); return { scrollHeight: sc.scrollHeight, clientHeight: sc.clientHeight, scrollTop: sc.scrollTop, atBottom: sc.scrollTop + sc.clientHeight >= sc.scrollHeight - 2, lastBottomVisible: lastA.bottom <= box.bottom + 2 && lastA.bottom > box.top }; })()`);
+check('AC-12', 'conversation taller than panel and newest exchange in view', scroll.scrollHeight > scroll.clientHeight && scroll.atBottom && scroll.lastBottomVisible, scroll);
+await c.screenshot(`${OUT}/06-autoscroll.png`);
+const noHScroll = await c.evaluate(`({ doc: document.documentElement.scrollWidth <= document.documentElement.clientWidth, body: document.body.scrollWidth <= document.body.clientWidth })`);
+check('AC-3', 'no horizontal overflow of window', noHScroll.doc && noHScroll.body, noHScroll);
+
+// Step 7: mouse click citation from exchange 1
+const cited = await c.evaluate(`document.querySelector('[role=log] article button span').textContent`);
+await c.click(`document.querySelector('[role=log] article button')`);
+await c.waitFor(`!!document.querySelector('section[aria-label="Selected document"] h2')`);
+const shown = await c.evaluate(`document.querySelector('section[aria-label="Selected document"] h2').textContent`);
+check('AC-5', 'mouse click on citation shows cited document', shown === cited, { cited, shown });
+await c.screenshot(`${OUT}/07-citation-click.png`);
+await c.click(`document.querySelector('button[aria-label="Close document"]')`);
+
+// Step 8: keyboard only
+await c.evaluate(`document.activeElement && document.activeElement.blur()`);
+// Tab from the top of the page until the question input has focus
+let tabs = 0;
+for (; tabs < 200; tabs++) {
+  if (await c.evaluate(`document.activeElement?.id === 'question-input'`)) break;
+  await c.key('Tab', { shift: true });
+}
+const inputFocusVisible = await c.evaluate(`document.activeElement.matches(':focus-visible') && getComputedStyle(document.activeElement).outlineStyle !== 'none'`);
+const nBefore = await c.evaluate(exchanges);
+await c.type('What design pattern is used?');
+await c.key('Enter');
+await c.waitFor(`${exchanges} === ${nBefore + 1}`);
+await c.waitFor(settled);
+// Shift+Tab from the input reaches the newest answer's last citation
+await c.key('Tab', { shift: true });
+const focused = await c.evaluate(`(() => { const el = document.activeElement; const arts = document.querySelectorAll('[role=log] article'); return { tag: el.tagName, inNewest: arts[arts.length-1].contains(el), text: el.querySelector('span')?.textContent, focusVisible: el.matches(':focus-visible'), outline: getComputedStyle(el).outlineStyle + ' ' + getComputedStyle(el).outlineColor }; })()`);
+await c.screenshot(`${OUT}/08-keyboard-focus-citation.png`);
+await c.key('Enter');
+await c.waitFor(`!!document.querySelector('section[aria-label="Selected document"] h2')`);
+const kbShown = await c.evaluate(`document.querySelector('section[aria-label="Selected document"] h2').textContent`);
+check('AC-13', 'keyboard flow: input reached, focus visible, submit, Shift+Tab to citation, Enter opens doc', inputFocusVisible && focused.tag === 'BUTTON' && focused.inNewest && focused.focusVisible && kbShown === focused.text, { tabsToInput: tabs, inputFocusVisible, focused, kbShown });
+// Space activation on another citation
+await c.evaluate(`document.querySelector('button[aria-label="Close document"]').click()`);
+await c.evaluate(`[...document.querySelectorAll('[role=log] article button')][0].focus()`);
+await c.key(' ');
+await c.waitFor(`!!document.querySelector('section[aria-label="Selected document"] h2')`);
+check('AC-5', 'Space on focused citation opens document', true, {});
+await c.screenshot(`${OUT}/09-keyboard-opened.png`);
+
+// Step 9: DOM semantics
+const dom = await c.evaluate(`(() => { const log = document.querySelector('[role=log]'); const i = document.getElementById('question-input'); const lab = document.querySelector('label[for=question-input]'); return { logRole: log.getAttribute('role'), ariaLive: log.getAttribute('aria-live'), listTag: log.firstElementChild.tagName, itemTag: log.querySelector('li').tagName, articleTag: log.querySelector('li > article').tagName, inputLabel: lab && lab.textContent, citationTags: [...new Set([...log.querySelectorAll('article ul li > *')].map(e => e.tagName))], clickableDivs: [...log.querySelectorAll('div')].filter(d => d.onclick).length }; })()`);
+check('AC-13', 'role=log + aria-live, ol/li/article, labelled input, citations are buttons', dom.logRole === 'log' && dom.ariaLive === 'polite' && dom.listTag === 'OL' && dom.articleTag === 'ARTICLE' && dom.inputLabel && dom.citationTags.join() === 'BUTTON', dom);
+
+// Step 10: timestamps match file
+const fileHist = JSON.parse(fs.readFileSync(`${KB}/qa-history.json`, 'utf8'));
+const screenTimes = await c.evaluate(`[...document.querySelectorAll('[role=log] article time')].map(t => ({ dt: t.getAttribute('datetime'), text: t.textContent }))`);
+const tsOk = screenTimes.length === fileHist.length && screenTimes.every((t, i) => t.dt === fileHist[i].response.timestamp && t.text === new Date(fileHist[i].response.timestamp).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' }));
+check('AC-6', 'on-screen times match qa-history.json timestamps', tsOk, { count: screenTimes.length, first: screenTimes[0], file0: fileHist[0].response.timestamp });
+
+// Stale citation (AC-5): delete the cited doc of exchange 1 via API, click its citation
+const docs = await c.evaluate(`window.knowledgeBase.documents.list()`);
+const staleTitle = await c.evaluate(`document.querySelector('[role=log] article button span').textContent`);
+const victim = docs.find(d => d.title === staleTitle);
+fs.copyFileSync(`${KB}/documents-meta.json`, `${OUT}/../documents-meta.backup.json`);
+await c.evaluate(`window.knowledgeBase.documents.delete('${victim.id}')`);
+await c.evaluate(`document.querySelector('button[aria-label="Close document"]')?.click()`);
+await c.evaluate(`document.querySelector('header button').click()`);
+await new Promise(r => setTimeout(r, 300));
+const probsBefore = c.problems.length;
+await c.click(`document.querySelector('[role=log] article button')`);
+await c.waitFor(`document.querySelector('[role=log] article').innerText.includes('no longer available')`);
+await new Promise(r => setTimeout(r, 300));
+check('AC-5', 'stale citation: stays visible, shows notice, no console error / exception', c.problems.length === probsBefore && !(await c.evaluate(`!!document.querySelector('section[aria-label="Selected document"]')`)), { newProblems: c.problems.slice(probsBefore) });
+await c.screenshot(`${OUT}/10-stale-citation.png`);
+// Restore the document metadata so later steps see 3 documents again (file restored while app runs; list re-reads it)
+fs.copyFileSync(`${OUT}/../documents-meta.backup.json`, `${KB}/documents-meta.json`);
+fs.unlinkSync(`${OUT}/../documents-meta.backup.json`);
+await c.evaluate(`document.querySelector('header button').click()`);
+
+// Error path (§6.5)
+const nErrBefore = await c.evaluate(exchanges);
+const good = fs.readFileSync(`${KB}/qa-history.json`, 'utf8');
+fs.writeFileSync(`${KB}/qa-history.json`, '{not json\n');
+await ask('How does retrieval work?');
+await c.waitFor(`!!document.querySelector('[role=log] article[aria-label^="Question that could not"]')`);
+const err = await c.evaluate(`(() => { const a = document.querySelector('[role=log] article[aria-label^="Question that could not"]'); return { text: a.innerText, exchanges: ${exchanges} }; })()`);
+await c.screenshot(`${OUT}/11-error.png`);
+const logHasFail = fs.readFileSync(LOG, 'utf8').includes('Q&A failed');
+check('AC-9', 'inline error, earlier exchanges kept, not shown as answered, log has Q&A failed', err.text.includes('could not be answered') && err.text.includes('How does retrieval work?') && err.exchanges === nErrBefore && logHasFail, { err, nErrBefore, logHasFail });
+fs.writeFileSync(`${KB}/qa-history.json`, good);
+await c.click(`[...document.querySelectorAll('[role=log] button')].find(b => b.textContent === 'Retry')`);
+await c.waitFor(`${exchanges} === ${nErrBefore + 1}`);
+await c.waitFor(settled);
+const afterRetry = await c.evaluate(`({ errorGone: !document.querySelector('[role=log] article[aria-label^="Question that could not"]'), lastQ: [...document.querySelectorAll('[role=log] article')].pop().innerText.split('\\n')[1] })`);
+check('AC-9', 'after restoring file, retry succeeds and error turn removed', afterRetry.errorGone && afterRetry.lastQ === 'How does retrieval work?', afterRetry);
+await c.screenshot(`${OUT}/12-after-retry.png`);
+
+check('AC-5/console', 'no uncaught exceptions or console errors during session', c.problems.length === 0, c.problems);
+fs.writeFileSync(`${OUT}/phase1-results.json`, JSON.stringify(results, null, 2));
+c.close();

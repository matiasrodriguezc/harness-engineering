+}
+check('console', 'no console errors / uncaught exceptions', c.problems.filter(p => p.kind !== 'console.warning').length === 0, c.problems.map(p => p.kind));
+fs.writeFileSync(`${OUT}/phase2-${MODE}-results.json`, JSON.stringify(results, null, 2));
+c.close();

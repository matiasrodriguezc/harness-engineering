+import { describe, expect, it } from 'vitest';
+import { describeAskError, describeConfidence, formatTimestamp } from './conversation-format';
+
+describe('formatTimestamp', () => {
+  it('formats an ISO timestamp as a readable local date and time', () => {
+    const iso = '2026-11-15T22:42:00';
+    const expected = new Date(iso).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' });
+    expect(formatTimestamp(iso, 'en-US')).toBe(expected);
+    expect(formatTimestamp(iso, 'en-US')).toMatch(/^Nov 15, 2026, 10:42\sPM$/);
+  });
+
+  it('never returns the raw ISO string', () => {
+    const iso = '2026-11-15T10:42:00.000Z';
+    expect(formatTimestamp(iso, 'en-US')).not.toContain('T10:42');
+  });
+
+  it('handles invalid timestamps without throwing', () => {
+    expect(formatTimestamp('not a date')).toBe('Unknown time');
+  });
+});
+
+describe('describeConfidence', () => {
+  it('maps scores to percent and a text level', () => {
+    expect(describeConfidence(0.85)).toEqual({ percent: 85, level: 'High' });
+    expect(describeConfidence(0.5)).toEqual({ percent: 50, level: 'Medium' });
+    expect(describeConfidence(0.3)).toEqual({ percent: 30, level: 'Low' });
+  });
+
+  it('clamps out-of-range and non-numeric values', () => {
+    expect(describeConfidence(1.7)).toEqual({ percent: 100, level: 'High' });
+    expect(describeConfidence(-1)).toEqual({ percent: 0, level: 'Low' });
+    expect(describeConfidence(Number.NaN)).toEqual({ percent: 0, level: 'Low' });
+  });
+});
+
+describe('describeAskError', () => {
+  it('strips the Electron IPC prefix', () => {
+    const err = new Error("Error invoking remote method 'qa:ask': SyntaxError: Unexpected token n in JSON");
+    expect(describeAskError(err)).toBe('SyntaxError: Unexpected token n in JSON');
+  });
+
+  it('handles non-Error rejections', () => {
+    expect(describeAskError('boom')).toBe('boom');
+    expect(describeAskError('')).toBe('Unknown error');
+  });
+});
diff --git a/src/renderer/components/conversation-format.ts b/src/renderer/components/conversation-format.ts
new file mode 100644
index 0000000..2541be1
--- /dev/null
+++ b/src/renderer/components/conversation-format.ts
@@ -0,0 +1,29 @@
+/**
+ * Display-only formatting helpers for the conversation view.
+ * Pure functions so they can be unit-tested without a DOM.
+ */
+
+/** Formats an ISO timestamp as a readable local date and time, e.g. "Nov 15, 2026, 10:42 PM". */
+export function formatTimestamp(iso: string, locale?: string): string {
+  const date = new Date(iso);
+  if (Number.isNaN(date.getTime())) return 'Unknown time';
+  return date.toLocaleString(locale, { dateStyle: 'medium', timeStyle: 'short' });
+}
+
+export type ConfidenceLevel = 'High' | 'Medium' | 'Low';
+
+/** Maps a 0..1 confidence score to a percentage and a text label (never colour alone). */
+export function describeConfidence(confidence: number): { percent: number; level: ConfidenceLevel } {
+  const clamped = Number.isFinite(confidence) ? Math.min(1, Math.max(0, confidence)) : 0;
+  const percent = Math.round(clamped * 100);
+  const level: ConfidenceLevel = clamped >= 0.7 ? 'High' : clamped >= 0.4 ? 'Medium' : 'Low';
+  return { percent, level };
+}
+
+/** Turns an IPC rejection into a short, user-facing message. */
+export function describeAskError(err: unknown): string {
+  const raw = err instanceof Error ? err.message : String(err);
+  // Electron prefixes rejections with "Error invoking remote method '<channel>': ".
+  const cleaned = raw.replace(/^Error invoking remote method '[^']+':\s*/, '').trim();
+  return cleaned || 'Unknown error';
+}

diff --git a/src/renderer/components/ConversationView.tsx b/src/renderer/components/ConversationView.tsx
new file mode 100644
index 0000000..78a42f7
--- /dev/null
+++ b/src/renderer/components/ConversationView.tsx
@@ -0,0 +1,454 @@
+import { useEffect, useRef, useState } from 'react';
+import type { CSSProperties } from 'react';
+import { Citation, QAHistory } from '../../shared/types';
+import { describeConfidence, formatTimestamp } from './conversation-format';
+
+export type HistoryLoadState = 'loading' | 'loaded' | 'error';
+
+export interface AskError {
+  question: string;
+  message: string;
+}
+
+interface Props {
+  history: QAHistory[];
+  loadState: HistoryLoadState;
+  pendingQuestion: string | null;
+  askError: AskError | null;
+  documentCount: number;
+  selectedDocId: string | null;
+  /** Resolves to false when the cited document no longer exists. */
+  onOpenCitation: (citation: Citation) => Promise<boolean>;
+  onRetry: (question: string) => void;
+  onDismissError: () => void;
+  onReloadHistory: () => void;
+  /** Resolves to false when clearing failed. */
+  onClear: () => Promise<boolean>;
+}
+
+const palette = {
+  panel: '#16213e',
+  card: '#1a1a3e',
+  border: '#0f3460',
+  accent: '#533483',
+  text: '#e0e0e0',
+  muted: '#8888bb',
+  error: '#d9534f',
+};
+
+const smallButton: CSSProperties = {
+  padding: '4px 10px',
+  background: palette.border,
+  color: palette.text,
+  border: '1px solid #1a1a4e',
+  borderRadius: '4px',
+  cursor: 'pointer',
+  fontSize: '12px',
+};
+
+const turnLabel: CSSProperties = {
+  fontSize: '11px',
+  fontWeight: 600,
+  textTransform: 'uppercase',
+  letterSpacing: '0.05em',
+  color: palette.muted,
+  marginBottom: '4px',
+};
+
+const textBlock: CSSProperties = {
+  fontSize: '14px',
+  lineHeight: 1.6,
+  whiteSpace: 'pre-wrap',
+  overflowWrap: 'anywhere',
+};
+
+function citationKey(exchangeIndex: number, citationIndex: number): string {
+  return `${exchangeIndex}:${citationIndex}`;
+}
+
+function UserTurn({ question }: { question: string }) {
+  return (
+    <div style={{
+      alignSelf: 'flex-end',
+      maxWidth: '85%',
+      minWidth: 0,
+      padding: '10px 14px',
+      background: palette.border,
+      borderRadius: '8px 8px 2px 8px',
+    }}>
+      <div style={turnLabel}>You</div>
+      <div style={textBlock}>{question}</div>
+    </div>
+  );
+}
+
+function CitationList({
+  citations,
+  exchangeIndex,
+  selectedDocId,
+  unavailable,
+  onActivate,
+}: {
+  citations: Citation[];
+  exchangeIndex: number;
+  selectedDocId: string | null;
+  unavailable: Set<string>;
+  onActivate: (citation: Citation, key: string) => void;
+}) {
+  if (citations.length === 0) {
+    return (
+      <div style={{ marginTop: '10px', fontSize: '12px', color: palette.muted, fontStyle: 'italic' }}>
+        No sources cited.
+      </div>
+    );
+  }
+
+  return (
+    <div style={{ marginTop: '12px' }}>
+      <div style={{ ...turnLabel, marginBottom: '6px' }}>Sources ({citations.length})</div>
+      <ul style={{ listStyle: 'none', display: 'flex', flexDirection: 'column', gap: '6px' }}>
+        {citations.map((c, i) => {
+          const key = citationKey(exchangeIndex, i);
+          const isMissing = unavailable.has(key);
+          const isSelected = selectedDocId === c.documentId;
+          return (
+            <li key={key}>
+              <button
+                type="button"
+                onClick={() => onActivate(c, key)}
+                title={`Open "${c.documentTitle}"`}
+                style={{
+                  display: 'block',
+                  width: '100%',
+                  textAlign: 'left',
+                  padding: '8px 10px',
+                  background: isSelected ? palette.border : palette.panel,
+                  color: palette.text,
+                  border: `1px solid ${palette.border}`,
+                  borderLeft: `3px solid ${palette.accent}`,
+                  borderRadius: '4px',
+                  cursor: 'pointer',
+                  fontSize: '12px',
+                  lineHeight: 1.5,
+                  overflowWrap: 'anywhere',
+                }}
+              >
+                <span style={{ fontWeight: 600 }}>{c.documentTitle}</span>
+                <span style={{ color: palette.muted }}> · chunk {c.chunkIndex}</span>
+                {isSelected && <span style={{ color: palette.muted }}> · open</span>}
+                <span style={{ display: 'block', marginTop: '2px', color: '#c0c0e0', whiteSpace: 'pre-wrap' }}>
+                  “{c.excerpt}”
+                </span>
+                {isMissing && (
+                  <span style={{ display: 'block', marginTop: '4px', color: palette.error }}>
+                    This document is no longer available.
+                  </span>
+                )}
+              </button>
+            </li>
+          );
+        })}
+      </ul>
+    </div>
+  );
+}
+
+function Exchange({
+  item,
+  index,
+  total,
+  selectedDocId,
+  unavailable,
+  onActivate,
+}: {
+  item: QAHistory;
+  index: number;
+  total: number;
+  selectedDocId: string | null;
+  unavailable: Set<string>;
+  onActivate: (citation: Citation, key: string) => void;
+}) {
+  const { response } = item;
+  const confidence = describeConfidence(response.confidence);
+  return (
+    <article
+      aria-label={`Exchange ${index + 1} of ${total}`}
+      style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}
+    >
+      <UserTurn question={item.question} />
+      <div style={{
+        alignSelf: 'stretch',
+        minWidth: 0,
+        padding: '12px 14px',
+        background: palette.card,
+        border: `1px solid ${palette.border}`,
+        borderRadius: '8px 8px 8px 2px',
+      }}>
+        <div style={{ display: 'flex', flexWrap: 'wrap', gap: '4px 12px', alignItems: 'baseline', ...turnLabel }}>
+          <span>Assistant</span>
+          <time
+            dateTime={response.timestamp}
+            style={{ textTransform: 'none', letterSpacing: 0, fontWeight: 400 }}
+          >
+            {formatTimestamp(response.timestamp)}
+          </time>
+          <span style={{ textTransform: 'none', letterSpacing: 0, fontWeight: 400 }}>
+            <span
+              aria-hidden="true"
+              style={{
+                display: 'inline-block',
+                width: '40px',
+                height: '6px',
+                marginRight: '6px',
+                background: palette.border,
+                borderRadius: '3px',
+                overflow: 'hidden',
+                verticalAlign: 'middle',
+              }}
+            >
+              <span style={{
+                display: 'block',
+                width: `${confidence.percent}%`,
+                height: '100%',
+                background: palette.accent,
+              }} />
+            </span>
+            Confidence: {confidence.level} ({confidence.percent}%)
+          </span>
+        </div>
+        <div style={textBlock}>{response.answer}</div>
+        <CitationList
+          citations={response.citations}
+          exchangeIndex={index}
+          selectedDocId={selectedDocId}
+          unavailable={unavailable}
+          onActivate={onActivate}
+        />
+      </div>
+    </article>
+  );
+}
+
+export function ConversationView({
+  history,
+  loadState,
+  pendingQuestion,
+  askError,
+  documentCount,
+  selectedDocId,
+  onOpenCitation,
+  onRetry,
+  onDismissError,
+  onReloadHistory,
+  onClear,
+}: Props) {
+  const scrollRef = useRef<HTMLDivElement>(null);
+  const clearButtonRef = useRef<HTMLButtonElement>(null);
+  const cancelButtonRef = useRef<HTMLButtonElement>(null);
+  const [confirmingClear, setConfirmingClear] = useState(false);
+  const [clearFailed, setClearFailed] = useState(false);
+  const [unavailable, setUnavailable] = useState<Set<string>>(() => new Set());
+
+  const busy = pendingQuestion !== null;
+
+  // Keep the newest exchange in view whenever a turn is added, resolved or fails.
+  useEffect(() => {
+    const el = scrollRef.current;
+    if (el) el.scrollTop = el.scrollHeight;
+  }, [history.length, pendingQuestion, askError, loadState]);
+
+  // Citation indices shift when history is cleared; drop stale "unavailable" marks.
+  useEffect(() => {
+    if (history.length === 0) setUnavailable(new Set());
+  }, [history.length]);
+
+  useEffect(() => {
+    if (confirmingClear) cancelButtonRef.current?.focus();
+  }, [confirmingClear]);
+
+  const handleActivate = async (citation: Citation, key: string) => {
+    const found = await onOpenCitation(citation);
+    setUnavailable(prev => {
+      if (found === !prev.has(key)) return prev;
+      const next = new Set(prev);
+      if (found) next.delete(key);
+      else next.add(key);
+      return next;
+    });
+  };
+
+  const cancelClear = () => {
+    setConfirmingClear(false);
+    // Return focus to the control that opened the confirmation.
+    requestAnimationFrame(() => clearButtonRef.current?.focus());
+  };
+
+  const confirmClear = async () => {
+    const ok = await onClear();
+    setClearFailed(!ok);
+    setConfirmingClear(false);
+  };
+
+  const showEmpty = loadState === 'loaded' && history.length === 0 && !busy && !askError;
+
+  return (
+    <section
+      aria-labelledby="conversation-heading"
+      style={{ flex: 1, display: 'flex', flexDirection: 'column', minHeight: 0 }}
+    >
+      <div style={{
+        display: 'flex',
+        alignItems: 'center',
+        justifyContent: 'space-between',
+        flexWrap: 'wrap',
+        gap: '8px',
+        padding: '8px 20px',
+        background: palette.panel,
+        borderBottom: `1px solid ${palette.border}`,
+      }}>
+        <h2 id="conversation-heading" style={{ fontSize: '13px', fontWeight: 600 }}>
+          Conversation
+          <span style={{ color: palette.muted, fontWeight: 400 }}>
+            {' '}({history.length} {history.length === 1 ? 'exchange' : 'exchanges'})
+          </span>
+        </h2>
+        {confirmingClear ? (
+          <div role="group" aria-label="Confirm clearing the conversation" style={{ display: 'flex', alignItems: 'center', gap: '8px', fontSize: '12px' }}>
+            <span>Delete all {history.length} exchanges? This cannot be undone.</span>
+            <button ref={cancelButtonRef} type="button" onClick={cancelClear} style={smallButton}>
+              Cancel
+            </button>
+            <button
+              type="button"
+              onClick={confirmClear}
+              style={{ ...smallButton, background: palette.accent, border: 'none', color: '#fff' }}
+            >
+              Clear conversation
+            </button>
+          </div>
+        ) : (
+          <button
+            ref={clearButtonRef}
+            type="button"
+            onClick={() => setConfirmingClear(true)}
+            disabled={history.length === 0 || busy}
+            style={{
+              ...smallButton,
+              opacity: history.length === 0 || busy ? 0.5 : 1,
+              cursor: history.length === 0 || busy ? 'default' : 'pointer',
+            }}
+          >
+            Clear
+          </button>
+        )}
+      </div>
+
+      {clearFailed && (
+        <div role="alert" style={{ padding: '6px 20px', fontSize: '12px', color: palette.error }}>
+          Could not clear the conversation. Please try again.
+        </div>
+      )}
+
+      <div
+        ref={scrollRef}
+        style={{ flex: 1, overflowY: 'auto', overflowX: 'hidden', padding: '16px 20px' }}
+      >
+        {loadState === 'loading' && (
+          <div style={{ color: '#666', textAlign: 'center', paddingTop: '24px', fontSize: '13px' }}>
+            Loading conversation…
+          </div>
+        )}
+
+        {loadState === 'error' && (
+          <div role="alert" style={{ color: palette.error, textAlign: 'center', paddingTop: '24px', fontSize: '13px' }}>
+            Could not load the conversation history.{' '}
+            <button type="button" onClick={onReloadHistory} style={smallButton}>Try again</button>
+          </div>
+        )}
+
+        {showEmpty && (
+          <div style={{ color: '#888', textAlign: 'center', paddingTop: '32px', fontSize: '13px', lineHeight: 1.6 }}>
+            <div style={{ fontSize: '15px', color: palette.text, marginBottom: '6px' }}>No questions yet</div>
+            Ask a question below. Each answer will appear here with the sources it cites,
+            <br />
+            and the conversation is kept between sessions.
+            {documentCount === 0 && (
+              <div style={{ marginTop: '8px', color: palette.muted }}>
+                Tip: import and index documents first so answers can cite them.
+              </div>
+            )}
+          </div>
+        )}
+
+        <div role="log" aria-live="polite" aria-label="Conversation messages">
+          <ol style={{ listStyle: 'none', display: 'flex', flexDirection: 'column', gap: '20px' }}>
+            {history.map((item, i) => (
+              <li key={`${item.response.timestamp}-${i}`}>
+                <Exchange
+                  item={item}
+                  index={i}
+                  total={history.length}
+                  selectedDocId={selectedDocId}
+                  unavailable={unavailable}
+                  onActivate={handleActivate}
+                />
+              </li>
+            ))}
+
+            {pendingQuestion !== null && (
+              <li key="pending">
+                <article aria-label="Question awaiting an answer" aria-busy="true" style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}>
+                  <UserTurn question={pendingQuestion} />
+                  <div style={{
+                    padding: '12px 14px',
+                    background: palette.card,
+                    border: `1px dashed ${palette.border}`,
+                    borderRadius: '8px 8px 8px 2px',
+                  }}>
+                    <div style={turnLabel}>Assistant</div>
+                    <div style={{ ...textBlock, color: palette.muted, fontStyle: 'italic' }}>Answering…</div>
+                  </div>
+                </article>
+              </li>
+            )}
+
+            {askError !== null && (
+              <li key="error">
+                <article aria-label="Question that could not be answered" style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}>
+                  <UserTurn question={askError.question} />
+                  <div role="alert" style={{
+                    padding: '12px 14px',
+                    background: palette.card,
+                    border: `1px solid ${palette.error}`,
+                    borderRadius: '8px 8px 8px 2px',
+                  }}>
+                    <div style={{ ...turnLabel, color: palette.error }}>Not answered</div>
+                    <div style={{ fontSize: '13px', lineHeight: 1.5 }}>
+                      The question could not be answered.
+                    </div>
+                    <div style={{ fontSize: '12px', color: palette.muted, marginTop: '4px', overflowWrap: 'anywhere' }}>
+                      Details: {askError.message}
+                    </div>
+                    <div style={{ display: 'flex', gap: '8px', marginTop: '10px' }}>
+                      <button
+                        type="button"
+                        onClick={() => onRetry(askError.question)}
+                        disabled={busy}
+                        style={{ ...smallButton, background: palette.accent, border: 'none', color: '#fff' }}
+                      >
+                        Retry
+                      </button>
+                      <button type="button" onClick={onDismissError} style={smallButton}>
+                        Dismiss
+                      </button>
+                    </div>
+                  </div>
+                </article>
+              </li>
+            )}
+          </ol>
+        </div>
+      </div>
+    </section>
+  );
+}

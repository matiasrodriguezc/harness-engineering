+// Usage: phase2.mjs <mode> <KB> <OUT>
+// mode=restart: verify persisted conversation + long fixture; then Clear cancel/confirm.
+// mode=after-clear: verify empty state persists after restart.
+import fs from 'node:fs';
+import { connect } from './cdp.mjs';
+
+const [, , MODE, KB, OUT] = process.argv;
+const c = await connect();
+const results = [];
+const check = (id, name, ok, detail) => { results.push({ id, name, ok: !!ok, detail }); console.log(`${ok ? 'PASS' : 'FAIL'} [${id}] ${name} :: ${JSON.stringify(detail)}`); };
+await c.waitFor(`!!document.querySelector('#conversation-heading') && !document.body.innerText.includes('Loading conversation')`);
+await new Promise(r => setTimeout(r, 300));
+const file = () => JSON.parse(fs.readFileSync(`${KB}/qa-history.json`, 'utf8'));
+
+if (MODE === 'restart') {
+  const hist = file();
+  const screen = await c.evaluate(`[...document.querySelectorAll('[role=log] article[aria-label^="Exchange"]')].map(a => ({ q: a.firstElementChild.lastElementChild.textContent, dt: a.querySelector('time').getAttribute('datetime'), cites: [...a.querySelectorAll('ul button')].map(b => b.querySelector('span').textContent + '#' + b.querySelectorAll('span')[1].textContent.replace(/\\D/g, '')) }))`);
+  const same = screen.length === hist.length && hist.every((h, i) => screen[i].q === h.question && screen[i].dt === h.response.timestamp && screen[i].cites.join() === h.response.citations.map(x => x.documentTitle + '#' + x.chunkIndex).join());
+  check('AC-7', 'after restart: same count, order, timestamps, citations as qa-history.json', same, { screen: screen.length, file: hist.length });
+  // Long-answer fixture is the last exchange
+  const fixture = await c.evaluate(`(() => { const arts = [...document.querySelectorAll('[role=log] article[aria-label^="Exchange"]')]; const a = arts.find(x => x.textContent.includes('FIXTURE: long answer')); a.scrollIntoView({block:'start'}); const ans = [...a.querySelectorAll('div')].find(d => d.textContent.startsWith('Long answer sentence')); const sc = document.querySelector('[role=log]').parentElement; return { len: ans.textContent.length, endsWith: ans.textContent.slice(-12), hasEllipsis: ans.textContent.includes('...') || ans.textContent.includes('…'), ansFits: ans.scrollWidth <= ans.clientWidth, scFits: sc.scrollWidth <= sc.clientWidth, docFits: document.documentElement.scrollWidth <= document.documentElement.clientWidth }; })()`);
+  const fixtureFile = hist.find(h => h.question === 'FIXTURE: long answer').response.answer;
+  check('AC-3', 'long fixture answer rendered in full (>=1500 chars), wraps, no horizontal scroll', fixture.len === fixtureFile.length && fixture.len >= 1500 && !fixture.hasEllipsis && fixture.ansFits && fixture.scFits && fixture.docFits, fixture);
+  await c.screenshot(`${OUT}/13-restart-long-fixture.png`);
+
+  // Clear -> Cancel

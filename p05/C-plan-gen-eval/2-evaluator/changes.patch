+import {connect} from './cdp.mjs'; import fs from 'node:fs';
+const E=process.argv[2]; const R={}; const c=await connect();
+await c.waitFor(`document.querySelector('#conversation-heading')!==null`);
+await c.sleep(500);
+R.dataDirCheck='see ls';
+R.emptyText=await c.ev(`document.querySelector('main').innerText`);
+await c.shot(E+'/01-empty.png');
+// seed
+const repo='/Users/matiasrodriguezc/harness-runs/p05-plan-gen-eval';
+R.seed=await c.ev(`(async()=>{for(const f of ['design-notes.md','meeting-summary.txt','retrieval-plan.md']) await window.knowledgeBase.documents.import('${repo}/data/sample-documents/'+f); const s=await window.knowledgeBase.indexing.start(); return s;})()`);
+await c.click(`[...document.querySelectorAll('button')].find(b=>b.textContent.trim()==='Refresh')`);
+await c.sleep(400);
+R.docsHeader=await c.ev(`[...document.querySelectorAll('h2')].map(h=>h.textContent)`);
+fs.writeFileSync(E+'/p1.json',JSON.stringify({R,events:c.events},null,2)); console.log(JSON.stringify({R,events:c.events},null,2)); c.close();
diff --git a/docs/evidence/conversation-history/evaluator/scripts/p2.mjs b/docs/evidence/conversation-history/evaluator/scripts/p2.mjs
new file mode 100644
index 0000000..f436ff7
--- /dev/null
+++ b/docs/evidence/conversation-history/evaluator/scripts/p2.mjs
@@ -0,0 +1,99 @@
+import {connect} from './cdp.mjs'; import fs from 'node:fs';
+const E=process.argv[2], LOG=process.argv[3]; const R={}; const c=await connect();
+const askCount=()=>fs.readFileSync(LOG,'utf8').split('\n').filter(l=>l.includes('"ASK_QUESTION"')||l.includes('ASK_QUESTION')).length;
+const nEx=`document.querySelectorAll('[role=log] ol > li article[aria-label^="Exchange"]').length`;
+const step=async(name,fn)=>{try{R[name]=await fn();}catch(e){R[name]={ERROR:String(e)}}};
+await c.waitFor(`document.querySelector('[role=log] article')!==null`);
+await c.sleep(300);
+// Step 1: fixture
+await step('s1_fixture', async()=>c.ev(`(()=>{const a=document.querySelector('[role=log] article');const ans=[...a.querySelectorAll('div')].find(d=>d.textContent.startsWith('Long answer sentence')&&d.children.length===0);
+ const sc=document.querySelector('[role=log]').parentElement; return {len:ans.textContent.length, ellipsis:/…|\\.\\.\\.$/.test(ans.textContent), ansOverflow:ans.scrollWidth>ans.clientWidth, scroller:[sc.scrollWidth,sc.clientWidth], doc:[document.documentElement.scrollWidth,document.documentElement.clientWidth], body:[document.body.scrollWidth, document.body.clientWidth]}})()`));
+await c.shot(E+'/02-fixture.png');
+// Step 2: ask Q1, check pending immediately
+const ask=async q=>{await c.click(`document.querySelector('#question-input')`); await c.type(q); await c.key('Enter');};
+let before=askCount();
+await ask('How does the indexing pipeline chunk documents?');
+await step('s2_pending', async()=>c.ev(`(()=>{const p=document.querySelector('article[aria-busy=true]');return p?{text:p.innerText, btn:document.querySelector('form button').textContent, input:document.querySelector('#question-input').value}:null})()`));
+await c.shot(E+'/03-pending.png');
+await c.waitFor(`!document.querySelector('article[aria-busy=true]')`);
+await c.sleep(200);
+await step('s2_answer', async()=>c.ev(`(()=>{const arts=[...document.querySelectorAll('[role=log] article')];const a=arts.at(-1);return {count:arts.length, text:a.innerText, time:a.querySelector('time')?.textContent, dt:a.querySelector('time')?.getAttribute('datetime'), cites:[...a.querySelectorAll('li button')].map(b=>b.innerText)}})()`));
+R.s2_askDelta=askCount()-before;
+await c.shot(E+'/04-first-answer.png');
+// Step 3: double submit
+const snapshotFirst=await c.ev(`[...document.querySelectorAll('[role=log] article')].map(a=>a.innerText)`);
+before=askCount();
+await ask('What did the meeting decide about retrieval?');
+await c.sleep(30);
+await c.type('second draft'); await c.key('Enter');
+await c.click(`document.querySelector('form button[type=submit]')`);
+await c.key('Enter');
+R.s3_duringPending=await c.ev(`({pending:!!document.querySelector('article[aria-busy=true]'), userTurns:[...document.querySelectorAll('[role=log] article')].length, input:document.querySelector('#question-input').value})`);
+await c.waitFor(`!document.querySelector('article[aria-busy=true]')`);
+await c.sleep(600);
+R.s3_askDelta=askCount()-before;
+const after=await c.ev(`[...document.querySelectorAll('[role=log] article')].map(a=>a.innerText)`);
+R.s4_count=after.length; R.s4_firstUnchanged=JSON.stringify(after.slice(0,snapshotFirst.length))===JSON.stringify(snapshotFirst);
+R.s4_dupQuestions=after.filter(t=>t.includes('What did the meeting decide')).length;
+await c.ev(`document.querySelector('#question-input').value`).then(v=>R.s3_inputAfter=v);
+await c.ev(`(()=>{const i=document.querySelector('#question-input');const s=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set;s.call(i,'');i.dispatchEvent(new Event('input',{bubbles:true}))})()`);
+await c.shot(E+'/05-two-exchanges.png');
+// Step 5: no citations
+await ask('xyzzy plugh'); await c.sleep(50);
+await c.waitFor(`!document.querySelector('article[aria-busy=true]')`); await c.sleep(200);
+R.s5=await c.ev(`(()=>{const a=[...document.querySelectorAll('[role=log] article')].at(-1);return {text:a.innerText, hasSourcesHeader:/Sources \\(/.test(a.innerText)}})()`);
+await c.shot(E+'/06-no-citations.png');
+// Step 6: autoscroll
+for(const q of ['What design pattern is used?','How does retrieval work?','Summarize the meeting notes','What is the search query flow?']){ await ask(q); await c.sleep(30); await c.waitFor(`!document.querySelector('article[aria-busy=true]')`); await c.sleep(150);}
+R.s6=await c.ev(`(()=>{const sc=document.querySelector('[role=log]').parentElement;const last=[...document.querySelectorAll('[role=log] article')].at(-1).getBoundingClientRect();const s=sc.getBoundingClientRect();return {scrollHeight:sc.scrollHeight,clientHeight:sc.clientHeight,scrollTop:sc.scrollTop,atBottom:Math.abs(sc.scrollHeight-sc.clientHeight-sc.scrollTop)<2,lastBottomVisible:last.bottom<=s.bottom+1,lastTopVisible:last.top>=s.top-1, lastHeight:last.height, viewport:s.height}})()`);
+await c.shot(E+'/07-autoscroll.png');
+// Step 6b: scroll up manually, ask again -> does it yank? (informational)
+// Step 7: click a citation from step 2 (exchange 2)
+await c.click(`document.querySelectorAll('[role=log] article')[1].querySelector('li button')`);
+await c.sleep(400);
+R.s7=await c.ev(`({detail:document.querySelector('section[aria-label="Selected document"] h2')?.textContent, cite:document.querySelectorAll('[role=log] article')[1].querySelector('li button').innerText})`);
+await c.shot(E+'/08-citation-click.png');
+// close doc
+await c.click(`document.querySelector('button[aria-label="Close document"]')`); await c.sleep(200);
+// Step 8: keyboard only. Start from body.
+await c.ev(`document.activeElement.blur()`);
+let tabs=0, path=[];
+for(;tabs<80;){ await c.key('Tab'); tabs++; const a=await c.ev(`(document.activeElement.id||document.activeElement.textContent.slice(0,30))`); path.push(a); if(a==='question-input')break;}
+R.s8_tabsToInput=tabs; R.s8_path=path.slice(0,15);
+await c.type('What design pattern is used?'); await c.key('Enter'); await c.sleep(30);
+await c.waitFor(`!document.querySelector('article[aria-busy=true]')`); await c.sleep(200);
+R.s8_focusAfterSubmit=await c.ev(`document.activeElement.id||document.activeElement.outerHTML.slice(0,80)`);
+// forward Tab count from input to a citation of the newest exchange
+let ft=0; for(;ft<120;){await c.key('Tab'); ft++; const inLast=await c.ev(`(()=>{const a=[...document.querySelectorAll('[role=log] article')].at(-1);return a.contains(document.activeElement)&&document.activeElement.tagName==='BUTTON'})()`); if(inLast)break;}
+R.s8_forwardTabsToNewestCitation=ft;
+// shift-tab path
+await c.click(`document.querySelector('#question-input')`);
+let bt=0; for(;bt<20;){await c.key('Tab',{shift:true}); bt++; const inLast=await c.ev(`(()=>{const a=[...document.querySelectorAll('[role=log] article')].at(-1);return a.contains(document.activeElement)&&document.activeElement.tagName==='BUTTON'})()`); if(inLast)break;}
+R.s8_shiftTabsToNewestCitation=bt;
+R.s8_focusStyle=await c.ev(`(()=>{const s=getComputedStyle(document.activeElement);return {outline:s.outlineStyle+' '+s.outlineWidth+' '+s.outlineColor, fv:document.activeElement.matches(':focus-visible')}})()`);
+await c.shot(E+'/09-keyboard-focus-citation.png');
+const citeTitle=await c.ev(`document.activeElement.querySelector('span').textContent`);
+await c.key('Enter'); await c.sleep(400);
+R.s8_enterOpened=await c.ev(`document.querySelector('section[aria-label="Selected document"] h2')?.textContent`)+' (expected '+citeTitle+')';
+await c.click(`document.querySelector('button[aria-label="Close document"]')`); await c.sleep(200);
+// Space activation
+await c.click(`document.querySelector('#question-input')`); await c.key('Tab',{shift:true});
+await c.key(' '); await c.sleep(400);
+R.s8_spaceOpened=await c.ev(`document.querySelector('section[aria-label="Selected document"] h2')?.textContent`);
+await c.shot(E+'/10-keyboard-opened.png');
+// Step 9: DOM semantics
+R.s9=await c.ev(`(()=>{const log=document.querySelector('[role=log]');const i=document.querySelector('#question-input');return {log:log.outerHTML.slice(0,90), list:log.firstElementChild.tagName, li:log.querySelector('ol>li>article')?.getAttribute('aria-label'), label:document.querySelector('label[for=question-input]')?.textContent.trim(), clickableDivs:[...document.querySelectorAll('div,span')].filter(d=>d.onclick||d.getAttribute('onclick')).length, citeTags:[...new Set([...log.querySelectorAll('li li > *')].map(e=>e.tagName))]}})()`);
+// Step 10: timestamps vs file
+R.s10_times=await c.ev(`[...document.querySelectorAll('[role=log] time')].map(t=>[t.getAttribute('datetime'),t.textContent])`);
+// Narrow window: horizontal overflow
+await c.send('Emulation.setDeviceMetricsOverride',{width:700,height:600,deviceScaleFactor:1,mobile:false});
+await c.sleep(300);
+R.narrow=await c.ev(`({doc:[document.documentElement.scrollWidth,document.documentElement.clientWidth], main:(()=>{const m=document.querySelector('main');return [m.scrollWidth,m.clientWidth]})()})`);
+await c.shot(E+'/11-narrow-700px.png');
+await c.send('Emulation.clearDeviceMetricsOverride');
+// long unbroken question
+await ask('a'.repeat(400)); await c.sleep(30); await c.waitFor(`!document.querySelector('article[aria-busy=true]')`); await c.sleep(200);
+R.longQuestion=await c.ev(`(()=>{const sc=document.querySelector('[role=log]').parentElement;return {scroller:[sc.scrollWidth,sc.clientWidth]}})()`);
+await c.shot(E+'/12-long-unbroken-question.png');
+R.events=c.events;
+fs.writeFileSync(E+'/p2.json',JSON.stringify(R,null,2)); console.log(JSON.stringify(R,null,2)); c.close();

   const cleaned = raw.replace(/^Error invoking remote method '[^']+':\s*/, '').trim();
   return cleaned || 'Unknown error';
 }
+
+/** A question whose answer failed. Kept until the user retries or dismisses it. */
+export interface AskError {
+  id: number;
+  question: string;
+  message: string;
+}
+
+/** Appends a failure. Earlier failures are never overwritten. */
+export function addAskError(errors: AskError[], error: AskError): AskError[] {
+  return [...errors, error];
+}
+
+/** Removes one failure (on retry or dismiss); other failures are kept. */
+export function removeAskError(errors: AskError[], id: number): AskError[] {
+  return errors.some(e => e.id === id) ? errors.filter(e => e.id !== id) : errors;
+}

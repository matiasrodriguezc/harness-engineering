+    await c.click(btn('Close'));
+  }
+
+  // ---- Defect 6: keyboard reach to the newest answer's citations ----
+  // Make sure the newest exchange has citations.
+  await ask('What did the meeting decide about retrieval?');
+  const newestHasCitations = await c.evaluate(`document.getElementById('latest-exchange').querySelectorAll('li button').length > 0`);
+  await c.evaluate(`document.getElementById('question-input').focus()`);
+  let presses = 0;
+  const inNewestCitation = `(() => { const a = document.activeElement; const l = document.getElementById('latest-exchange'); return !!(l && a.tagName === 'BUTTON' && l.contains(a)); })()`;
+  const path = [];
+  for (; presses < 40; ) {
+    const a = await c.evaluate(active);
+    if (a.text.trim() === 'Jump to latest answer') { await c.key('Enter'); presses++; path.push('Enter'); }
+    else { await c.key('Tab'); presses++; path.push('Tab'); }
+    if (await c.evaluate(inNewestCitation)) break;
+  }
+  const jumpVisible = await c.evaluate(`(() => { const b = ${btn('Jump to latest answer')}; return b ? b.getBoundingClientRect().width : -1; })()`);
+  check('D6', 'from the input, newest citation is reached in <= 4 key presses (was 18 forward Tabs)', newestHasCitations && presses <= 4, { presses, path });

@@ -0,0 +1,183 @@
+// Verifies the fixes for evaluator-rubric.md defects 1-6 and 8 against the running app.
+// usage: node --experimental-websocket fixes.mjs <phase:a|b> <repo> <dataDir> <logFile> <outDir>
+//   phase a: fresh data dir -> defects 1, 8, 2, 6, 5, 3
+//   phase b: app launched on a corrupted qa-history.json -> defect 4
+import fs from 'node:fs';
+import { connect } from './cdp.mjs';
+
+const [, , PHASE, REPO, DATA, LOG, OUT] = process.argv;
+const HIST = `${DATA}/qa-history.json`;
+const c = await connect();
+// Keep the page focused during Page.captureScreenshot so focus-only UI shows up in screenshots.
+await c.send('Emulation.setFocusEmulationEnabled', { enabled: true });
+const results = [];
+const check = (id, name, ok, detail) => {
+  results.push({ id, name, ok: !!ok, detail });
+  console.log(`${ok ? 'PASS' : 'FAIL'} [${id}] ${name} :: ${JSON.stringify(detail)}`);
+};
+const asks = () => fs.readFileSync(LOG, 'utf8').split('\n').filter(l => l.includes('"ASK_QUESTION"')).length;
+const exchanges = `document.querySelectorAll('[role=log] article[aria-label^="Exchange"]').length`;
+const failed = `[...document.querySelectorAll('[role=log] article[aria-label="Question that could not be answered"]')]`;
+const settled = `!document.querySelector('[aria-busy=true]')`;
+const active = `(() => { const a = document.activeElement; return { tag: a.tagName, id: a.id, text: (a.innerText || '').slice(0, 60), label: a.getAttribute('aria-label') }; })()`;
+const ask = async q => {
+  await c.evaluate(`document.getElementById('question-input').focus()`);
+  await c.type(q);
+  await c.key('Enter');
+  await c.waitFor(settled);
+};
+const btn = text => `[...document.querySelectorAll('button')].find(b => b.textContent.trim() === ${JSON.stringify(text)})`;
+const sleep = ms => new Promise(r => setTimeout(r, ms));
+
+await c.waitFor(`!!document.querySelector('#conversation-heading') && !document.body.innerText.includes('Loading conversation')`);
+
+if (PHASE === 'a') {
+  // Seed (§6.2)
+  await c.evaluate(`(async () => { for (const f of ['design-notes.md','meeting-summary.txt','retrieval-plan.md']) await window.knowledgeBase.documents.import('${REPO}/data/sample-documents/' + f); await window.knowledgeBase.indexing.start(); })()`);
+  await c.click(`[...document.querySelectorAll('header button')].find(b => b.textContent.trim() === 'Refresh')`);
+  await c.waitFor(`document.body.innerText.includes('Documents (3)')`);
+  await ask('How does the indexing pipeline chunk documents?');
+  await ask('What did the meeting decide about retrieval?');
+  await c.waitFor(`${exchanges} === 2`);
+
+  // ---- Defect 1: two consecutive failures keep both questions ----
+  const good = fs.readFileSync(HIST, 'utf8');
+  fs.writeFileSync(HIST, '{oops');
+  const a0 = asks();
+  await ask('How does retrieval work?');
+  await ask('Second failing question');
+  await c.waitFor(`${failed}.length === 2`);
+  const errs = await c.evaluate(`${failed}.map(a => a.querySelector('div').innerText)`);
+  check('D1', 'both failed questions remain visible after a second failure', errs.length === 2 && errs[0].includes('How does retrieval work?') && errs[1].includes('Second failing question'), { errs, askDelta: asks() - a0 });
+  await c.screenshot(`${OUT}/01-two-failures-kept.png`);
+
+  // ---- Defect 8: plain wording, technical details collapsed ----
+  const d8 = await c.evaluate(`(() => { const a = ${failed}[0]; const d = a.querySelector('details'); return { visible: a.innerText, open: d?.open, detailText: d?.querySelector('div')?.textContent }; })()`);
+  check('D8', 'error turn shows plain wording; raw error only inside a closed <details>', d8.open === false && !d8.visible.includes('SyntaxError') && d8.visible.includes('Technical details') && /SyntaxError/.test(d8.detailText || ''), d8);
+  await c.click(`${failed}[0].querySelector('summary')`);
+  const d8open = await c.evaluate(`${failed}[0].querySelector('details').open`);
+  check('D8', 'details disclosure opens on click', d8open === true, {});
+  await c.screenshot(`${OUT}/02-error-details-open.png`);
+
+  // A new successful ask after failures must not discard them either.
+  fs.writeFileSync(HIST, good);
+  await ask('Third question after failures');
+  await c.waitFor(`${exchanges} === 3`);
+  const afterNewAsk = await c.evaluate(`${failed}.map(a => a.querySelector('div').innerText)`);
+  check('D1', 'a new successful ask keeps both failed questions', afterNewAsk.length === 2, { afterNewAsk });
+
+  // Retry the first failure: it becomes an exchange; the second failure stays.
+  await c.click(`${failed}[0].querySelector('button')`); // Retry
+  await c.waitFor(settled);
+  await c.waitFor(`${exchanges} === 4`);
+  const afterRetry = await c.evaluate(`({ errs: ${failed}.map(a => a.querySelector('div').innerText), lastQ: [...document.querySelectorAll('[role=log] article[aria-label^="Exchange"]')].pop().querySelector('div').innerText })`);
+  check('D1', 'retry answers only the retried question; other failure kept', afterRetry.errs.length === 1 && afterRetry.errs[0].includes('Second failing question') && afterRetry.lastQ.includes('How does retrieval work?'), afterRetry);
+  await c.click(`${failed}[0].querySelectorAll('button')[1]`); // Dismiss
+  await c.waitFor(`${failed}.length === 0`);
+  check('D1', 'dismiss removes the remaining failure', true, {});
+  await c.screenshot(`${OUT}/03-after-retry-and-dismiss.png`);
+
+  // ---- Defect 2: citation to a document deleted without Refresh ----
+  const target = await c.evaluate(`(async () => {
+    const btn = [...document.querySelectorAll('[role=log] article[aria-label^="Exchange"] li button')][0];
+    const title = btn.querySelector('span').textContent;
+    const docs = await window.knowledgeBase.documents.list();
+    return { title, id: docs.find(d => d.title === title)?.id };
+  })()`);
+  // Open it first so it is the selected document, then delete it behind the UI's back.
+  await c.click(`[...document.querySelectorAll('[role=log] article[aria-label^="Exchange"] li button')][0]`);
+  await c.waitFor(`!!document.querySelector('section[aria-label="Selected document"]')`);
+  await c.evaluate(`window.knowledgeBase.documents.delete(${JSON.stringify(target.id)})`);
+  const listedBefore = await c.evaluate(`document.body.innerText.match(/Documents \\((\\d+)\\)/)[1]`);
+  await c.click(`[...document.querySelectorAll('[role=log] article[aria-label^="Exchange"] li button')][0]`);
+  await c.waitFor(`document.body.innerText.includes('This document is no longer available.')`);
+  await c.waitFor(`document.body.innerText.includes('Documents (2)')`);
+  const d2 = await c.evaluate(`({ detailOpen: !!document.querySelector('section[aria-label="Selected document"]'), docsHeader: document.body.innerText.match(/Documents \\(\\d+\\)/)[0] })`);

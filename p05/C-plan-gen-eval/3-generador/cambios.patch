+
+  // ---- Defect 5: Escape cancels the Clear confirmation ----
+  const n = await c.evaluate(exchanges);
+  await c.click(btn('Clear'));
+  await c.waitFor(`!!document.querySelector('[aria-label="Confirm clearing the conversation"]')`);
+  const focusInConfirm = await c.evaluate(active);
+  await c.key('Escape');
+  await sleep(100);
+  const d5 = await c.evaluate(`({ confirmOpen: !!document.querySelector('[aria-label="Confirm clearing the conversation"]'), count: ${exchanges}, focus: ${active} })`);
+  check('D5', 'Escape closes confirmation, keeps history, returns focus to Clear', !d5.confirmOpen && d5.count === n && d5.focus.text === 'Clear', { focusInConfirm, ...d5 });
+
+  // ---- Defect 3: focus after confirming Clear ----
+  await c.key('Enter'); // reopen via keyboard on the focused Clear button
+  await c.waitFor(`!!document.querySelector('[aria-label="Confirm clearing the conversation"]')`);
+  await c.key('Tab'); // Cancel -> Clear conversation
+  const onConfirm = await c.evaluate(active);
+  await c.key('Enter');
+  await c.waitFor(`${exchanges} === 0`);
+  await sleep(100);
+  const d3 = await c.evaluate(active);
+  const file = JSON.parse(fs.readFileSync(HIST, 'utf8'));
+  check('D3', 'after confirming Clear, focus is on the conversation heading (not BODY)', d3.id === 'conversation-heading', { onConfirm, after: d3, fileLength: file.length });
+  await c.screenshot(`${OUT}/06-after-clear-focus.png`);
+}
+
+if (PHASE === 'b') {
+  // ---- Defect 4: recovery from an unreadable history at startup ----
+  await c.waitFor(`document.body.innerText.includes('Could not load the conversation history')`);
+  const clearState = await c.evaluate(`(() => { const b = ${btn('Clear')}; return { disabled: b.disabled }; })()`);
+  check('D4', 'Clear is enabled in the load-error state', clearState.disabled === false, clearState);
+  await c.screenshot(`${OUT}/07-startup-corrupt-clear-enabled.png`);
+  await c.click(btn('Clear'));
+  await c.waitFor(`!!document.querySelector('[aria-label="Confirm clearing the conversation"]')`);
+  const msg = await c.evaluate(`document.querySelector('[aria-label="Confirm clearing the conversation"] span').textContent`);
+  await c.screenshot(`${OUT}/08-startup-corrupt-confirm.png`);
+  await c.click(btn('Clear conversation'));
+  await c.waitFor(`document.body.innerText.includes('No questions yet')`);
+  // Focus moves to the heading on the next frame (defect 3 fix); wait so typing isn't lost to the race.
+  await c.waitFor(`document.activeElement.id === 'conversation-heading'`);
+  const file = fs.readFileSync(HIST, 'utf8').trim();
+  check('D4', 'confirming Clear replaces the unreadable file and shows the empty state', file === '[]', { msg, file });
+  await ask('How does the indexing pipeline chunk documents?');
+  await c.waitFor(`${exchanges} === 1`);
+  check('D4', 'asking works again after recovery', JSON.parse(fs.readFileSync(HIST, 'utf8')).length === 1, {});
+  await c.screenshot(`${OUT}/09-after-recovery-ask.png`);
+}
+
+check('console', 'no exceptions or console errors', c.problems.filter(p => !/Content-Security-Policy/.test(p.text)).length === 0, c.problems);
+fs.writeFileSync(`${OUT}/results-${PHASE}.json`, JSON.stringify(results, null, 2));
+c.close();
+process.exit(results.every(r => r.ok) ? 0 : 1);

diff --git a/src/renderer/components/ConversationTurns.tsx b/src/renderer/components/ConversationTurns.tsx
new file mode 100644
index 0000000..ea322d1
--- /dev/null
+++ b/src/renderer/components/ConversationTurns.tsx
@@ -0,0 +1,277 @@
+import type { CSSProperties } from 'react';
+import { Citation, QAHistory } from '../../shared/types';
+import { AskError, describeConfidence, formatTimestamp } from './conversation-format';
+
+/** DOM id of the newest exchange; focused by the "Jump to latest answer" control. */
+export const LATEST_EXCHANGE_ID = 'latest-exchange';
+
+export const palette = {
+  panel: '#16213e',
+  card: '#1a1a3e',
+  border: '#0f3460',
+  accent: '#533483',
+  text: '#e0e0e0',
+  muted: '#8888bb',
+  error: '#d9534f',
+};
+
+export const smallButton: CSSProperties = {
+  padding: '4px 10px',
+  background: palette.border,
+  color: palette.text,
+  border: '1px solid #1a1a4e',
+  borderRadius: '4px',
+  cursor: 'pointer',
+  fontSize: '12px',
+};
+
+export const turnLabel: CSSProperties = {
+  fontSize: '11px',
+  fontWeight: 600,
+  textTransform: 'uppercase',
+  letterSpacing: '0.05em',
+  color: palette.muted,
+  marginBottom: '4px',
+};
+
+export const textBlock: CSSProperties = {
+  fontSize: '14px',
+  lineHeight: 1.6,
+  whiteSpace: 'pre-wrap',
+  overflowWrap: 'anywhere',
+};
+
+function citationKey(exchangeIndex: number, citationIndex: number): string {
+  return `${exchangeIndex}:${citationIndex}`;
+}
+
+export function UserTurn({ question }: { question: string }) {
+  return (
+    <div style={{
+      alignSelf: 'flex-end',
+      maxWidth: '85%',
+      minWidth: 0,
+      padding: '10px 14px',
+      background: palette.border,
+      borderRadius: '8px 8px 2px 8px',
+    }}>
+      <div style={turnLabel}>You</div>
+      <div style={textBlock}>{question}</div>
+    </div>
+  );
+}
+
+function CitationList({
+  citations,
+  exchangeIndex,
+  selectedDocId,
+  unavailable,
+  onActivate,
+}: {
+  citations: Citation[];
+  exchangeIndex: number;
+  selectedDocId: string | null;
+  unavailable: Set<string>;
+  onActivate: (citation: Citation, key: string) => void;
+}) {
+  if (citations.length === 0) {
+    return (
+      <div style={{ marginTop: '10px', fontSize: '12px', color: palette.muted, fontStyle: 'italic' }}>
+        No sources cited.
+      </div>
+    );
+  }
+
+  return (
+    <div style={{ marginTop: '12px' }}>
+      <div style={{ ...turnLabel, marginBottom: '6px' }}>Sources ({citations.length})</div>
+      <ul style={{ listStyle: 'none', display: 'flex', flexDirection: 'column', gap: '6px' }}>
+        {citations.map((c, i) => {
+          const key = citationKey(exchangeIndex, i);
+          const isMissing = unavailable.has(key);
+          const isSelected = selectedDocId === c.documentId;
+          return (
+            <li key={key}>
+              <button
+                type="button"
+                onClick={() => onActivate(c, key)}
+                title={`Open "${c.documentTitle}"`}
+                style={{
+                  display: 'block',
+                  width: '100%',
+                  textAlign: 'left',
+                  padding: '8px 10px',
+                  background: isSelected ? palette.border : palette.panel,
+                  color: palette.text,
+                  border: `1px solid ${palette.border}`,
+                  borderLeft: `3px solid ${palette.accent}`,
+                  borderRadius: '4px',
+                  cursor: 'pointer',
+                  fontSize: '12px',
+                  lineHeight: 1.5,
+                  overflowWrap: 'anywhere',
+                }}
+              >
+                <span style={{ fontWeight: 600 }}>{c.documentTitle}</span>
+                <span style={{ color: palette.muted }}> · chunk {c.chunkIndex}</span>
+                {isSelected && <span style={{ color: palette.muted }}> · open</span>}
+                <span style={{ display: 'block', marginTop: '2px', color: '#c0c0e0', whiteSpace: 'pre-wrap' }}>
+                  “{c.excerpt}”
+                </span>
+                {isMissing && (
+                  <span style={{ display: 'block', marginTop: '4px', color: palette.error }}>
+                    This document is no longer available.
+                  </span>
+                )}
+              </button>
+            </li>
+          );
+        })}
+      </ul>
+    </div>
+  );
+}
+
+export function Exchange({
+  item,
+  index,
+  total,
+  isLatest,
+  selectedDocId,
+  unavailable,
+  onActivate,
+}: {
+  item: QAHistory;
+  index: number;
+  total: number;
+  /** The newest exchange is the target of the "Jump to latest answer" control. */
+  isLatest: boolean;
+  selectedDocId: string | null;
+  unavailable: Set<string>;
+  onActivate: (citation: Citation, key: string) => void;
+}) {
+  const { response } = item;
+  const confidence = describeConfidence(response.confidence);
+  return (
+    <article
+      id={isLatest ? LATEST_EXCHANGE_ID : undefined}
+      tabIndex={isLatest ? -1 : undefined}
+      aria-label={`Exchange ${index + 1} of ${total}`}
+      style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}
+    >
+      <UserTurn question={item.question} />
+      <div style={{
+        alignSelf: 'stretch',
+        minWidth: 0,
+        padding: '12px 14px',
+        background: palette.card,
+        border: `1px solid ${palette.border}`,
+        borderRadius: '8px 8px 8px 2px',
+      }}>
+        <div style={{ display: 'flex', flexWrap: 'wrap', gap: '4px 12px', alignItems: 'baseline', ...turnLabel }}>
+          <span>Assistant</span>
+          <time
+            dateTime={response.timestamp}
+            style={{ textTransform: 'none', letterSpacing: 0, fontWeight: 400 }}
+          >
+            {formatTimestamp(response.timestamp)}
+          </time>
+          <span style={{ textTransform: 'none', letterSpacing: 0, fontWeight: 400 }}>
+            <span
+              aria-hidden="true"
+              style={{
+                display: 'inline-block',
+                width: '40px',
+                height: '6px',
+                marginRight: '6px',
+                background: palette.border,
+                borderRadius: '3px',
+                overflow: 'hidden',
+                verticalAlign: 'middle',
+              }}
+            >
+              <span style={{
+                display: 'block',
+                width: `${confidence.percent}%`,
+                height: '100%',
+                background: palette.accent,
+              }} />
+            </span>
+            Confidence: {confidence.level} ({confidence.percent}%)
+          </span>
+        </div>
+        <div style={textBlock}>{response.answer}</div>
+        <CitationList
+          citations={response.citations}
+          exchangeIndex={index}
+          selectedDocId={selectedDocId}
+          unavailable={unavailable}
+          onActivate={onActivate}
+        />
+      </div>
+    </article>
+  );
+}
+
+export function PendingTurn({ question }: { question: string }) {
+  return (
+    <article aria-label="Question awaiting an answer" aria-busy="true" style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}>
+      <UserTurn question={question} />
+      <div style={{
+        padding: '12px 14px',
+        background: palette.card,
+        border: `1px dashed ${palette.border}`,
+        borderRadius: '8px 8px 8px 2px',
+      }}>
+        <div style={turnLabel}>Assistant</div>
+        <div style={{ ...textBlock, color: palette.muted, fontStyle: 'italic' }}>Answering…</div>
+      </div>
+    </article>
+  );
+}
+
+export function FailedTurn({
+  error,
+  busy,
+  onRetry,
+  onDismiss,
+}: {
+  error: AskError;
+  busy: boolean;
+  onRetry: (error: AskError) => void;
+  onDismiss: (error: AskError) => void;
+}) {
+  return (
+    <article aria-label="Question that could not be answered" style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}>
+      <UserTurn question={error.question} />
+      <div role="alert" style={{
+        padding: '12px 14px',
+        background: palette.card,
+        border: `1px solid ${palette.error}`,
+        borderRadius: '8px 8px 8px 2px',
+      }}>
+        <div style={{ ...turnLabel, color: palette.error }}>Not answered</div>
+        <div style={{ fontSize: '13px', lineHeight: 1.5 }}>
+          Something went wrong and this question could not be answered. Your question is kept here so you can try it again.
+        </div>
+        <details style={{ fontSize: '12px', color: palette.muted, marginTop: '6px' }}>
+          <summary style={{ cursor: 'pointer' }}>Technical details</summary>
+          <div style={{ marginTop: '4px', overflowWrap: 'anywhere' }}>{error.message}</div>
+        </details>
+        <div style={{ display: 'flex', gap: '8px', marginTop: '10px' }}>
+          <button
+            type="button"
+            onClick={() => onRetry(error)}
+            disabled={busy}
+            style={{ ...smallButton, background: palette.accent, border: 'none', color: '#fff', opacity: busy ? 0.5 : 1 }}
+          >
+            Retry
+          </button>
+          <button type="button" onClick={() => onDismiss(error)} style={smallButton}>
+            Dismiss
+          </button>
+        </div>
+      </div>
+    </article>
+  );
+}

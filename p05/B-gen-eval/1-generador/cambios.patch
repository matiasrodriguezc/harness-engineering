+import { DocumentService } from '../src/services/document-service';
+import { QaService, toExcerpt } from '../src/services/qa-service';
+
+const SAMPLES = join(__dirname, '..', 'data', 'sample-documents');
+
+describe('QaService conversation history', () => {
+  let dir: string;
+  let persistence: PersistenceService;
+  let qa: QaService;
+
+  beforeEach(() => {
+    dir = mkdtempSync(join(tmpdir(), 'kb-qa-test-'));
+    persistence = new PersistenceService(dir);
+    qa = new QaService(persistence, new IndexingService(persistence));
+  });
+
+  afterEach(() => rmSync(dir, { recursive: true, force: true }));
+
+  it('starts empty', () => {
+    expect(qa.getConversation()).toEqual([]);
+  });
+
+  it('keeps every exchange in order with ids and timestamps', async () => {
+    const questions = ['first question', 'second question', 'third question'];
+    for (const q of questions) await qa.ask(q);
+
+    const conversation = qa.getConversation();
+    expect(conversation.map(e => e.question)).toEqual(questions);
+    expect(new Set(conversation.map(e => e.id)).size).toBe(3);
+    for (const e of conversation) {
+      expect(Number.isNaN(Date.parse(e.askedAt))).toBe(false);
+      expect(Date.parse(e.response.timestamp)).toBeGreaterThanOrEqual(Date.parse(e.askedAt));
+      expect(e.followUpOf).toBeNull();
+    }
+  });
+
+  it('persists across service instances (restart)', async () => {
+    await qa.ask('does this survive a restart?');
+    const restarted = new QaService(persistence);
+    expect(restarted.getConversation()).toHaveLength(1);
+  });
+
+  it('stores the full answer and citations without truncation', async () => {
+    const docs = new DocumentService(persistence);
+    docs.importDocument(join(SAMPLES, 'design-notes.md'));
+    docs.importDocument(join(SAMPLES, 'retrieval-plan.md'));
+    await new IndexingService(persistence).startIndexing();
+
+    const response = await qa.ask('How does the architecture design work?');
+    const [exchange] = qa.getConversation();
+    expect(response.citations.length).toBeGreaterThan(0);
+    expect(exchange.response).toEqual(response);
+    expect(exchange.response.citations[0].documentTitle).not.toBe('Unknown Document');
+  });
+
+  it('uses the parent question as retrieval context for follow-ups', async () => {
+    const docs = new DocumentService(persistence);
+    docs.importDocument(join(SAMPLES, 'retrieval-plan.md'));
+    await new IndexingService(persistence).startIndexing();
+
+    await qa.ask('Explain the retrieval chunk ranking');
+    const parentId = qa.getConversation()[0].id;
+
+    const standalone = await qa.ask('Why?');
+    const followUp = await qa.ask('Why?', parentId);
+
+    expect(standalone.citations).toHaveLength(0);
+    expect(followUp.citations.length).toBeGreaterThan(0);
+    expect(qa.getConversation()[2].followUpOf).toBe(parentId);
+  });
+
+  it('answers standalone when the follow-up target does not exist', async () => {
+    await qa.ask('orphan follow-up', 'missing-id');
+    expect(qa.getConversation()[0].followUpOf).toBeNull();
+  });
+
+  it('rejects empty questions without touching history', async () => {
+    await expect(qa.ask('   ')).rejects.toThrow('non-empty');
+    expect(qa.getConversation()).toHaveLength(0);
+  });
+
+  it('normalizes legacy history entries that lack id/askedAt', () => {
+    persistence.writeJson('qa-history.json', [
+      { question: 'old', response: { answer: 'a', citations: [], confidence: 0.3, timestamp: '2026-01-02T03:04:05.000Z' } },
+    ]);
+    expect(qa.getConversation()[0]).toMatchObject({ id: 'legacy-0', askedAt: '2026-01-02T03:04:05.000Z', followUpOf: null });
+  });
+
+  it('clears the conversation', async () => {
+    await qa.ask('to be cleared');
+    qa.clearHistory();
+    expect(qa.getConversation()).toEqual([]);
+  });
+});
+
+describe('toExcerpt', () => {
+  it('keeps short text unchanged', () => {
+    expect(toExcerpt('short text')).toBe('short text');
+  });
+
+  it('cuts long text on a word boundary and marks the cut', () => {
+    const text = 'word '.repeat(100);
+    const excerpt = toExcerpt(text, 23);
+    expect(excerpt).toBe('word word word word…');
+  });
+});

+#!/usr/bin/env node
+/**
+ * End-to-end check of the multi-turn conversation UI in the real Electron app.
+ *
+ * Usage: npm run build && node --experimental-websocket scripts/verify-conversation.mjs
+ *
+ * Launches the built app with a throwaway --user-data-dir (your real app data is
+ * not touched), drives the renderer over the Chrome DevTools Protocol, asserts on
+ * the DOM, and writes screenshots to docs/verification/.
+ *
+ * Seeding note: the "+ Import" button in the starter is a no-op, so sample
+ * documents are imported through the same preload API the UI uses
+ * (window.knowledgeBase.documents.import / indexing.start).
+ */
+import { spawn } from 'node:child_process';
+import { mkdtempSync, writeFileSync, readFileSync, chmodSync, rmSync, mkdirSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join, resolve, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const shotsDir = join(root, 'docs', 'verification');
+const samples = join(root, 'data', 'sample-documents');
+const userDataDir = mkdtempSync(join(tmpdir(), 'kb-verify-'));
+const dataDir = join(userDataDir, 'knowledge-base-data');
+const PORT = 9333;
+const results = [];
+let electron;
+
+const sleep = ms => new Promise(r => setTimeout(r, ms));
+
+function check(name, ok, detail = '') {
+  results.push({ name, ok, detail });
+  console.log(`${ok ? 'PASS' : 'FAIL'}  ${name}${detail ? ` — ${detail}` : ''}`);
+}
+
+async function launch() {
+  electron = spawn(join(root, 'node_modules', '.bin', 'electron'), [
+    '.', `--remote-debugging-port=${PORT}`, `--user-data-dir=${userDataDir}`,
+  ], {
+    cwd: root,
+    stdio: ['ignore', 'pipe', 'pipe'],
+    // Electron refuses to start with some NODE_OPTIONS (e.g. --openssl-legacy-provider).
+    env: { ...process.env, NODE_OPTIONS: '' },
+  });
+  electron.logs = '';
+  electron.stdout.on('data', d => { electron.logs += d; });
+  electron.stderr.on('data', d => { electron.logs += d; });
+
+  for (let i = 0; i < 60; i++) {
+    try {
+      const targets = await (await fetch(`http://127.0.0.1:${PORT}/json`)).json();
+      const page = targets.find(t => t.type === 'page' && t.url.startsWith('file:'));
+      if (page) return connect(page.webSocketDebuggerUrl);
+    } catch { /* not up yet */ }
+    await sleep(250);
+  }
+  throw new Error('Electron did not expose a debuggable page');
+}
+
+async function connect(url) {
+  const ws = new WebSocket(url);
+  await new Promise((res, rej) => { ws.onopen = res; ws.onerror = rej; });
+  let id = 0;
+  const waiting = new Map();
+  ws.onmessage = ev => {
+    const msg = JSON.parse(ev.data);
+    if (msg.id && waiting.has(msg.id)) {
+      waiting.get(msg.id)(msg);
+      waiting.delete(msg.id);
+    }
+  };
+  const send = (method, params = {}) => new Promise(res => {
+    const msgId = ++id;
+    waiting.set(msgId, res);
+    ws.send(JSON.stringify({ id: msgId, method, params }));
+  });
+  const evaluate = async expression => {
+    const r = await send('Runtime.evaluate', { expression, awaitPromise: true, returnByValue: true });
+    if (r.result?.exceptionDetails) throw new Error(r.result.exceptionDetails.exception?.description ?? 'eval failed');
+    return r.result?.result?.value;
+  };
+  const waitFor = async (expression, timeout = 8000) => {
+    const end = Date.now() + timeout;
+    while (Date.now() < end) {
+      if (await evaluate(expression)) return true;
+      await sleep(100);
+    }
+    return false;
+  };
+  const screenshot = async name => {
+    const r = await send('Page.captureScreenshot', { format: 'png' });
+    writeFileSync(join(shotsDir, `${name}.png`), Buffer.from(r.result.data, 'base64'));
+  };
+  await send('Runtime.enable');
+  await send('Page.enable');
+  await send('Emulation.setFocusEmulationEnabled', { enabled: true });
+  await waitFor(`!!document.querySelector('#question-input')`);
+  return { evaluate, waitFor, screenshot, close: () => ws.close() };
+}
+
+let lastLogs = '';
+async function quit() {
+  if (!electron) return;
+  const proc = electron;
+  electron = null;
+  lastLogs += proc.logs;
+  if (proc.exitCode === null && proc.signalCode === null) {
+    const exited = new Promise(r => proc.once('exit', r));
+    proc.kill();
+    await exited;
+  }
+}
+
+// Helpers evaluated in the page.
+const ask = q => `(() => {
+  const input = document.querySelector('#question-input');
+  Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set.call(input, ${JSON.stringify(q)});
+  input.dispatchEvent(new Event('input', { bubbles: true }));
+  document.querySelector('form button[type=submit]').click();
+  return true;
+})()`;
+const count = `document.querySelectorAll('ol[role=log] article').length`;
+const clickButton = (text, scope = 'document') => `(() => {
+  const b = [...${scope}.querySelectorAll('button')].find(b => b.textContent.trim().startsWith(${JSON.stringify(text)}));
+  if (!b) return false; b.click(); return true;
+})()`;
+
+async function main() {
+  mkdirSync(shotsDir, { recursive: true });
+  let page = await launch();
+
+  // 1. Empty history
+  check('empty state shown when there is no history',
+    await page.evaluate(`document.body.innerText.includes('No questions yet') && ${count} === 0`));
+  await page.screenshot('01-empty');
+
+  // Seed documents (Import button is a pre-existing no-op).
+  await page.evaluate(`(async () => {
+    for (const f of ['design-notes.md', 'retrieval-plan.md', 'meeting-summary.txt'])
+      await window.knowledgeBase.documents.import(${JSON.stringify(samples)} + '/' + f);
+    await window.knowledgeBase.indexing.start();
+  })()`);
+  await page.evaluate(clickButton('Refresh'));
+  await page.waitFor(`document.body.innerText.includes('Documents (3)')`);
+
+  // 2. Several questions in a row
+  const questions = [
+    'How is the architecture designed?',
+    'What does the meeting summary say?',
+    'qwxz flurb?',
+  ];
+  for (let i = 0; i < questions.length; i++) {
+    await page.evaluate(ask(questions[i]));
+    check(`pending indicator while asking #${i + 1}`,
+      await page.waitFor(`document.body.innerText.includes('searching your documents')`, 2000));
+    await page.waitFor(`${count} === ${i + 1}`);
+  }
+  const shown = await page.evaluate(`[...document.querySelectorAll('ol[role=log] article h3')].map(h => h.textContent)`);
+  check('all questions shown in order', JSON.stringify(shown) === JSON.stringify(questions), JSON.stringify(shown));
+
+  const persisted = JSON.parse(readFileSync(join(dataDir, 'qa-history.json'), 'utf-8'));
+  const answersFull = await page.evaluate(`[...document.querySelectorAll('ol[role=log] article [id^=answer-]')].map(a => a.textContent)`);
+  check('answers shown in full (match persisted text)',
+    JSON.stringify(answersFull) === JSON.stringify(persisted.map(p => p.response.answer)));
+
+  // 3. Timestamps
+  const times = await page.evaluate(`[...document.querySelectorAll('ol[role=log] article time')].map(t => [t.textContent, t.getAttribute('datetime')])`);
+  check('each exchange shows question + answer timestamps', times.length === questions.length * 2 && times.every(([t, d]) => /^Today, /.test(t) && !isNaN(Date.parse(d))), JSON.stringify(times[0]));
+
+  // 4. Citations
+  const firstSources = await page.evaluate(`[...document.querySelectorAll('ol[role=log] article')[0].querySelectorAll('[id^=sources-] li')].map(li => li.innerText)`);
+  check('answer citations show document and excerpt', firstSources.length > 0 && firstSources.every(s => /chunk \d+/.test(s) && s.split('\n').length >= 2), JSON.stringify(firstSources[0]?.slice(0, 80)));
+  check('answer without citations is labelled',
+    await page.evaluate(`document.querySelectorAll('ol[role=log] article')[2].innerText.includes('No sources cited')`));
+  await page.screenshot('02-conversation');
+
+  await page.evaluate(clickButton('design-notes', `document.querySelectorAll('ol[role=log] article')[0]`)) ||
+    await page.evaluate(`document.querySelectorAll('ol[role=log] article')[0].querySelector('[id^=sources-] button').click() || true`);
+  check('clicking a citation opens the cited document',
+    await page.waitFor(`!!document.querySelector('section[aria-label="Document detail"] h2')`));
+  await page.screenshot('03-citation-opens-document');
+  await page.evaluate(clickButton('Close'));
+
+  // 5. Follow-up
+  await page.evaluate(clickButton('Follow up', `document.querySelectorAll('ol[role=log] article')[0]`));
+  check('follow-up context chip appears and input is focused',
+    await page.evaluate(`document.body.innerText.includes('Following up on') && document.activeElement.id === 'question-input'`));
+  await page.evaluate(ask('Why?'));
+  await page.waitFor(`${count} === 4`);
+  const fu = await page.evaluate(`(() => { const a = document.querySelectorAll('ol[role=log] article')[3]; return { text: a.innerText, sources: a.querySelectorAll('[id^=sources-] li').length }; })()`);
+  check('follow-up is linked to its parent and answered in context', fu.text.includes('Follow-up to') && fu.sources > 0, `sources=${fu.sources}`);
+
+  // 6. Copy
+  await page.evaluate(clickButton('Copy answer', `document.querySelectorAll('ol[role=log] article')[0]`));
+  await sleep(200);
+  const copyStatus = await page.evaluate(`document.querySelectorAll('ol[role=log] article')[0].querySelector('[role=status]').textContent`);
+  check('copy answer gives feedback', copyStatus === 'Copied', copyStatus);
+
+  // 7. Error + retry (make history file read-only so the service write fails)
+  const historyFile = join(dataDir, 'qa-history.json');
+  chmodSync(historyFile, 0o444);
+  await page.evaluate(ask('This one should fail'));
+  check('IPC error shown with retry', await page.waitFor(`!!document.querySelector('ol[role=log] [role=alert]') && document.body.innerText.includes('could not be answered')`));
+  await page.screenshot('04-error');
+  chmodSync(historyFile, 0o644);
+  await page.evaluate(clickButton('Retry'));
+  check('retry succeeds and error clears', await page.waitFor(`${count} === 5 && !document.querySelector('ol[role=log] [role=alert]')`));
+
+  // 8. Long answer (legacy-format entry written directly into history)
+  const history = JSON.parse(readFileSync(historyFile, 'utf-8'));
+  const longAnswer = Array.from({ length: 40 }, (_, i) => `Sentence ${i + 1} of a deliberately long answer used to check wrapping and expansion.`).join(' ');
+  history.push({ question: 'Legacy long answer', response: { answer: longAnswer, citations: [], confidence: 0.3, timestamp: '2025-03-04T10:00:00.000Z' } });
+  writeFileSync(historyFile, JSON.stringify(history));
+  await page.evaluate(clickButton('Refresh'));
+  await page.waitFor(`${count} === 6`);
+  const longCollapsed = await page.evaluate(`document.querySelectorAll('ol[role=log] article')[5].querySelector('[id^=answer-]').textContent.length`);
+  await page.evaluate(clickButton('Show full answer', `document.querySelectorAll('ol[role=log] article')[5]`));
+  const longExpanded = await page.evaluate(`document.querySelectorAll('ol[role=log] article')[5].querySelector('[id^=answer-]').textContent`);
+  check('long answer collapses and expands to full text', longCollapsed < longAnswer.length && longExpanded === longAnswer, `${longCollapsed} -> ${longExpanded.length}`);
+  const legacyTime = await page.evaluate(`document.querySelectorAll('ol[role=log] article')[5].querySelector('time').textContent`);
+  check('legacy entry gets a readable older-date timestamp', /2025/.test(legacyTime), legacyTime);
+  check('page does not scroll horizontally', await page.evaluate(`document.documentElement.scrollWidth <= document.documentElement.clientWidth`));
+  await page.screenshot('05-long-answer');
+
+  // 9. Sidebar history jumps to an exchange
+  await page.evaluate(clickButton('History'));
+  await page.evaluate(clickButton('1.', `document.querySelector('nav[aria-label="Past questions"]')`));
+  check('selecting a past question focuses that exchange',
+    await page.waitFor(`document.activeElement?.id?.startsWith('exchange-') && document.activeElement.querySelector('h3').textContent === ${JSON.stringify(questions[0])}`));
+  check('selected exchange is scrolled into view', await page.waitFor(`(() => {
+    const el = document.activeElement, box = el.closest('ol').parentElement.getBoundingClientRect(), r = el.getBoundingClientRect();
+    return r.top >= box.top - 1 && r.top < box.bottom;
+  })()`));
+  await page.screenshot('06-history-select');
+
+  // 10. Persistence across restart
+  page.close();
+  await quit();
+  page = await launch();
+  check('conversation persists across app restart', await page.waitFor(`${count} === 6`));
+
+  // 11. Clear with inline confirmation
+  await page.evaluate(clickButton('Clear conversation'));
+  await page.evaluate(clickButton('Clear', `document.querySelector('[role=group]')`));
+  check('clear conversation returns to empty state', await page.waitFor(`${count} === 0 && document.body.innerText.includes('No questions yet')`));
+
+  page.close();
+  await quit();
+
+  const logLines = lastLogs.split('\n').filter(l => l.startsWith('{'));
+  check('structured ASK_QUESTION / GET_CONVERSATION logs emitted',
+    logLines.some(l => l.includes('GET_CONVERSATION')));
+}
+
+main()
+  .catch(err => { check('script completed', false, String(err)); })
+  .finally(async () => {
+    await quit().catch(() => {});
+    rmSync(userDataDir, { recursive: true, force: true });
+    const failed = results.filter(r => !r.ok);
+    console.log(`\n${results.length - failed.length}/${results.length} checks passed`);
+    process.exitCode = failed.length ? 1 : 0;
+  });

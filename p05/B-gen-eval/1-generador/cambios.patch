new file mode 100644
index 0000000..1ee869e
--- /dev/null
+++ b/src/renderer/components/ExchangeItem.tsx
@@ -0,0 +1,253 @@
+import { useEffect, useRef, useState, type CSSProperties } from 'react';
+import { Citation, ConversationExchange } from '../../shared/types';
+import { formatFullTimestamp, formatTimestamp } from '../format';
+
+/** Answers longer than this start collapsed behind a "Show full answer" toggle. */
+const LONG_ANSWER_CHARS = 1200;
+
+export const bubbleBase: CSSProperties = {
+  padding: '10px 14px',
+  borderRadius: '10px',
+  fontSize: '14px',
+  lineHeight: 1.6,
+  whiteSpace: 'pre-wrap',
+  overflowWrap: 'anywhere',
+};
+
+export const userBubble: CSSProperties = {
+  ...bubbleBase,
+  alignSelf: 'flex-end',
+  maxWidth: '80%',
+  background: '#533483',
+  color: '#fff',
+  borderBottomRightRadius: '2px',
+};
+
+export const metaText: CSSProperties = { fontSize: '11px', color: '#9a9ac0' };
+
+export const smallButton: CSSProperties = {
+  padding: '3px 10px',
+  background: 'transparent',
+  color: '#c0c0e0',
+  border: '1px solid #2a3a6e',
+  borderRadius: '4px',
+  cursor: 'pointer',
+  fontSize: '12px',
+};
+
+interface Props {
+  exchange: ConversationExchange;
+  /** The exchange this one follows up on, when it is still in the history. */
+  parent: ConversationExchange | null;
+  highlighted: boolean;
+  isDocumentAvailable: (documentId: string) => boolean;
+  onOpenDocument: (documentId: string) => void;
+  onFollowUp: (exchange: ConversationExchange) => void;
+  onJumpTo: (exchangeId: string) => void;
+}
+
+export function ExchangeItem({
+  exchange,
+  parent,
+  highlighted,
+  isDocumentAvailable,
+  onOpenDocument,
+  onFollowUp,
+  onJumpTo,
+}: Props) {
+  const { response } = exchange;
+  const isLong = response.answer.length > LONG_ANSWER_CHARS;
+  const [expanded, setExpanded] = useState(false);
+  const [showSources, setShowSources] = useState(true);
+  const [copyStatus, setCopyStatus] = useState('');
+  const copyTimer = useRef<number | undefined>(undefined);
+  const answerId = `answer-${exchange.id}`;
+  const sourcesId = `sources-${exchange.id}`;
+  const confidencePct = Math.round(response.confidence * 100);
+  const lowConfidence = response.confidence < 0.5;
+
+  useEffect(() => () => window.clearTimeout(copyTimer.current), []);
+
+  const copyAnswer = async () => {
+    try {
+      await navigator.clipboard.writeText(response.answer);
+      setCopyStatus('Copied');
+    } catch {
+      setCopyStatus('Copy failed');
+    }
+    window.clearTimeout(copyTimer.current);
+    copyTimer.current = window.setTimeout(() => setCopyStatus(''), 2000);
+  };
+
+  return (
+    <article
+      id={`exchange-${exchange.id}`}
+      tabIndex={-1}
+      aria-labelledby={`question-${exchange.id}`}
+      style={{
+        display: 'flex',
+        flexDirection: 'column',
+        gap: '8px',
+        padding: '8px',
+        borderRadius: '8px',
+        outlineOffset: '2px',
+        background: highlighted ? 'rgba(83, 52, 131, 0.18)' : 'transparent',
+        transition: 'background 0.3s',
+      }}
+    >
+      {/* User question */}
+      <div style={{ alignSelf: 'flex-end', display: 'flex', flexDirection: 'column', alignItems: 'flex-end', gap: '4px', maxWidth: '80%' }}>
+        <div style={metaText}>
+          <span style={{ fontWeight: 600, color: '#c9b6ef' }}>You</span>
+          {' · '}
+          <time dateTime={exchange.askedAt} title={formatFullTimestamp(exchange.askedAt)}>
+            {formatTimestamp(exchange.askedAt)}
+          </time>
+        </div>
+        {exchange.followUpOf && (
+          <div style={metaText}>
+            {parent ? (
+              <button
+                type="button"
+                onClick={() => onJumpTo(parent.id)}
+                style={{ ...smallButton, border: 'none', padding: 0, color: '#9a9ac0', textDecoration: 'underline' }}
+                title="Jump to the earlier question"
+              >
+                ↪ Follow-up to “{truncate(parent.question, 60)}”
+              </button>
+            ) : (
+              <span>↪ Follow-up to an earlier question</span>
+            )}
+          </div>
+        )}
+        <h3 id={`question-${exchange.id}`} style={{ ...userBubble, maxWidth: '100%', fontWeight: 400, margin: 0 }}>
+          {exchange.question}
+        </h3>
+      </div>
+
+      {/* Assistant answer */}
+      <div style={{ alignSelf: 'flex-start', maxWidth: '88%', display: 'flex', flexDirection: 'column', gap: '4px' }}>
+        <div style={metaText}>
+          <span style={{ fontWeight: 600, color: '#8fb3ff' }}>Assistant</span>
+          {' · '}
+          <time dateTime={response.timestamp} title={formatFullTimestamp(response.timestamp)}>
+            {formatTimestamp(response.timestamp)}
+          </time>
+          {' · '}
+          <span
+            style={{ color: lowConfidence ? '#f0ad4e' : '#5cb85c' }}
+            title="How well the answer is supported by your indexed documents"
+          >
+            {lowConfidence ? 'Low confidence' : 'Confidence'} {confidencePct}%
+          </span>
+        </div>
+        <div
+          style={{
+            ...bubbleBase,
+            background: '#1a1a3e',
+            border: '1px solid #0f3460',
+            borderBottomLeftRadius: '2px',
+          }}
+        >
+          <div id={answerId}>
+            {isLong && !expanded ? `${response.answer.slice(0, LONG_ANSWER_CHARS).trimEnd()}…` : response.answer}
+          </div>
+          {isLong && (
+            <button
+              type="button"
+              aria-expanded={expanded}
+              aria-controls={answerId}
+              onClick={() => setExpanded(!expanded)}
+              style={{ ...smallButton, marginTop: '8px' }}
+            >
+              {expanded ? 'Show less' : `Show full answer (${response.answer.length.toLocaleString()} characters)`}
+            </button>
+          )}
+
+          {response.citations.length > 0 ? (
+            <div style={{ marginTop: '12px', borderTop: '1px solid #0f3460', paddingTop: '8px', whiteSpace: 'normal' }}>
+              <button
+                type="button"
+                aria-expanded={showSources}
+                aria-controls={sourcesId}
+                onClick={() => setShowSources(!showSources)}
+                style={{ ...smallButton, border: 'none', padding: 0, fontWeight: 600, color: '#8888bb' }}
+              >
+                {showSources ? '▾' : '▸'} Sources ({response.citations.length})
+              </button>
+              {showSources && (
+                <ol id={sourcesId} style={{ listStyle: 'none', margin: '6px 0 0', padding: 0, display: 'flex', flexDirection: 'column', gap: '6px' }}>
+                  {response.citations.map((citation, i) => (
+                    <CitationItem
+                      key={`${citation.documentId}-${citation.chunkIndex}-${i}`}
+                      number={i + 1}
+                      citation={citation}
+                      available={isDocumentAvailable(citation.documentId)}
+                      onOpen={() => onOpenDocument(citation.documentId)}
+                    />
+                  ))}
+                </ol>
+              )}
+            </div>
+          ) : (
+            <p style={{ marginTop: '10px', fontSize: '12px', fontStyle: 'italic', color: '#9a9ac0', whiteSpace: 'normal' }}>
+              No sources cited — no indexed document matched this question, so the answer is not grounded in your documents.
+            </p>
+          )}
+        </div>
+
+        <div style={{ display: 'flex', gap: '6px', alignItems: 'center' }}>
+          <button type="button" onClick={copyAnswer} style={smallButton} aria-label={`Copy answer to “${truncate(exchange.question, 60)}”`}>
+            Copy answer
+          </button>
+          <button type="button" onClick={() => onFollowUp(exchange)} style={smallButton} aria-label={`Ask a follow-up to “${truncate(exchange.question, 60)}”`}>
+            Follow up
+          </button>
+          <span role="status" style={metaText}>{copyStatus}</span>
+        </div>
+      </div>
+    </article>
+  );
+}
+
+function CitationItem({
+  number,
+  citation,
+  available,
+  onOpen,
+}: {
+  number: number;
+  citation: Citation;
+  available: boolean;
+  onOpen: () => void;
+}) {
+  const label = `${citation.documentTitle} · chunk ${citation.chunkIndex}`;
+  return (
+    <li style={{ paddingLeft: '8px', borderLeft: '2px solid #533483', fontSize: '12px' }}>
+      <div style={{ display: 'flex', gap: '6px', alignItems: 'baseline', flexWrap: 'wrap' }}>
+        <span style={{ color: '#8888bb' }}>[{number}]</span>
+        {available ? (
+          <button
+            type="button"
+            onClick={onOpen}
+            title="Open this document"
+            style={{ ...smallButton, border: 'none', padding: 0, color: '#8fb3ff', textDecoration: 'underline' }}
+          >
+            {label}
+          </button>
+        ) : (
+          <span style={{ color: '#8888bb' }}>
+            {label} <em>(document no longer available)</em>
+          </span>
+        )}
+      </div>
+      <blockquote style={{ margin: '4px 0 0', color: '#b0b0d0', whiteSpace: 'pre-wrap', overflowWrap: 'anywhere' }}>
+        {citation.excerpt}
+      </blockquote>
+    </li>
+  );
+}
+
+function truncate(text: string, max: number): string {
+  return text.length > max ? `${text.slice(0, max - 1)}…` : text;
+}

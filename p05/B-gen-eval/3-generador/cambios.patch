new file mode 100644
index 0000000..b1ea3d9
--- /dev/null
+++ b/src/shared/text.ts
@@ -0,0 +1,21 @@
+/** Pure text helpers shared by services and renderer (no Node or DOM APIs). */
+
+/**
+ * Shorten text to at most `max` characters, ending on a word boundary when one
+ * exists in the second half of the cut, and mark the cut with "…".
+ */
+export function truncateAtWord(text: string, max: number): string {
+  if (text.length <= max) return text;
+  const cut = text.slice(0, max);
+  const lastSpace = cut.search(/\s\S*$/);
+  return `${(lastSpace > max / 2 ? cut.slice(0, lastSpace) : cut).trimEnd()}…`;
+}
+
+/** Turn a markdown-ish chunk into one readable line: drop heading/emphasis markers, collapse whitespace. */
+export function toPlainExcerptText(text: string): string {
+  return text
+    .replace(/^\s{0,3}#{1,6}\s+/gm, '')
+    .replace(/(\*\*|__)(.*?)\1/g, '$2')
+    .replace(/\s+/g, ' ')
+    .trim();
+}

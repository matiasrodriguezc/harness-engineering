+#!/usr/bin/env node
+/**
+ * End-to-end check of the multi-turn conversation UI in the real Electron app.
+ *
+ * Usage: npm run build && node --experimental-websocket scripts/verify-conversation.mjs
+ *
+ * Launches the built app with a throwaway --user-data-dir (your real app data is
+ * not touched), drives the renderer over the Chrome DevTools Protocol, asserts on
+ * the DOM, and writes screenshots to docs/verification/.
+ *
+ * Seeding note: the "+ Import" button in the starter is a no-op, so sample
+ * documents are imported through the same preload API the UI uses
+ * (window.knowledgeBase.documents.import / indexing.start).
+ */
+import { spawn } from 'node:child_process';
+import { mkdtempSync, writeFileSync, readFileSync, chmodSync, rmSync, mkdirSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join, resolve, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const shotsDir = join(root, 'evaluation');
+const samples = join(root, 'data', 'sample-documents');
+const userDataDir = mkdtempSync(join(tmpdir(), 'kb-verify-'));
+const dataDir = join(userDataDir, 'knowledge-base-data');
+const PORT = 9333;
+const results = [];
+let electron;
+
+const sleep = ms => new Promise(r => setTimeout(r, ms));
+
+function check(name, ok, detail = '') {
+  results.push({ name, ok, detail });
+  console.log(`${ok ? 'PASS' : 'FAIL'}  ${name}${detail ? ` — ${detail}` : ''}`);
+}
+
+async function launch() {
+  electron = spawn(join(root, 'node_modules', '.bin', 'electron'), [
+    '.', `--remote-debugging-port=${PORT}`, `--user-data-dir=${userDataDir}`,
+  ], {
+    cwd: root,
+    stdio: ['ignore', 'pipe', 'pipe'],
+    // Electron refuses to start with some NODE_OPTIONS (e.g. --openssl-legacy-provider).
+    env: { ...process.env, NODE_OPTIONS: '' },
+  });
+  electron.logs = '';
+  electron.stdout.on('data', d => { electron.logs += d; });
+  electron.stderr.on('data', d => { electron.logs += d; });
+
+  for (let i = 0; i < 60; i++) {
+    try {
+      const targets = await (await fetch(`http://127.0.0.1:${PORT}/json`)).json();
+      const page = targets.find(t => t.type === 'page' && t.url.startsWith('file:'));
+      if (page) return connect(page.webSocketDebuggerUrl);
+    } catch { /* not up yet */ }
+    await sleep(250);
+  }
+  throw new Error('Electron did not expose a debuggable page');
+}
+
+async function connect(url) {
+  const ws = new WebSocket(url);
+  await new Promise((res, rej) => { ws.onopen = res; ws.onerror = rej; });
+  let id = 0;
+  const waiting = new Map();
+  ws.onmessage = ev => {
+    const msg = JSON.parse(ev.data);
+    if (msg.id && waiting.has(msg.id)) {
+      waiting.get(msg.id)(msg);
+      waiting.delete(msg.id);
+    }
+  };
+  const send = (method, params = {}) => new Promise(res => {
+    const msgId = ++id;
+    waiting.set(msgId, res);
+    ws.send(JSON.stringify({ id: msgId, method, params }));
+  });
+  const evaluate = async expression => {
+    const r = await send('Runtime.evaluate', { expression, awaitPromise: true, returnByValue: true });
+    if (r.result?.exceptionDetails) throw new Error(r.result.exceptionDetails.exception?.description ?? 'eval failed');
+    return r.result?.result?.value;
+  };
+  const waitFor = async (expression, timeout = 8000) => {
+    const end = Date.now() + timeout;
+    while (Date.now() < end) {
+      if (await evaluate(expression)) return true;
+      await sleep(100);
+    }
+    return false;
+  };
+  const screenshot = async name => {
+    const r = await send('Page.captureScreenshot', { format: 'png' });
+    writeFileSync(join(shotsDir, `${name}.png`), Buffer.from(r.result.data, 'base64'));
+  };
+  await send('Runtime.enable');
+  await send('Page.enable');
+  await send('Emulation.setFocusEmulationEnabled', { enabled: true });
+  await waitFor(`!!document.querySelector('#question-input')`);
+  return { evaluate, waitFor, screenshot, close: () => ws.close() };
+}
+
+let lastLogs = '';
+async function quit() {
+  if (!electron) return;
+  const proc = electron;
+  electron = null;
+  lastLogs += proc.logs;
+  if (proc.exitCode === null && proc.signalCode === null) {
+    const exited = new Promise(r => proc.once('exit', r));
+    proc.kill();
+    await exited;
+  }
+}
+
+// Helpers evaluated in the page.
+const ask = q => `(() => {
+  const input = document.querySelector('#question-input');
+  Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set.call(input, ${JSON.stringify(q)});
+  input.dispatchEvent(new Event('input', { bubbles: true }));
+  document.querySelector('form button[type=submit]').click();
+  return true;
+})()`;
+const count = `document.querySelectorAll('ol[role=log] article').length`;
+const clickButton = (text, scope = 'document') => `(() => {
+  const b = [...${scope}.querySelectorAll('button')].find(b => b.textContent.trim().startsWith(${JSON.stringify(text)}));
+  if (!b) return false; b.click(); return true;
+})()`;
+
+const key = async (page, k, code, extra = {}) => page.evaluate(`true`);
+async function main() {
+  mkdirSync(shotsDir, { recursive: true });
+  let page = await launch();
+  // CDP key helper
+  const press = async (k) => page.evaluate(`(() => { const e = document.activeElement; return e ? (e.id || e.tagName + ':' + (e.textContent||'').trim().slice(0,30)) : 'none'; })()`);
+  await page.evaluate(`(async () => {
+    for (const f of ['design-notes.md', 'retrieval-plan.md', 'meeting-summary.txt'])
+      await window.knowledgeBase.documents.import(${JSON.stringify(samples)} + '/' + f);
+    await window.knowledgeBase.indexing.start();
+  })()`);
+  await page.evaluate(clickButton('Refresh'));
+  await page.waitFor(`document.body.innerText.includes('Documents (3)')`);
+
+  // P1: Enter-key submission via real form submit (requestSubmit simulates Enter)
+  await page.evaluate(`(() => { const i = document.querySelector('#question-input'); i.focus();
+    Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set.call(i, 'How are documents indexed into chunks?');
+    i.dispatchEvent(new Event('input', { bubbles: true })); i.form.requestSubmit(); })()`);
+  await page.waitFor(`${count} === 1`);
+  check('P1 Enter submit works, focus stays in input', await page.evaluate(`document.activeElement.id === 'question-input'`));
+
+  // P2: very long unbroken question -> no horizontal overflow in thread
+  await page.evaluate(ask('x'.repeat(600) + ' index?'));
+  await page.waitFor(`${count} === 2`);
+  const ov = await page.evaluate(`(() => { const s = document.querySelector('ol[role=log]').parentElement; return [s.scrollWidth, s.clientWidth, document.documentElement.scrollWidth, document.documentElement.clientWidth]; })()`);
+  check('P2 long unbroken question does not overflow', ov[0] <= ov[1] && ov[2] <= ov[3], JSON.stringify(ov));
+
+  // P3: follow-up chain context (grandparent)
+  await page.evaluate(clickButton('Follow up', `document.querySelectorAll('ol[role=log] article')[0]`));
+  await page.evaluate(ask('and then?'));
+  await page.waitFor(`${count} === 3`);
+  await page.evaluate(clickButton('Follow up', `document.querySelectorAll('ol[role=log] article')[2]`));
+  await page.evaluate(ask('why?'));
+  await page.waitFor(`${count} === 4`);
+  const chain = await page.evaluate(`[...document.querySelectorAll('ol[role=log] article')].slice(2).map(a => a.querySelectorAll('[id^=sources-] li').length)`);
+  check('P3 follow-up of follow-up still grounded (grandparent context)', chain[1] > 0, JSON.stringify(chain));
+
+  // P4: Escape on clear-confirm; focus after Cancel
+  await page.evaluate(clickButton('Clear conversation'));
+  const afterCancel = await page.evaluate(`(() => { const b=[...document.querySelectorAll('[role=group] button')].find(b=>b.textContent==='Cancel'); b.click(); return new Promise(r=>setTimeout(()=>r(document.activeElement.tagName + '|' + document.activeElement.textContent.slice(0,30)),100)); })()`);
+  check('P4 focus after cancelling clear returns to a sensible control', !/^BODY/.test(afterCancel), afterCancel);
+
+  // P5: tab order includes citations/follow-up; ARIA validity of role=log on ol
+  const aria = await page.evaluate(`(() => { const ol=document.querySelector('ol[role=log]'); return { role: ol.getAttribute('role'), liParentRole: ol.getAttribute('role') }; })()`);
+  check('P5 thread keeps list semantics (ol not overridden by role=log)', aria.role !== 'log', JSON.stringify(aria));
+
+  // P6: citation click shows the cited chunk
+  await page.evaluate(`document.querySelectorAll('ol[role=log] article')[0].querySelector('[id^=sources-] button').click()`);
+  await page.waitFor(`!!document.querySelector('section[aria-label="Document detail"] h2')`);
+  await sleep(300);
+  const chunkShown = await page.evaluate(`(() => { const s=document.querySelector('section[aria-label="Document detail"]'); return /Chunk \\d+ \\(/.test(s.innerText); })()`);
+  check('P6 opening a citation reveals/highlights the cited chunk', chunkShown);
+  await page.screenshot('p6-citation');
+  await page.evaluate(clickButton('Close'));
+
+  // P7: narrow window 800x600 (minWidth)
+  await page.evaluate(`true`);
+  // P8: clear while pending
+  await page.evaluate(ask('What does the meeting summary say?'));
+  await sleep(20);
+  await page.evaluate(clickButton('Clear conversation'));
+  await page.evaluate(clickButton('Clear', `document.querySelector('[role=group]')`));
+  await sleep(1200);
+  const afterClearPending = await page.evaluate(`${count}`);
+  check('P8 clearing while a question is pending leaves an empty conversation', afterClearPending === 0, `exchanges after=${afterClearPending}`);
+  await page.screenshot('p8-clear-pending');
+
+  // P9: many exchanges (300) render time
+  const hist = [];
+  for (let i = 0; i < 300; i++) hist.push({ id: 'bulk-' + i, question: 'Bulk question ' + i, askedAt: new Date(Date.now() - (300-i)*60000).toISOString(), response: { answer: 'Answer ' + i, citations: [], confidence: 0.3, timestamp: new Date().toISOString() } });
+  writeFileSync(join(dataDir, 'qa-history.json'), JSON.stringify(hist));
+  const t0 = Date.now();
+  await page.evaluate(clickButton('Refresh'));
+  await page.waitFor(`${count} === 300`);
+  check('P9 300 exchanges render', true, `${Date.now() - t0}ms`);
+  const atBottom = await page.evaluate(`(() => { const s=document.querySelector('ol[role=log]').parentElement; return s.scrollHeight - s.scrollTop - s.clientHeight; })()`);
+  check('P9b thread scrolled to newest after load', atBottom < 5, `distance=${atBottom}`);
+
+  // P10: malformed entry (no response)
+  writeFileSync(join(dataDir, 'qa-history.json'), JSON.stringify([{ id: 'ok', question: 'good', askedAt: new Date().toISOString(), response: { answer: 'fine', citations: [], confidence: 0.3, timestamp: new Date().toISOString() } }, { question: 'broken entry' }]));
+  await page.evaluate(clickButton('Refresh'));
+  await sleep(500);
+  const mal = await page.evaluate(`({ n: ${count}, err: document.body.innerText.includes('Could not load'), text: (document.querySelector('[role=alert]')||{}).innerText })`);
+  check('P10 one malformed entry does not hide the whole history', mal.n >= 1, JSON.stringify(mal));
+  await page.screenshot('p10-malformed');
+
+  // P11: corrupt JSON then ask
+  writeFileSync(join(dataDir, 'qa-history.json'), '{not json');
+  await page.evaluate(clickButton('Refresh'));
+  await sleep(400);
+  const cor = await page.evaluate(`({ err: (document.querySelector('[role=alert]')||{}).innerText, n: ${count} })`);
+  check('P11 corrupt history shows a readable error', !!cor.err, JSON.stringify(cor));
+  await page.evaluate(ask('How is the architecture designed?'));
+  await sleep(1200);
+  const cor2 = await page.evaluate(`(document.querySelector('ol[role=log] [role=alert]')||{}).innerText`);
+  check('P11b asking with corrupt history gives actionable error', !!cor2 && !/Unexpected token|JSON/.test(cor2), JSON.stringify(cor2));
+  await page.screenshot('p11-corrupt');
+  check('P11c corrupt file untouched (no silent data loss)', readFileSync(join(dataDir, 'qa-history.json'), 'utf-8') === '{not json');
+
+  page.close();
+  await quit();
+}
+main()
+  .catch(err => { check('script completed', false, String(err)); })
+  .finally(async () => { await quit().catch(() => {}); rmSync(userDataDir, { recursive: true, force: true });
+    console.log(`\n${results.filter(r=>r.ok).length}/${results.length} probes passed`); });

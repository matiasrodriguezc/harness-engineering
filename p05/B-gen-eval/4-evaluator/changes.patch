+#!/usr/bin/env node
+/**
+ * End-to-end check of the multi-turn conversation UI in the real Electron app.
+ *
+ * Usage: npm run build && node --experimental-websocket evaluation/probe-round2.mjs
+ *
+ * Launches the built app with a throwaway --user-data-dir (your real app data is
+ * not touched), drives the renderer over the Chrome DevTools Protocol, asserts on
+ * the DOM, and writes screenshots to docs/verification/.
+ *
+ * Seeding note: the "+ Import" button in the starter is a no-op, so sample
+ * documents are imported through the same preload API the UI uses
+ * (window.knowledgeBase.documents.import / indexing.start).
+ */
+import { spawn } from 'node:child_process';
+import { mkdtempSync, writeFileSync, readFileSync, chmodSync, rmSync, mkdirSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join, resolve, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const shotsDir = join(root, 'evaluation', 'round2');
+const samples = join(root, 'data', 'sample-documents');
+const userDataDir = mkdtempSync(join(tmpdir(), 'kb-verify-'));
+const dataDir = join(userDataDir, 'knowledge-base-data');
+const PORT = 9333;
+const results = [];
+let electron;
+
+const sleep = ms => new Promise(r => setTimeout(r, ms));
+
+function check(name, ok, detail = '') {
+  results.push({ name, ok, detail });
+  console.log(`${ok ? 'PASS' : 'FAIL'}  ${name}${detail ? ` — ${detail}` : ''}`);
+}
+
+async function launch() {
+  electron = spawn(join(root, 'node_modules', '.bin', 'electron'), [
+    '.', `--remote-debugging-port=${PORT}`, `--user-data-dir=${userDataDir}`,
+  ], {
+    cwd: root,
+    stdio: ['ignore', 'pipe', 'pipe'],
+    // Electron refuses to start with some NODE_OPTIONS (e.g. --openssl-legacy-provider).
+    env: { ...process.env, NODE_OPTIONS: '' },
+  });
+  electron.logs = '';
+  electron.stdout.on('data', d => { electron.logs += d; });
+  electron.stderr.on('data', d => { electron.logs += d; });
+
+  for (let i = 0; i < 60; i++) {
+    try {
+      const targets = await (await fetch(`http://127.0.0.1:${PORT}/json`)).json();
+      const page = targets.find(t => t.type === 'page' && t.url.startsWith('file:'));
+      if (page) return connect(page.webSocketDebuggerUrl);
+    } catch { /* not up yet */ }
+    await sleep(250);
+  }
+  throw new Error('Electron did not expose a debuggable page');
+}
+
+async function connect(url) {
+  const ws = new WebSocket(url);
+  await new Promise((res, rej) => { ws.onopen = res; ws.onerror = rej; });
+  let id = 0;
+  const waiting = new Map();
+  ws.onmessage = ev => {
+    const msg = JSON.parse(ev.data);
+    if (msg.id && waiting.has(msg.id)) {
+      waiting.get(msg.id)(msg);
+      waiting.delete(msg.id);
+    }
+  };
+  const send = (method, params = {}) => new Promise(res => {
+    const msgId = ++id;
+    waiting.set(msgId, res);
+    ws.send(JSON.stringify({ id: msgId, method, params }));
+  });
+  const evaluate = async expression => {
+    const r = await send('Runtime.evaluate', { expression, awaitPromise: true, returnByValue: true });
+    if (r.result?.exceptionDetails) throw new Error(r.result.exceptionDetails.exception?.description ?? 'eval failed');
+    return r.result?.result?.value;
+  };
+  const waitFor = async (expression, timeout = 8000) => {
+    const end = Date.now() + timeout;
+    while (Date.now() < end) {
+      if (await evaluate(expression)) return true;
+      await sleep(100);
+    }
+    return false;
+  };
+  const screenshot = async name => {
+    const r = await send('Page.captureScreenshot', { format: 'png' });
+    writeFileSync(join(shotsDir, `${name}.png`), Buffer.from(r.result.data, 'base64'));
+  };
+  await send('Runtime.enable');
+  await send('Page.enable');
+  await send('Emulation.setFocusEmulationEnabled', { enabled: true });
+  await waitFor(`!!document.querySelector('#question-input')`);
+  return { evaluate, waitFor, screenshot, send, close: () => ws.close() };
+}
+
+let lastLogs = '';
+async function quit() {
+  if (!electron) return;
+  const proc = electron;
+  electron = null;
+  lastLogs += proc.logs;
+  if (proc.exitCode === null && proc.signalCode === null) {
+    const exited = new Promise(r => proc.once('exit', r));
+    proc.kill();
+    await exited;
+  }
+}
+
+// Helpers evaluated in the page.
+const ask = q => `(() => {
+  const input = document.querySelector('#question-input');
+  Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set.call(input, ${JSON.stringify(q)});
+  input.dispatchEvent(new Event('input', { bubbles: true }));
+  document.querySelector('form button[type=submit]').click();
+  return true;
+})()`;
+const count = `document.querySelectorAll('[role=log] ol article').length`;
+const clickButton = (text, scope = 'document') => `(() => {
+  const b = [...${scope}.querySelectorAll('button')].find(b => b.textContent.trim().startsWith(${JSON.stringify(text)}));
+  if (!b) return false; b.click(); return true;
+})()`;
+
+const key = async (page, k, code, extra = {}) => page.evaluate(`true`);
+const histFile = () => join(dataDir, 'qa-history.json');
+const alerts = `[...document.querySelectorAll('[role=alert]')].map(a => a.innerText)`;
+
+async function main() {
+  mkdirSync(shotsDir, { recursive: true });
+  let page = await launch();
+  await page.evaluate(`(async () => {
+    for (const f of ['design-notes.md', 'retrieval-plan.md', 'meeting-summary.txt'])
+      await window.knowledgeBase.documents.import(${JSON.stringify(samples)} + '/' + f);
+    await window.knowledgeBase.indexing.start();
+  })()`);
+  await page.evaluate(clickButton('Refresh'));
+  await page.waitFor(`document.body.innerText.includes('Documents (3)')`);
+
+  // R1: real double Enter (two CDP key events back to back) creates only one exchange
+  await page.evaluate(`(() => { const i = document.querySelector('#question-input'); i.focus();
+    Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set.call(i, 'How is the architecture designed?');
+    i.dispatchEvent(new Event('input', { bubbles: true })); })()`);
+  const enter = t => page.send('Input.dispatchKeyEvent', { type: t, key: 'Enter', code: 'Enter', windowsVirtualKeyCode: 13, text: t === 'keyDown' ? '\r' : undefined });
+  await Promise.all([enter('keyDown'), enter('keyUp'), enter('keyDown'), enter('keyUp')]);
+  await page.waitFor(`${count} >= 1`);
+  await page.waitFor(`!document.body.innerText.includes('searching your documents')`);
+  await sleep(800);
+  check('R1 double Enter creates one exchange', await page.evaluate(count) === 1, `n=${await page.evaluate(count)}`);
+
+  await page.evaluate(ask('What does the meeting summary say?'));
+  await page.waitFor(`${count} === 2`);
+  await page.waitFor(`!document.body.innerText.includes('searching your documents')`);
+  await sleep(300);
+
+  // R2: clear fails (history file read-only) -> user must see an error and conversation must remain
+  chmodSync(histFile(), 0o444);
+  await page.evaluate(clickButton('Clear conversation'));
+  await page.evaluate(clickButton('Clear', `document.querySelector('[role=group]')`));
+  await sleep(800);
+  const r2 = await page.evaluate(`({ n: ${count}, alerts: ${alerts} })`);
+  check('R2 failed clear is reported to the user', r2.alerts.length > 0, JSON.stringify(r2));
+  await page.screenshot('r2-clear-failed');
+
+  // R3: failed clear while a question is pending -> the pending question must not silently vanish
+  chmodSync(histFile(), 0o644);
+  await page.evaluate(ask('How are documents indexed into chunks?'));
+  await sleep(30);
+  chmodSync(histFile(), 0o444);
+  await page.evaluate(clickButton('Clear conversation'));
+  await page.evaluate(clickButton('Clear', `document.querySelector('[role=group]')`));
+  await sleep(1200);
+  chmodSync(histFile(), 0o644);
+  const onDisk = JSON.parse(readFileSync(histFile(), 'utf-8')).length;
+  const r3 = await page.evaluate(`({ n: ${count}, alerts: ${alerts}, pending: document.body.innerText.includes('searching your documents') })`);
+  check('R3 failed clear does not silently drop the pending question', r3.n === 3 || r3.alerts.length > 0, JSON.stringify({ ...r3, onDisk }));
+  await page.screenshot('r3-clear-failed-pending');
+
+  // R4: citation to a chunk that no longer exists shows a notice
+  const docs = await page.evaluate(`window.knowledgeBase.documents.list()`);
+  const hist = JSON.parse(readFileSync(histFile(), 'utf-8'));
+  hist.push({ id: 'stale-cite', question: 'stale citation', askedAt: new Date().toISOString(), response: { answer: 'x', confidence: 0.85, timestamp: new Date().toISOString(),
+    citations: [{ documentId: docs[0].id, documentTitle: docs[0].title, chunkIndex: 99, excerpt: 'gone' }] } });
+  writeFileSync(histFile(), JSON.stringify(hist));
+  await page.evaluate(clickButton('Refresh'));
+  await page.waitFor(`!!document.getElementById('exchange-stale-cite')`);
+  await page.evaluate(`document.querySelector('#exchange-stale-cite [id^=sources-] button').click()`);
+  await sleep(600);
+  const r4 = await page.evaluate(`(document.querySelector('section[aria-label="Document detail"] [role=status]')||{}).innerText`);
+  check('R4 citation to a missing chunk explains itself', !!r4, JSON.stringify(r4));
+  await page.screenshot('r4-missing-chunk');
+  await page.evaluate(`document.querySelector('section[aria-label="Document detail"] button[aria-label^=Close]').click()`);
+
+  // R5: stop-word-only standalone question ("why?") -> what does the user get?
+  await page.evaluate(ask('why?'));
+  await page.waitFor(`${count} === ${hist.length + 1}`);
+  const r5 = await page.evaluate(`[...document.querySelectorAll('[role=log] ol article')].pop().innerText`);
+  check('R5 stop-word question answer is not misleading', !/No relevant documents have been indexed yet/.test(r5), JSON.stringify(r5.slice(0, 220)));
+
+  // R6: sidebar History tab while load failed
+  writeFileSync(histFile(), '{bad');
+  await page.evaluate(clickButton('Refresh'));
+  await sleep(500);
+  await page.evaluate(clickButton('History'));
+  await sleep(200);
+  const r6 = await page.evaluate(`document.querySelector('aside').innerText`);
+  check('R6 sidebar History does not claim "no history" when loading failed', !/No conversation history yet/.test(r6), JSON.stringify(r6.slice(0, 160)));
+  await page.screenshot('r6-sidebar-corrupt');
+
+  // R7: after repairing the file and pressing Refresh, the error clears and exchanges come back
+  writeFileSync(histFile(), JSON.stringify(hist));
+  await page.evaluate(clickButton('Refresh'));
+  await sleep(500);
+  const r7 = await page.evaluate(`({ n: ${count}, alerts: ${alerts} })`);
+  check('R7 repair + Refresh recovers', r7.n === hist.length && r7.alerts.length === 0, JSON.stringify(r7));
+
+  // R8: keyboard reachability: Tab from input reaches Ask, and Shift+Tab path reaches a citation button
+  const r8 = await page.evaluate(`(() => { const f = [...document.querySelectorAll('[role=log] button, #question-input, form button')]; return f.every(b => b.tabIndex >= 0); })()`);
+  check('R8 all thread controls are in the tab order', r8);
+
+  page.close();
+  await quit();
+}
+main()
+  .catch(err => { check('script completed', false, String(err)); })
+  .finally(async () => { await quit().catch(() => {}); try { chmodSync(join(dataDir, 'qa-history.json'), 0o644); } catch {} rmSync(userDataDir, { recursive: true, force: true });
+    console.log(`\n${results.filter(r=>r.ok).length}/${results.length} probes passed`); });

diff --git a/src/services/feedback-service.ts b/src/services/feedback-service.ts
new file mode 100644
index 0000000..71ba4a2
--- /dev/null
+++ b/src/services/feedback-service.ts
@@ -0,0 +1,57 @@
+import { AnswerFeedback, FeedbackRating } from '../shared/types';
+import { PersistenceService } from './persistence-service';
+import { QaService } from './qa-service';
+import { logger } from './logger';
+
+const SERVICE = 'feedback-service';
+const FEEDBACK_FILE = 'feedback.json';
+
+export class FeedbackService {
+  private persistence: PersistenceService;
+  private qaService: QaService;
+
+  constructor(persistence: PersistenceService, qaService: QaService) {
+    this.persistence = persistence;
+    this.qaService = qaService;
+  }
+
+  /**
+   * Record a rating for an answer. Rating the same answer again replaces
+   * the previous rating. Throws if the rating is invalid or the answer id
+   * does not match any stored answer.
+   */
+  submit(answerId: string, rating: FeedbackRating): AnswerFeedback {
+    if (rating !== 'up' && rating !== 'down') {
+      logger.warn(SERVICE, 'Rejected invalid rating', { answerId, rating });
+      throw new Error(`Invalid rating: ${String(rating)}`);
+    }
+
+    const answerExists = this.qaService.getHistory().some(item => item.response.id === answerId);
+    if (!answerExists) {
+      logger.warn(SERVICE, 'Rejected feedback for unknown answer', { answerId });
+      throw new Error(`Unknown answer id: ${answerId}`);
+    }
+
+    const entries = this.list();
+    const entry: AnswerFeedback = {
+      answerId,
+      rating,
+      timestamp: new Date().toISOString(),
+    };
+    const existing = entries.findIndex(e => e.answerId === answerId);
+    if (existing === -1) {
+      entries.push(entry);
+    } else {
+      entries[existing] = entry;
+    }
+    this.persistence.writeJson(FEEDBACK_FILE, entries);
+
+    logger.info(SERVICE, 'Feedback recorded', { answerId, rating });
+    return entry;
+  }
+
+  /** List all recorded feedback, in the order it was first given. */
+  list(): AnswerFeedback[] {
+    return this.persistence.readJson<AnswerFeedback[]>(FEEDBACK_FILE) ?? [];
+  }
+}

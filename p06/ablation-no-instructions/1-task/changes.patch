@@ -0,0 +1,49 @@
+import { FeedbackEntry, FeedbackRating } from '../shared/types';
+import { PersistenceService } from './persistence-service';
+import { logger } from './logger';
+
+const SERVICE = 'feedback-service';
+export const FEEDBACK_FILE = 'feedback.json';
+
+const VALID_RATINGS: readonly FeedbackRating[] = ['up', 'down'];
+
+export class FeedbackService {
+  private persistence: PersistenceService;
+
+  constructor(persistence: PersistenceService) {
+    this.persistence = persistence;
+  }
+
+  /**
+   * Record a rating for an answer. One rating per answer: rating the same
+   * answer again replaces the previous rating.
+   */
+  submit(answerId: unknown, rating: unknown): FeedbackEntry {
+    if (typeof answerId !== 'string' || answerId.trim() === '') {
+      logger.warn(SERVICE, 'Rejected feedback: invalid answerId', { answerId: String(answerId) });
+      throw new Error('answerId must be a non-empty string');
+    }
+    if (typeof rating !== 'string' || !VALID_RATINGS.includes(rating as FeedbackRating)) {
+      logger.warn(SERVICE, 'Rejected feedback: invalid rating', { answerId, rating: String(rating) });
+      throw new Error("rating must be 'up' or 'down'");
+    }
+
+    const entry: FeedbackEntry = {
+      answerId,
+      rating: rating as FeedbackRating,
+      timestamp: new Date().toISOString(),
+    };
+
+    const entries = this.list().filter(e => e.answerId !== answerId);
+    entries.push(entry);
+    this.persistence.writeJson(FEEDBACK_FILE, entries);
+
+    logger.info(SERVICE, 'Feedback recorded', { answerId, rating: entry.rating });
+    return entry;
+  }
+
+  /** All stored ratings, oldest first. */
+  list(): FeedbackEntry[] {
+    return this.persistence.readJson<FeedbackEntry[]>(FEEDBACK_FILE) ?? [];
+  }
+}

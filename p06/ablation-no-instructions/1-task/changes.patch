@@ -0,0 +1,63 @@
+import { useState } from 'react';
+
+interface Props {
+  onReset: () => Promise<void>;
+}
+
+/** "Reset all data" with an in-page confirmation step. */
+export function ResetButton({ onReset }: Props) {
+  const [confirming, setConfirming] = useState(false);
+  const [busy, setBusy] = useState(false);
+
+  if (!confirming) {
+    return (
+      <button type="button" aria-label="Reset all data" onClick={() => setConfirming(true)} style={dangerOutline}>
+        Reset
+      </button>
+    );
+  }
+
+  return (
+    <div role="alertdialog" aria-label="Confirm reset" style={{ display: 'flex', alignItems: 'center', gap: '6px' }}>
+      <span style={{ fontSize: '12px', color: '#ffb3b0' }}>
+        Delete all documents, history and feedback?
+      </span>
+      <button
+        type="button"
+        disabled={busy}
+        onClick={async () => {
+          setBusy(true);
+          try {
+            await onReset();
+          } finally {
+            setBusy(false);
+            setConfirming(false);
+          }
+        }}
+        style={{ ...dangerOutline, background: '#d9534f', color: '#fff' }}
+      >
+        {busy ? 'Resetting…' : 'Yes, reset'}
+      </button>
+      <button type="button" autoFocus disabled={busy} onClick={() => setConfirming(false)} style={neutral}>
+        Cancel
+      </button>
+    </div>
+  );
+}
+
+const neutral: React.CSSProperties = {
+  padding: '6px 14px',
+  background: '#0f3460',
+  color: '#e0e0e0',
+  border: '1px solid #1a1a4e',
+  borderRadius: '4px',
+  cursor: 'pointer',
+  fontSize: '13px',
+};
+
+const dangerOutline: React.CSSProperties = {
+  ...neutral,
+  background: 'transparent',
+  color: '#ff8a80',
+  border: '1px solid #d9534f',
+};

diff --git a/tests/services.test.ts b/tests/services.test.ts
new file mode 100644
index 0000000..d800054
--- /dev/null
+++ b/tests/services.test.ts
@@ -0,0 +1,118 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { PersistenceService } from '../src/services/persistence-service';
+import { DocumentService } from '../src/services/document-service';
+import { IndexingService } from '../src/services/indexing-service';
+import { QaService } from '../src/services/qa-service';
+import { FeedbackService } from '../src/services/feedback-service';
+import { logger } from '../src/services/logger';
+
+const SAMPLES = path.resolve(__dirname, '..', 'data', 'sample-documents');
+
+let tmp: string;
+let dataDir: string;
+
+/** Build services the same way main.ts does; a fresh call simulates an app restart. */
+function boot() {
+  const persistence = new PersistenceService(dataDir);
+  const documents = new DocumentService(persistence);
+  const indexing = new IndexingService(persistence);
+  const qa = new QaService(persistence, indexing);
+  const feedback = new FeedbackService(persistence);
+  return { persistence, documents, indexing, qa, feedback };
+}
+
+beforeEach(() => {
+  tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'kb-test-'));
+  dataDir = path.join(tmp, 'knowledge-base-data');
+  for (const m of ['debug', 'info', 'warn', 'error'] as const) vi.spyOn(logger, m).mockImplementation(() => {});
+});
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  fs.rmSync(tmp, { recursive: true, force: true });
+});
+
+describe('answer ids', () => {
+  it('every answer has a unique string id that is kept in history', async () => {
+    const { qa } = boot();
+    const a = await qa.ask('what is the architecture?');
+    const b = await qa.ask('what is the architecture?');
+    expect(typeof a.id).toBe('string');
+    expect(a.id).not.toBe('');
+    expect(a.id).not.toBe(b.id);
+    expect(boot().qa.getHistory().map(h => h.response.id)).toEqual([a.id, b.id]);
+  });
+
+  it('assigns and persists ids for legacy history entries without one', () => {
+    const { persistence } = boot();
+    persistence.writeJson('qa-history.json', [
+      { question: 'old', response: { answer: 'x', citations: [], confidence: 0.3, timestamp: new Date().toISOString() } },
+    ]);
+    const first = boot().qa.getHistory()[0].response.id;
+    expect(typeof first).toBe('string');
+    expect(boot().qa.getHistory()[0].response.id).toBe(first);
+  });
+});
+
+describe('FeedbackService', () => {
+  it('submits and lists ratings with answerId, rating and timestamp', () => {
+    const { feedback } = boot();
+    feedback.submit('a1', 'up');
+    feedback.submit('a2', 'down');
+    const list = feedback.list();
+    expect(list.map(({ answerId, rating }) => ({ answerId, rating }))).toEqual([
+      { answerId: 'a1', rating: 'up' },
+      { answerId: 'a2', rating: 'down' },
+    ]);
+    for (const e of list) expect(Number.isNaN(Date.parse(e.timestamp))).toBe(false);
+  });
+
+  it('re-rating an answer replaces the previous rating', () => {
+    const { feedback } = boot();
+    feedback.submit('a1', 'up');
+    feedback.submit('a1', 'down');
+    expect(feedback.list()).toHaveLength(1);
+    expect(feedback.list()[0].rating).toBe('down');
+  });
+
+  it('rejects invalid ratings and answer ids', () => {
+    const { feedback } = boot();
+    expect(() => feedback.submit('a1', 'meh')).toThrow();
+    expect(() => feedback.submit('', 'up')).toThrow();
+    expect(() => feedback.submit(42, 'up')).toThrow();
+    expect(feedback.list()).toEqual([]);
+  });
+
+  it('persists across restarts', () => {
+    boot().feedback.submit('a1', 'up');
+    expect(boot().feedback.list()).toEqual([expect.objectContaining({ answerId: 'a1', rating: 'up' })]);
+  });
+});
+
+describe('reset all data', () => {
+  it('clears documents, chunks, history and feedback, and stays empty after restart', async () => {
+    const s = boot();
+    s.documents.importDocument(path.join(SAMPLES, 'design-notes.md'));
+    s.documents.importDocument(path.join(SAMPLES, 'retrieval-plan.md'));
+    await s.indexing.startIndexing();
+    expect(s.indexing.getAllChunks().length).toBeGreaterThan(0);
+    const answer = await s.qa.ask('how does retrieval work?');
+    expect(answer.citations.length).toBeGreaterThan(0);
+    s.feedback.submit(answer.id, 'up');
+
+    s.persistence.resetAll();
+
+    for (const svc of [s, boot()]) {
+      expect(svc.documents.listDocuments()).toEqual([]);
+      expect(svc.indexing.getAllChunks()).toEqual([]);
+      expect(svc.qa.getHistory()).toEqual([]);
+      expect(svc.feedback.list()).toEqual([]);
+      expect(svc.indexing.getStatus().status).toBe('idle');
+    }
+    // App keeps working after a reset.
+    expect((await s.qa.ask('anything?')).id).toBeTruthy();
+  });
+});

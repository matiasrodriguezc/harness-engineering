diff --git a/scripts/e2e-features.mjs b/scripts/e2e-features.mjs
new file mode 100644
index 0000000..653b3d0
--- /dev/null
+++ b/scripts/e2e-features.mjs
@@ -0,0 +1,184 @@
+// End-to-end check of feedback, reset and conversation history in the REAL Electron app.
+// Launches the built app (run `npm run build` first) with a throwaway user-data dir,
+// drives it over Chrome DevTools, restarts it to check persistence, and exits non-zero on failure.
+// Usage: node --experimental-websocket scripts/e2e-features.mjs [port]
+import { spawn } from 'node:child_process';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+
+const port = Number(process.argv[2] || 9360);
+const root = path.resolve(path.dirname(new URL(import.meta.url).pathname), '..');
+const samples = path.join(root, 'data', 'sample-documents');
+const dataDir = mkdtempSync(path.join(tmpdir(), 'kb-e2e-'));
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+let failures = 0;
+const check = (name, ok, detail) => {
+  console.log(`${ok ? 'PASS' : 'FAIL'}: ${name}${!ok && detail !== undefined ? ` -> ${JSON.stringify(detail)}` : ''}`);
+  if (!ok) failures++;
+};
+
+async function launch() {
+  const { NODE_OPTIONS: _drop, ...env } = process.env;
+  const electron = path.join(root, 'node_modules', '.bin', 'electron');
+  const proc = spawn(electron, ['.', `--remote-debugging-port=${port}`, `--user-data-dir=${dataDir}`], { cwd: root, env, stdio: 'ignore' });
+  for (let i = 0; i < 40; i++) {
+    try {
+      const targets = await (await fetch(`http://127.0.0.1:${port}/json/list`)).json();
+      const page = targets.find((t) => t.type === 'page');
+      if (page) {
+        const ws = new WebSocket(page.webSocketDebuggerUrl);
+        await new Promise((r) => ws.addEventListener('open', r));
+        const app = { proc, ws, evaluate: (expr) => evaluate(ws, expr) };
+        for (let j = 0; j < 40; j++) {
+          if (await app.evaluate('!!window.knowledgeBase && document.readyState === "complete" && !!document.querySelector("form")')) return app;
+          await sleep(250);
+        }
+        throw new Error('app UI never became ready');
+      }
+    } catch (e) {
+      if (String(e).includes('never became ready')) throw e;
+    }
+    await sleep(500);
+  }
+  throw new Error('could not connect to Electron');
+}
+
+let nextId = 1;
+function evaluate(ws, expression) {
+  const id = nextId++;
+  return new Promise((resolve, reject) => {
+    ws.addEventListener('message', function onMsg(ev) {
+      const msg = JSON.parse(ev.data);
+      if (msg.id !== id) return;
+      ws.removeEventListener('message', onMsg);
+      if (msg.result?.exceptionDetails) reject(new Error(msg.result.exceptionDetails.exception?.description ?? 'eval error'));
+      else resolve(msg.result?.result?.value);
+    });
+    ws.send(JSON.stringify({ id, method: 'Runtime.evaluate', params: { expression: `(async () => (${expression}))()`, awaitPromise: true, returnByValue: true } }));
+  });
+}
+
+async function quit(app) {
+  app.ws.close();
+  app.proc.kill();
+  await new Promise((r) => app.proc.once('exit', r));
+  await sleep(500);
+}
+
+const waitFor = async (app, expr, ms = 5000) => {
+  for (let t = 0; t < ms; t += 100) {
+    if (await app.evaluate(expr)) return true;
+    await sleep(100);
+  }
+  return false;
+};
+const kb = 'window.knowledgeBase';
+
+try {
+  // --- Session 1: seed data, use the API and the UI ---
+  let app = await launch();
+  for (const f of ['design-notes.md', 'retrieval-plan.md', 'meeting-summary.txt']) {
+    await app.evaluate(`${kb}.documents.import(${JSON.stringify(path.join(samples, f))})`);
+  }
+  await app.evaluate(`${kb}.indexing.start()`);
+
+  const a1 = await app.evaluate(`${kb}.qa.ask('How does retrieval work?')`);
+  const a2 = await app.evaluate(`${kb}.qa.ask('What did the meeting summary decide?')`);
+  check('qa.ask returns a string id', typeof a1.id === 'string' && a1.id.length > 0, a1.id);
+  check('answer ids are unique', a1.id !== a2.id);
+  check('answers have citations', a1.citations.length > 0 && a2.citations.length > 0);
+
+  const entry = await app.evaluate(`${kb}.feedback.submit(${JSON.stringify(a1.id)}, 'up')`);
+  check('feedback.submit returns the entry', entry.answerId === a1.id && entry.rating === 'up' && !!entry.timestamp, entry);
+  const bad = await app.evaluate(`${kb}.feedback.submit('x', 'sideways').then(() => 'accepted', () => 'rejected')`);
+  check('feedback.submit rejects invalid rating', bad === 'rejected', bad);
+
+  // Ask through the UI form.
+  await app.evaluate(`(() => {
+    const input = document.querySelector('input[aria-label="Question"]');
+    const setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set;
+    setter.call(input, 'What is the indexing chunk size?');
+    input.dispatchEvent(new Event('input', { bubbles: true }));
+    document.querySelector('form button[type=submit]').click();
+    return true;
+  })()`);
+  check('UI question appears as an exchange', await waitFor(app, `document.querySelectorAll('[data-testid=conversation-exchange]').length === 3`));
+  check('UI-asked question is persisted', (await app.evaluate(`${kb}.qa.history()`)).length === 3);
+
+  // Rate the second answer "not helpful" through the UI button.
+  await app.evaluate(`document.querySelector('[data-answer-id=${JSON.stringify(a2.id)}] [aria-label="Mark answer not helpful"]').click()`);
+  check('UI not-helpful button stores a rating', await waitFor(app, `${kb}.feedback.list().then(l => l.some(e => e.answerId === ${JSON.stringify(a2.id)} && e.rating === 'down'))`));
+  await quit(app);
+
+  // --- Session 2: restart, everything still there ---
+  app = await launch();
+  const fb = await app.evaluate(`${kb}.feedback.list()`);
+  check('feedback persists after restart', fb.length === 2 && fb.some((e) => e.answerId === a1.id && e.rating === 'up'), fb);
+  check('conversation renders all exchanges after restart', await waitFor(app, `document.querySelectorAll('[data-testid=conversation-exchange]').length === 3`));
+  const ui = await app.evaluate(`(() => {
+    const answers = [...document.querySelectorAll('[data-role=assistant]')];
+    return {
+      questions: document.querySelectorAll('[data-role=user]').length,
+      answers: answers.length,
+      helpfulButtons: answers.filter(a => a.querySelector('button[aria-label="Mark answer helpful"]')).length,
+      notHelpfulButtons: answers.filter(a => a.querySelector('button[aria-label="Mark answer not helpful"]')).length,
+      meters: answers.filter(a => a.querySelector('[role=meter][aria-label="Answer confidence"]')).length,
+      firstPressed: document.querySelector('[data-answer-id=${JSON.stringify(a1.id)}] [aria-label="Mark answer helpful"]').getAttribute('aria-pressed'),
+      confidenceText: answers[0].querySelector('[role=meter]').textContent,
+    };
+  })()`);
+  check('each answer has both feedback buttons', ui.answers === 3 && ui.helpfulButtons === 3 && ui.notHelpfulButtons === 3, ui);
+  check('each answer has a confidence indicator', ui.meters === 3 && /Confidence: \d+%/.test(ui.confidenceText), ui);
+  check('stored rating is shown as pressed', ui.firstPressed === 'true', ui.firstPressed);
+
+  const citation = await app.evaluate(`(async () => {
+    const btn = document.querySelector('[data-answer-id=${JSON.stringify(a1.id)}] button[aria-expanded]');
+    const before = { expanded: btn.getAttribute('aria-expanded'), excerpts: document.querySelectorAll('[data-testid=citation-excerpt]').length };
+    btn.click();
+    await new Promise(r => setTimeout(r, 100));
+    const ex = btn.parentElement.querySelector('[data-testid=citation-excerpt]');
+    return { before, expanded: btn.getAttribute('aria-expanded'), excerpt: ex ? ex.textContent : null };
+  })()`);
+  check('citation starts collapsed and expands to its excerpt',
+    citation.before.expanded === 'false' && citation.before.excerpts === 0 && citation.expanded === 'true' && citation.excerpt === a1.citations[0].excerpt,
+    citation);
+
+  // Reset via the UI: first click asks for confirmation; Cancel keeps data.
+  await app.evaluate(`document.querySelector('[aria-label="Reset all data"]').click()`);
+  check('reset button asks for confirmation', await waitFor(app, `!!document.querySelector('[role=alertdialog]')`));
+  check('nothing deleted before confirming', (await app.evaluate(`${kb}.documents.list()`)).length === 3);
+  await app.evaluate(`[...document.querySelectorAll('[role=alertdialog] button')].find(b => b.textContent === 'Cancel').click()`);
+  check('cancel keeps data', (await app.evaluate(`${kb}.qa.history()`)).length === 3);
+  await app.evaluate(`document.querySelector('[aria-label="Reset all data"]').click()`);
+  await waitFor(app, `!!document.querySelector('[role=alertdialog]')`);
+  await app.evaluate(`[...document.querySelectorAll('[role=alertdialog] button')].find(b => b.textContent.startsWith('Yes')).click()`);
+  check('UI reset empties the conversation view', await waitFor(app, `!!document.querySelector('[data-testid=conversation-empty]')`));
+  const afterUiReset = await app.evaluate(`Promise.all([${kb}.documents.list(), ${kb}.qa.history(), ${kb}.feedback.list()]).then(r => r.map(x => x.length))`);
+  check('UI reset clears documents, history and feedback', afterUiReset.every((n) => n === 0), afterUiReset);
+
+  // Re-seed, then reset through the API.
+  const docId = (await app.evaluate(`${kb}.documents.import(${JSON.stringify(path.join(samples, 'design-notes.md'))})`)).id;
+  await app.evaluate(`${kb}.indexing.start()`);
+  const a3 = await app.evaluate(`${kb}.qa.ask('What is the design architecture?')`);
+  await app.evaluate(`${kb}.feedback.submit(${JSON.stringify(a3.id)}, 'down')`);
+  await app.evaluate(`${kb}.app.reset()`);
+  const counts = await app.evaluate(`Promise.all([${kb}.documents.list(), ${kb}.qa.history(), ${kb}.feedback.list(), ${kb}.indexing.chunks(${JSON.stringify(docId)})]).then(r => r.map(x => x.length))`);
+  check('app.reset() clears documents, history, feedback and chunks', counts.every((n) => n === 0), counts);
+  await quit(app);
+
+  // --- Session 3: empty state survives restart ---
+  app = await launch();
+  const after = await app.evaluate(`Promise.all([${kb}.documents.list(), ${kb}.qa.history(), ${kb}.feedback.list(), ${kb}.indexing.chunks(${JSON.stringify(docId)})]).then(r => r.map(x => x.length))`);
+  check('empty state persists after restart', after.every((n) => n === 0), after);
+  check('UI shows empty conversation after restart', await waitFor(app, `!!document.querySelector('[data-testid=conversation-empty]')`));
+  await quit(app);
+} catch (e) {
+  console.error('ERROR:', e);
+  failures++;
+} finally {
+  rmSync(dataDir, { recursive: true, force: true });
+}
+
+console.log(failures === 0 ? 'E2E OK' : `E2E FAILED (${failures})`);
+process.exit(failures === 0 ? 0 : 1);
